@model LaMediaCancha.Models.ComboModels.CrearComboViewModel

@{
    ViewBag.Title = "Editar Combo";
    ViewBag.FullWidth = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="combo-wrapper">
    <!-- HEADER -->
    <div class="combo-header">
        <div>
            <h2 class="combo-title"><i class="fas fa-edit"></i> Editar Combo</h2>
            <p class="combo-subtitle">Modifique los datos del combo</p>
        </div>
        <a href="@Url.Action("Index")" class="btn-regresar">
            <i class="fas fa-arrow-left"></i> Regresar
        </a>
    </div>

    <!-- BODY -->
    <div class="combo-body">
        <div class="combo-card">
            @using (Html.BeginForm("Editar", "Combo", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ComboId)

                <!-- Fila 1: Nombre + Estado -->
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Nombre del Combo <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Estado</label>
                        @Html.DropDownListFor(m => m.Activo, new SelectList(new[]
                             {
                            new { Value = "true", Text = "Activo" },
                            new { Value = "false", Text = "Inactivo" }
                        }, "Value", "Text", Model.Activo), new { @class = "form-select" })
                    </div>
                </div>

                <!-- Descripción -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Descripción</label>
                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 2, placeholder = "Descripción del combo (opcional)" })
                </div>

                <hr class="my-4" />

                <!-- Tabla de productos -->
                <div class="mb-3">
                    <label class="form-label fw-bold fs-6">
                        <i class="fas fa-list me-1 text-success"></i> Productos del Combo
                    </label>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tblProductos">
                            <thead class="table-dark">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center" style="width:130px;">Cantidad</th>
                                    <th class="text-end" style="width:140px;">Precio Unitario</th>
                                    <th class="text-end" style="width:140px;">Subtotal</th>
                                    <th style="width:55px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tblProductosBody">
                                @if (Model.Productos != null && Model.Productos.Any())
                                {
                                    for (int i = 0; i < Model.Productos.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Model.Productos[i].ProductoNombre
                                                <input type="hidden" name="Productos[@i].ProductoId" value="@Model.Productos[i].ProductoId" />
                                                <input type="hidden" name="Productos[@i].ProductoNombre" value="@Model.Productos[i].ProductoNombre" />
                                                <input type="hidden" name="Productos[@i].PrecioVenta" value="@Model.Productos[i].PrecioVenta" />
                                            </td>
                                            <td class="text-center">
                                                <input type="number" name="Productos[@i].Cantidad"
                                                       class="form-control text-center cantidad"
                                                       value="@Model.Productos[i].Cantidad" min="1" required />
                                            </td>
                                            <td class="text-end">
                                                <span class="precio-unitario">Q @Model.Productos[i].PrecioVenta.ToString("N2")</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="subtotal">Q @((Model.Productos[i].Cantidad * Model.Productos[i].PrecioVenta).ToString("N2"))</span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-danger btn-sm btn-eliminar-producto">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="trVacio">
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fas fa-boxes fa-2x mb-2 d-block"></i>
                                            Agrega productos usando el botón de abajo
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end">Total Regular:</td>
                                    <td class="text-end" id="totalRegular">Q 0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Precio + Ahorro + Descuento -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Precio Regular</label>
                        <input type="text" id="precioRegular" class="form-control" readonly style="background:#e9ecef;" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">% Descuento</label>
                        <input type="number" id="porcentajeDescuento" class="form-control" value="0" step="5" min="0" max="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Precio del Combo (Q) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.PrecioCombo, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required", placeholder = "0.00" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Ahorro para el Cliente</label>
                        <input type="text" id="ahorro" class="form-control fw-bold" readonly />
                    </div>
                </div>

                <!-- Botón agregar producto -->
                <div class="mb-4">
                    <button type="button" class="btn btn-success px-4" id="btnAgregarProducto">
                        <i class="fas fa-plus-circle me-1"></i> Agregar Producto
                    </button>
                </div>

                <!-- Acciones -->
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="@Url.Action("Index")" class="btn btn-secondary px-4">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Seleccionar Producto -->
<div class="modal fade" id="modalProductos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-boxes me-2"></i> Seleccionar Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="buscarProducto" class="form-control mb-3" placeholder="Buscar producto..." />
                <div id="listaProductos" style="max-height:400px; overflow-y:auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var contadorProductos = @(Model.Productos?.Count ?? 0);
        var productosDisponibles = [];

        function recalcularTotales() {
            var totalRegular = 0;
            $('#tblProductosBody tr').each(function () {
                var cantidad = parseFloat($(this).find('.cantidad').val()) || 0;
                var precio = parseFloat($(this).find('.precio-unitario').text().replace('Q', '').trim()) || 0;
                var subtotal = cantidad * precio;
                $(this).find('.subtotal').text('Q ' + subtotal.toFixed(2));
                totalRegular += subtotal;
            });

            $('#totalRegular').text('Q ' + totalRegular.toFixed(2));
            $('#precioRegular').val('Q ' + totalRegular.toFixed(2));

            var porcentaje = parseFloat($('#porcentajeDescuento').val()) || 0;
            var precioConDescuento = totalRegular * (1 - porcentaje / 100);

            $('#PrecioCombo').val(precioConDescuento.toFixed(2));

            var ahorro = totalRegular - precioConDescuento;
            $('#ahorro').val('Q ' + ahorro.toFixed(2));
            $('#ahorro').css('color', ahorro >= 0 ? '#27AE60' : '#dc3545');
        }

        function calcularPorcentajeDesdePrecio() {
            var totalRegular = 0;
            $('#tblProductosBody tr').each(function () {
                var cantidad = parseFloat($(this).find('.cantidad').val()) || 0;
                var precio = parseFloat($(this).find('.precio-unitario').text().replace('Q', '').trim()) || 0;
                totalRegular += cantidad * precio;
            });

            var precioCombo = parseFloat($('#PrecioCombo').val()) || 0;
            if (totalRegular > 0) {
                var porcentaje = ((totalRegular - precioCombo) / totalRegular) * 100;
                $('#porcentajeDescuento').val(Math.round(porcentaje));
            }
        }

        function cargarProductos(filtro) {
            filtro = filtro || '';
            $.ajax({
                url: '@Url.Action("GetProductosDisponibles", "Combo")',
                type: 'GET',
                success: function (data) {
                    productosDisponibles = data;
                    var html = '';
                    var filtrados = data.filter(function (p) {
                        return filtro === '' ||
                               p.Nombre.toLowerCase().indexOf(filtro.toLowerCase()) >= 0 ||
                               p.Codigo.toLowerCase().indexOf(filtro.toLowerCase()) >= 0;
                    });
                    if (filtrados.length === 0) {
                        html = '<p class="text-muted text-center py-3">No se encontraron productos</p>';
                    } else {
                        for (var i = 0; i < filtrados.length; i++) {
                            html += '<div class="producto-item" ' +
                                    'data-id="' + filtrados[i].ProductoId + '" ' +
                                    'data-nombre="' + filtrados[i].Nombre + '" ' +
                                    'data-precio="' + filtrados[i].PrecioVenta + '">' +
                                    '<strong>' + filtrados[i].Codigo + '</strong> — ' + filtrados[i].Nombre +
                                    '<span class="float-end text-success fw-bold">Q ' + parseFloat(filtrados[i].PrecioVenta).toFixed(2) + '</span>' +
                                    '</div>';
                        }
                    }
                    $('#listaProductos').html(html);
                }
            });
        }

        $(document).ready(function () {
            cargarProductos();
            recalcularTotales();

            // Calcular porcentaje inicial basado en el precio guardado
            setTimeout(function() {
                calcularPorcentajeDesdePrecio();
            }, 500);

            $('#porcentajeDescuento').on('change keyup', function () {
                recalcularTotales();
            });

            $('#PrecioCombo').on('change keyup', function () {
                calcularPorcentajeDesdePrecio();
            });

            $('#btnAgregarProducto').click(function () {
                $('#buscarProducto').val('');
                $('#modalProductos').modal('show');
                cargarProductos();
            });

            $('#buscarProducto').on('keyup', function () {
                cargarProductos($(this).val());
            });

            $(document).on('click', '.producto-item', function () {
                var id = $(this).data('id');
                var nombre = $(this).data('nombre');
                var precio = $(this).data('precio');

                var existe = false;
                $('#tblProductosBody tr').each(function () {
                    if ($(this).find('input[name*="ProductoId"]').val() == id) {
                        existe = true;
                        return false;
                    }
                });

                if (existe) {
                    Swal.fire('Atención', 'El producto ya está en el combo', 'warning');
                    $('#modalProductos').modal('hide');
                    return;
                }

                $('#trVacio').remove();

                var html = '<tr>' +
                    '<td>' + nombre +
                        '<input type="hidden" name="Productos[' + contadorProductos + '].ProductoId" value="' + id + '" />' +
                        '<input type="hidden" name="Productos[' + contadorProductos + '].ProductoNombre" value="' + nombre + '" />' +
                        '<input type="hidden" name="Productos[' + contadorProductos + '].PrecioVenta" value="' + precio + '" />' +
                    '</td>' +
                    '<td class="text-center">' +
                        '<input type="number" name="Productos[' + contadorProductos + '].Cantidad" ' +
                               'class="form-control text-center cantidad" value="1" min="1" required />' +
                    '</td>' +
                    '<td class="text-end"><span class="precio-unitario">Q ' + parseFloat(precio).toFixed(2) + '</span></td>' +
                    '<td class="text-end"><span class="subtotal">Q ' + parseFloat(precio).toFixed(2) + '</span></td>' +
                    '<td class="text-center">' +
                        '<button type="button" class="btn btn-danger btn-sm btn-eliminar-producto"><i class="fas fa-trash"></i></button>' +
                    '</td>' +
                '</tr>';

                $('#tblProductosBody').append(html);
                contadorProductos++;
                recalcularTotales();
                $('#modalProductos').modal('hide');
            });

            $(document).on('click', '.btn-eliminar-producto', function () {
                $(this).closest('tr').remove();
                recalcularTotales();
                if ($('#tblProductosBody tr').length === 0) {
                    $('#tblProductosBody').html('<tr id="trVacio"><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-boxes fa-2x mb-2 d-block"></i>Agrega productos usando el botón de abajo</td></tr>');
                }
            });

            $(document).on('change keyup', '.cantidad', recalcularTotales);
        });
    </script>

    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .combo-wrapper {
            min-height: 100vh;
            background: #f5f0eb;
        }

        .combo-header {
            background: linear-gradient(135deg, #c95a00, #a04700);
            padding: 20px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .combo-title {
            color: white;
            font-size: 1.6rem;
            font-weight: 700;
            margin: 0;
        }

            .combo-title i {
                margin-right: 8px;
            }

        .combo-subtitle {
            color: rgba(255,255,255,0.75);
            font-size: 0.83rem;
            margin: 3px 0 0;
        }

        .btn-regresar {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 1.5px solid rgba(255,255,255,0.5);
            border-radius: 20px;
            padding: 8px 22px;
            text-decoration: none;
            font-size: 0.84rem;
            font-weight: 600;
            transition: background .2s;
        }

            .btn-regresar:hover {
                background: rgba(255,255,255,0.28);
                color: white;
            }

        .combo-body {
            padding: 32px 36px 48px;
        }

        .combo-card {
            background: white;
            border-radius: 18px;
            padding: 32px 36px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.07);
            max-width: 1100px;
            margin: 0 auto;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #ddd;
            padding: 10px 14px;
            transition: all .2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #c95a00;
                box-shadow: 0 0 0 3px rgba(201,90,0,0.12);
                outline: none;
            }

        .form-label {
            font-size: 0.87rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 6px;
        }

        .table-dark th {
            background-color: #2c3e30;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .table td {
            vertical-align: middle;
            font-size: 0.85rem;
        }

        .cantidad {
            max-width: 90px;
            margin: 0 auto;
        }

        .btn-primary {
            background: linear-gradient(135deg, #c95a00, #a04700);
            border: none;
            border-radius: 10px;
            transition: all .2s;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #a04700, #8b3a00);
                transform: translateY(-1px);
            }

        .btn-secondary {
            background: #6c757d;
            border: none;
            border-radius: 10px;
        }

        .btn-success {
            background: #27AE60;
            border: none;
            border-radius: 10px;
        }

            .btn-success:hover {
                background: #1e8449;
                transform: translateY(-1px);
            }

        .producto-item {
            cursor: pointer;
            padding: 11px 14px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.87rem;
            transition: background .15s;
        }

            .producto-item:hover {
                background: #fff8f3;
            }

            .producto-item:last-child {
                border-bottom: none;
            }

        #ahorro {
            background: #f9fafb;
            font-weight: 700;
            font-size: 1rem;
        }

        @@media (max-width: 768px) {
            .combo-header {
                padding: 16px 18px;
            }

            .combo-body {
                padding: 18px 14px 32px;
            }

            .combo-card {
                padding: 20px 16px;
            }
        }
    </style>
}
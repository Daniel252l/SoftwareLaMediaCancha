@model IEnumerable<LaMediaCancha.Models.ComboModels.ComboViewModel>

@{
    ViewBag.Title = "Combos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-layer-group me-2"></i> Combos Especiales
                            </h2>
                            <p class="mb-0 text-white-50">Combos disponibles para la venta</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Crear", "Combo")" class="btn btn-light">
                                <i class="fas fa-plus-circle me-1"></i> Nuevo Combo
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Precio Regular</th>
                                    <th class="text-end">Precio Combo</th>
                                    <th class="text-end">Ahorro</th>
                                    <th class="text-center">Productos</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var combo in Model)
                                {
                                    var totalProductos = combo.Productos?.Sum(p => p.CantidadIncluida) ?? 0;
                                    var precioRegular = combo.PrecioRegularTotal;
                                    var precioCombo = combo.PrecioCombo;
                                    var ahorro = precioRegular - precioCombo;

                                    <tr>
                                        <td>
                                            <strong>@combo.Nombre</strong>
                                        </td>
                                        <td>
                                            @(string.IsNullOrEmpty(combo.Descripcion) ? "-" : (combo.Descripcion.Length > 50 ? combo.Descripcion.Substring(0, 50) + "..." : combo.Descripcion))
                                        </td>
                                        <td class="text-end">
                                            @if (precioRegular > 0 && totalProductos > 0)
                                            {
                                                <span class="text-muted text-decoration-line-through">Q @precioRegular.ToString("F2")</span>
                                            }
                                            else if (totalProductos == 0)
                                            {
                                                <span class="text-warning">Sin productos</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (totalProductos > 0)
                                            {
                                                <span class="text-success fw-bold">Q @precioCombo.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (totalProductos > 0 && ahorro > 0)
                                            {
                                                <span class="text-danger fw-bold">Q @ahorro.ToString("F2")</span>
                                            }
                                            else if (totalProductos > 0 && ahorro < 0)
                                            {
                                                <span class="text-warning">Sin ahorro</span>
                                            }
                                            else if (totalProductos > 0 && ahorro == 0)
                                            {
                                                <span class="text-muted">Q 0.00</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (totalProductos > 0)
                                            {
                                                <span class="badge bg-info">@totalProductos</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (combo.Activo)
                                            {
                                                <span class="badge bg-success px-3 py-2">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a href="@Url.Action("Detalle", new { id = combo.ComboId })" class="btn btn-info btn-sm text-white" title="Ver detalle">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action("Editar", new { id = combo.ComboId })" class="btn btn-warning btn-sm text-white" title="Editar combo">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (combo.Activo)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm" title="Inactivar" onclick="cambiarEstado(@combo.ComboId, false)">
                                                        <i class="fas fa-ban"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-success btn-sm" title="Activar" onclick="cambiarEstado(@combo.ComboId, true)">
                                                        <i class="fas fa-check-circle"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: 30px !important;
            padding-right: 30px !important;
        }

        .card-custom {
            width: 100%;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .card-custom-full {
            width: 100% !important;
            max-width: 100% !important;
        }

        .card-header-custom {
            padding: 1.5rem 2rem;
            background: linear-gradient(135deg, #c95a00 0%, #a04700 100%);
        }

        .card-body-custom {
            padding: 20px;
        }

        .table th {
            padding: 14px 12px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .table td {
            padding: 14px 12px;
            vertical-align: middle;
        }

        .btn {
            border-radius: 10px;
            transition: all .2s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .badge {
            font-size: .75rem;
            font-weight: 600;
        }

        .text-decoration-line-through {
            text-decoration: line-through;
        }
    </style>

    <script>
        function cambiarEstado(id, activo) {
            var mensaje = activo ? '¿Activar este combo?' : '¿Inactivar este combo?';
            var texto = activo ? 'El combo estará disponible para la venta.' : 'El combo no aparecerá en el menú.';

            Swal.fire({
                title: mensaje,
                text: texto,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: activo ? 'Sí, activar' : 'Sí, inactivar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("CambiarEstado", "Combo")',
                        type: 'POST',
                        data: { id: id, activo: activo },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Éxito', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Error al cambiar el estado', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
@model LaMediaCancha.Models.ViewModels.CrearUsuarioViewModel

@{
    ViewBag.Title = "Crear Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid container-usuarios py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <div class="card-custom">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-user-plus me-2"></i> Crear Usuario
                            </h2>
                            <p class="mb-0 text-white-50">
                                Ingrese los datos del nuevo usuario
                            </p>
                        </div>

                        <a href="@Url.Action("ListaUsuarios", "Admin")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Regresar
                        </a>
                    </div>
                </div>

                <div class="card-body-custom p-4">

                    @using (Html.BeginForm("CrearUsuario", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    Rol <span class="text-danger">*</span>
                                </label>

                                @Html.DropDownListFor(
                                         m => m.RolId,
                                         Model.Roles,
                                         "Seleccione un rol...",
                                         new
                                         {
                                             @class = "form-select",
                                             required = "required"
                                         })

                                @Html.ValidationMessageFor(
                                         m => m.RolId,
                                         "",
                                         new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    Nombre Completo <span class="text-danger">*</span>
                                </label>

                                @Html.TextBoxFor(
                                         m => m.NombreCompleto,
                                         new
                                         {
                                             @class = "form-control",
                                             required = "required",
                                             placeholder = "Ej: Juan Pérez"
                                         })

                                @Html.ValidationMessageFor(
                                         m => m.NombreCompleto,
                                         "",
                                         new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Correo Electrónico <span class="text-danger">*</span>
                            </label>

                            @Html.TextBoxFor(
                                     m => m.Email,
                                     new
                                     {
                                         @class = "form-control",
                                         type = "email",
                                         required = "required",
                                         placeholder = "correo@ejemplo.com"
                                     })

                            @Html.ValidationMessageFor(
                                     m => m.Email,
                                     "",
                                     new { @class = "text-danger small" })
                        </div>

                        <div class="alert alert-info mt-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Nota:</strong>
                            Se generará una contraseña temporal automáticamente
                            y se enviará al correo del usuario.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top flex-wrap">
                            <a href="@Url.Action("ListaUsuarios", "Admin")"
                               class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Crear Usuario
                            </button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .container-usuarios {
        width: 100%;
        max-width: 100% !important;
        padding-left: 30px;
        padding-right: 30px;
    }

    .card-custom {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            transition: all 0.2s ease;
            border-radius: 10px;
            padding: 8px 18px;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
                transform: translateY(-2px);
            }

    .card-body-custom {
        background: #fff;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 12px 14px;
        transition: all 0.2s ease;
        min-height: 48px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #c95a00;
            box-shadow: 0 0 0 3px rgba(201, 90, 0, 0.15);
            outline: none;
        }

    .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201, 90, 0, 0.3);
        }

    .btn-secondary {
        background: #6c757d;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    .alert-info {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
        border-radius: 12px;
        padding: 16px;
    }

    .border-top {
        border-top: 1px solid #e9ecef !important;
    }

    @@media (max-width: 768px) {

        .container-usuarios {
            padding-left: 15px;
            padding-right: 15px;
        }

        .card-header-custom {
            padding: 1rem;
        }

            .card-header-custom h2 {
                font-size: 1.5rem;
            }

        .btn-primary,
        .btn-secondary {
            width: 100%;
        }
    }
</style>
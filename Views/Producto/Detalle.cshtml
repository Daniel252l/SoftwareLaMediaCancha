@model LaMediaCancha.Models.ProductoModels.ProductoCompra

@{
    ViewBag.Title = "Detalle de Materia Prima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-5 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1" style="text-align:left; font-size:1.6rem;">
                                <i class="fas fa-info-circle"></i> Detalle de Materia Prima
                            </h2>
                            <p class="mb-0" style="font-size:0.9rem;">Información completa del insumo</p>
                        </div>
                        <a href="@Url.Action("Index")" class="btn-regresar">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Información General -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Código</label>
                                <p class="campo-valor">@Model.Codigo</p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Unidad de Medida</label>
                                <p class="campo-valor">@Model.UnidadMedida</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Nombre</label>
                                <p class="campo-valor">@Model.Nombre</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Descripción</label>
                                <p class="campo-valor" style="font-weight:400;">@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Stock -->
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Precio Compra</label>
                                <p class="text-danger" style="font-weight:800; font-size:1.5rem; margin:0;">Q @Model.PrecioCompra.ToString("N2")</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Stock Actual</label>
                                @{
                                    var estadoStock = "";
                                    var stockColor = "";
                                    if (Model.StockActual <= 0)
                                    {
                                        estadoStock = "AGOTADO";
                                        stockColor = "text-dark";
                                    }
                                    else if (Model.StockActual <= Model.StockMinimo)
                                    {
                                        estadoStock = "STOCK BAJO";
                                        stockColor = "text-danger";
                                    }
                                    else if (Model.StockActual <= Model.StockMinimo * 1.5m)
                                    {
                                        estadoStock = "ALERTA";
                                        stockColor = "text-warning";
                                    }
                                    else
                                    {
                                        estadoStock = "NORMAL";
                                        stockColor = "text-success";
                                    }
                                }
                                <p class="campo-valor @stockColor" style="font-weight:800; font-size:1.5rem;">
                                    @Model.StockActual
                                    <small class="text-muted" style="font-size:0.8rem;">(@estadoStock)</small>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Stock Mínimo</label>
                                <p class="campo-valor">@Model.StockMinimo</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Lotes Activos</label>
                                <p class="campo-valor">@(Model.Lotes?.Count(l => l.Activo && l.CantidadActual > 0) ?? 0)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Categoría y Estado -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Categoría</label>
                                <p class="campo-valor">@Model.Categoria</p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="campo-box">
                                <label class="campo-label">Estado</label>
                                <p style="margin:0;">
                                    @if (Model.Activo)
                                    {
                                        <span class="badge-success" style="font-size:0.85rem; padding:6px 18px;">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger" style="font-size:0.85rem; padding:6px 18px;">Inactivo</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Tabla de Lotes (FIFO) -->
                    @if (Model.Lotes != null && Model.Lotes.Any())
                    {
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">
                                <i class="fas fa-layer-group me-2"></i> Lotes del Producto
                                <small class="text-muted">(Orden FIFO - Primero en vencer, primero en salir)</small>
                            </h5>
                            <a href="@Url.Action("CrearLote", new { productoCompraId = Model.ProductoCompraId })" class="btn btn-success btn-sm">
                                <i class="fas fa-plus-circle me-1"></i> Agregar Lote
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Número Lote</th>
                                        <th>Proveedor</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Precio Unitario</th>
                                        <th>Fecha Ingreso</th>
                                        <th>Fecha Vencimiento</th>
                                        <th class="text-center">Días Restantes</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var lotesOrdenados = Model.Lotes.OrderBy(l => l.FechaVencimiento ?? DateTime.MaxValue).ThenBy(l => l.FechaIngreso);
                                    }
                                    @foreach (var lote in lotesOrdenados)
                                    {
                                        var rowClass = lote.EstaVencido ? "table-danger" : (lote.DiasRestantes <= 7 ? "table-warning" : "");
                                        var estadoLote = lote.EstaVencido ? "Vencido" : (lote.Activo ? "Activo" : "Inactivo");
                                        var estadoBadge = lote.EstaVencido ? "bg-danger" : (lote.Activo ? "bg-success" : "bg-secondary");

                                        <tr>
                                            <td class="@rowClass">
                                                <span class="badge bg-light text-dark">@lote.NumeroLote</span>
                                            </td>
                                            <td class="@rowClass">
                                                @lote.ProveedorNombre
                                        </td>
                                        <td class="text-end @rowClass">
                                            @if (lote.CantidadActual <= 0)
                                            {
                                                <span class="text-danger fw-bold">@lote.CantidadActual</span>
                                            }
                                            else
                                            {
                                                <span>@lote.CantidadActual</span>
                                            }
                                        </td>
                                        <td class="text-end @rowClass">Q @lote.PrecioUnitario.ToString("N2")
                    </td>
                    <td class="@rowClass">@lote.FechaIngreso.ToString("dd/MM/yyyy")
                </td>
                <td class="@rowClass">
                    @(lote.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")
                </td>
                <td class="text-center @rowClass">
                    @if (lote.FechaVencimiento.HasValue)
                    {
                        if (lote.DiasRestantes <= 0)
                        {
                            <span class="text-danger fw-bold">Vencido</span>
                        }
                        else
                        {
                            <span>@lote.DiasRestantes días</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </td>
                <td class="text-center @rowClass">
                    <span class="badge @estadoBadge">@estadoLote</span>
                </td>
            </tr>
        }
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-info mt-2 small">
                            <i class="fas fa-info-circle me-1"></i>
                            Los lotes se muestran en orden FIFO: primero los que vencen más pronto.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>No hay lotes registrados</strong>
                            <a href="@Url.Action("CrearLote", new { productoCompraId = Model.ProductoCompraId })" class="alert-link ms-2">
                                Agregar el primer lote
                            </a>
                        </div>
                    }

                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top:1px solid #eee;">
                        <a href="@Url.Action("Index")" class="btn-ver" style="padding:10px 20px; font-size:0.85rem;">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                        <a href="@Url.Action("Editar", new { id = Model.ProductoCompraId })" class="btn-editar" style="padding:10px 20px; font-size:0.85rem;">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                        <a href="@Url.Action("Lotes", new { id = Model.ProductoCompraId })" class="btn-lotes" style="padding:10px 20px; font-size:0.85rem;">
                            <i class="fas fa-layer-group"></i> Ver Todos los Lotes
                        </a>
                        <a href="@Url.Action("CrearLote", new { productoCompraId = Model.ProductoCompraId })" class="btn btn-success" style="padding:10px 20px; font-size:0.85rem;">
                            <i class="fas fa-plus-circle"></i> Agregar Lote
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-custom-full {
        max-width: 100% !important;
    }

    .btn-regresar {
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.4);
        color: white;
        border-radius: 8px;
        padding: 8px 18px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,0.35);
            color: white;
            text-decoration: none;
        }

    .campo-box {
        background: #fafafa;
        border: 1px solid #f0f0f0;
        border-radius: 10px;
        padding: 14px 18px;
        height: 100%;
    }

    .campo-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #999;
        letter-spacing: 0.5px;
        display: block;
        margin-bottom: 6px;
    }

    .campo-valor {
        font-weight: 700;
        font-size: 1rem;
        color: #333;
        margin: 0;
    }

    .badge-success {
        background: #27AE60;
        color: white;
        border-radius: 30px;
        display: inline-block;
        padding: 6px 18px;
    }

    .badge-danger {
        background: #E74C3C;
        color: white;
        border-radius: 30px;
        display: inline-block;
        padding: 6px 18px;
    }

    .btn-ver {
        background: #6c757d;
        color: white;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-ver:hover {
            background: #5a6268;
            color: white;
        }

    .btn-editar {
        background: linear-gradient(135deg, #c95a00, #a04700);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-editar:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            color: white;
        }

    .btn-lotes {
        background: #3498DB;
        color: white;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-lotes:hover {
            background: #2980B9;
            color: white;
        }

    .table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.85rem;
    }

    .table-danger {
        background-color: #f8d7da !important;
    }

    .table-warning {
        background-color: #fff3cd !important;
    }
</style>
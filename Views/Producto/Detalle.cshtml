@model LaMediaCancha.Models.ProductoModels.Producto

@{
    ViewBag.Title = "Detalle Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card-custom">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="text-white mb-1"><i class="fas fa-info-circle"></i> Detalle del Producto</h2>
                            <p class="mb-0 text-white-50">Información completa del producto</p>
                        </div>
                        <a href="@Url.Action("Index")" class="btn btn-light">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Código</label>
                            <p class="fw-bold fs-5">@Model.Codigo</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Código de Barras</label>
                            <p class="fw-bold fs-5">@(Model.CodigoBarras ?? "-")</p>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="text-muted small text-uppercase">Nombre</label>
                            <p class="fw-bold fs-5">@Model.Nombre</p>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="text-muted small text-uppercase">Descripción</label>
                            <p>@(Model.Descripcion ?? "-")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Precio Compra</label>
                            <p class="text-danger fw-bold fs-4">@(Model.PrecioCompra?.ToString("C") ?? "-")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Precio Venta</label>
                            <p class="text-success fw-bold fs-4">@Model.PrecioVenta.ToString("C")</p>
                        </div>
                    </div>

                    @if (Model.EstaEnOferta == true)
                    {
                        <div class="alert alert-warning mt-3">
                            <h6><i class="fas fa-percent"></i> Oferta Especial</h6>
                            <p><strong>Precio Oferta:</strong> @(Model.PrecioOferta?.ToString("C") ?? "-")</p>
                            <p><strong>Vigencia:</strong> @(Model.FechaInicioOferta?.ToString("dd/MM/yyyy")) hasta @(Model.FechaFinOferta?.ToString("dd/MM/yyyy"))</p>
                        </div>
                    }

                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Estado</label>
                            <p>
                                @if (Model.Activo)
                                {
                                    <span class="badge bg-success px-3 py-2">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">Inactivo</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small text-uppercase">Fecha Creación</label>
                            <p>@Model.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        @if (Model.FechaModificacion.HasValue)
                        {
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small text-uppercase">Última Modificación</label>
                                <p>@Model.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                        <a href="@Url.Action("Editar", new { id = Model.ProductoId })" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Editar Producto
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-custom {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
            }

    .badge {
        font-size: 0.8rem;
        font-weight: 500;
        border-radius: 20px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
        }

    .alert-warning {
        background-color: #fff3e0;
        border-color: #F39C12;
        color: #E67E22;
    }
</style>
@model IEnumerable<LaMediaCancha.Models.ProductoModels.LoteCompra>

@{
    ViewBag.Title = "Lotes de Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-layer-group me-2"></i> Lotes de @ViewBag.NombreProducto
                            </h2>
                            <p class="mb-0 text-white-50">Historial de lotes - Método FIFO (primero en vencer, primero en salir)</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("CrearLote", new { productoCompraId = ViewBag.ProductoCompraId })" class="btn btn-success">
                                <i class="fas fa-plus-circle me-1"></i> Nuevo Lote
                            </a>
                            <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Número Lote</th>
                                    <th>Proveedor</th>
                                    <th class="text-end">Cantidad Inicial</th>
                                    <th class="text-end">Cantidad Actual</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Costo Total</th>
                                    <th>Fecha Ingreso</th>
                                    <th>Fecha Fabricación</th>
                                    <th>Fecha Vencimiento</th>
                                    <th>Días Restantes</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var lotesOrdenados = Model.OrderBy(l => l.FechaVencimiento ?? DateTime.MaxValue).ThenBy(l => l.FechaIngreso);
                                }
                                @foreach (var item in lotesOrdenados)
                                {
                                    string rowClass = item.EstaVencido ? "table-danger" : (item.DiasRestantes <= 7 ? "table-warning" : "");
                                    string estadoBadge = item.EstaVencido ? "bg-danger" : (item.Activo ? "bg-success" : "bg-secondary");
                                    string estadoTexto = item.EstaVencido ? "Vencido" : (item.Activo ? "Activo" : "Inactivo");

                                    <tr>
                                        <td class="@rowClass"><span class="badge bg-light text-dark">@item.NumeroLote</span></td>
                                        <td class="@rowClass">@item.ProveedorNombre</td>
                                        <td class="text-end @rowClass">@item.CantidadInicial</td>
                                        <td class="text-end @rowClass">
                                            @if (item.CantidadActual <= 0)
                                            {
                                                <span class="text-danger fw-bold">@item.CantidadActual</span>
                                            }
                                            else
                                            {
                                                <span>@item.CantidadActual</span>
                                            }
                                        </td>
                                        <td class="text-end @rowClass">Q @item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end @rowClass">Q @item.CostoCompra.ToString("N2")</td>
                                        <td class="@rowClass">@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                        <td class="@rowClass">@(item.FechaFabricacion.HasValue ? item.FechaFabricacion.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td class="@rowClass">@(item.FechaVencimiento.HasValue ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td class="text-center @rowClass">
                                            @if (item.FechaVencimiento.HasValue)
                                            {
                                                if (item.DiasRestantes <= 0)
                                                {
                                                    <span class="text-danger fw-bold">Vencido</span>
                                                }
                                                else if (item.DiasRestantes <= 7)
                                                {
                                                    <span class="text-warning fw-bold">@item.DiasRestantes días</span>
                                                }
                                                else
                                                {
                                                    <span>@item.DiasRestantes días</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td class="text-center @rowClass">
                                            <span class="badge @estadoBadge px-3 py-2">@estadoTexto</span>
                                        </td>
                                        <td class="text-center @rowClass">
                                            @if (!item.EstaVencido && item.CantidadActual > 0 && item.Activo)
                                            {
                                                <button type="button" class="btn btn-warning btn-sm" onclick="consumirStock(@item.LoteCompraId, '@item.NumeroLote', @item.CantidadActual)">
                                                    <i class="fas fa-box"></i> Consumir
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Orden FIFO:</strong> Los lotes están ordenados por fecha de vencimiento (más próximo primero). El sistema consumirá stock automáticamente del lote que venza más pronto.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Consumir Stock -->
<div class="modal fade" id="modalConsumir" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">
                    <i class="fas fa-box me-2"></i> Consumir Stock
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="consumirLoteId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Lote</label>
                    <input type="text" id="consumirNumeroLote" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Stock Disponible</label>
                    <input type="text" id="consumirStockActual" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Cantidad a Consumir <span class="text-danger">*</span></label>
                    <input type="number" id="consumirCantidad" class="form-control" step="0.01" min="0.01" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Motivo</label>
                    <textarea id="consumirMotivo" class="form-control" rows="2" placeholder="Ej: Producción, Merma, Venta, etc."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" id="btnConfirmarConsumir">
                    <i class="fas fa-box me-1"></i> Consumir Stock
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: 30px !important;
            padding-right: 30px !important;
        }

        .card-custom {
            width: 100%;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .card-custom-full {
            width: 100% !important;
            max-width: 100% !important;
        }

        .card-header-custom {
            padding: 1.5rem 2rem;
            background: linear-gradient(135deg, #c95a00 0%, #a04700 100%);
        }

        .card-body-custom {
            padding: 20px;
        }

        .table th {
            padding: 12px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .table td {
            padding: 12px;
            vertical-align: middle;
        }

        .table-danger {
            background-color: #f8d7da !important;
        }

        .table-warning {
            background-color: #fff3cd !important;
        }

        .btn {
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .badge {
            font-size: 0.75rem;
            font-weight: 600;
        }
    </style>

    <script>
        var modalConsumir;
        var loteIdActual = 0;

        function consumirStock(loteId, numeroLote, stockActual) {
            loteIdActual = loteId;
            $('#consumirLoteId').val(loteId);
            $('#consumirNumeroLote').val(numeroLote);
            $('#consumirStockActual').val(stockActual);
            $('#consumirCantidad').val('');
            $('#consumirMotivo').val('');
            $('#modalConsumir').modal('show');
        }

        $(document).ready(function() {
            modalConsumir = new bootstrap.Modal(document.getElementById('modalConsumir'));

            $('#btnConfirmarConsumir').click(function() {
                var cantidad = $('#consumirCantidad').val();
                var motivo = $('#consumirMotivo').val();
                var stockActual = parseFloat($('#consumirStockActual').val());

                if (!cantidad || parseFloat(cantidad) <= 0) {
                    Swal.fire('Error', 'Ingrese una cantidad válida', 'error');
                    return;
                }

                if (parseFloat(cantidad) > stockActual) {
                    Swal.fire('Error', 'No hay suficiente stock disponible', 'error');
                    return;
                }

                if (!motivo) {
                    Swal.fire('Error', 'Ingrese el motivo del consumo', 'error');
                    return;
                }

                Swal.fire({
                    title: '¿Consumir stock?',
                    text: `¿Está seguro de consumir ${cantidad} unidades de este lote?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, consumir',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#btnConfirmarConsumir').html('<i class="fas fa-spinner fa-spin"></i> Procesando...');
                        $('#btnConfirmarConsumir').prop('disabled', true);

                        $.ajax({
                            url: '@Url.Action("ConsumirStock", "Producto")',
                            type: 'POST',
                            data: {
                                loteId: loteIdActual,
                                cantidad: cantidad,
                                motivo: motivo
                            },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Éxito', response.message, 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Error', 'Error al consumir el stock', 'error');
                            },
                            complete: function() {
                                $('#btnConfirmarConsumir').html('<i class="fas fa-box me-1"></i> Consumir Stock');
                                $('#btnConfirmarConsumir').prop('disabled', false);
                                modalConsumir.hide();
                            }
                        });
                    }
                });
            });
        });
    </script>
}
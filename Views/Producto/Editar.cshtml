@model LaMediaCancha.Models.ProductoModels.ProductoCompra

@{
    ViewBag.Title = "Editar Materia Prima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card-custom">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-edit me-2"></i> Editar Materia Prima
                            </h2>
                            <p class="mb-0 text-white-50">Modifique los datos del insumo o materia prima</p>
                        </div>
                        <a href="@Url.Action("Index", "Producto")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom p-4">
                    @using (Html.BeginForm("Editar", "Producto", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ProductoCompraId)

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Código <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", required = "required" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Unidad de Medida <span class="text-danger">*</span></label>
                                <select name="UnidadMedida" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Kilogramo" @(Model.UnidadMedida == "Kilogramo" ? "selected" : "")>Kilogramo (kg)</option>
                                    <option value="Gramo" @(Model.UnidadMedida == "Gramo" ? "selected" : "")>Gramo (g)</option>
                                    <option value="Libra" @(Model.UnidadMedida == "Libra" ? "selected" : "")>Libra (lb)</option>
                                    <option value="Litro" @(Model.UnidadMedida == "Litro" ? "selected" : "")>Litro (L)</option>
                                    <option value="Mililitro" @(Model.UnidadMedida == "Mililitro" ? "selected" : "")>Mililitro (ml)</option>
                                    <option value="Unidad" @(Model.UnidadMedida == "Unidad" ? "selected" : "")>Unidad (unid)</option>
                                    <option value="Paquete" @(Model.UnidadMedida == "Paquete" ? "selected" : "")>Paquete (pq)</option>
                                    <option value="Caja" @(Model.UnidadMedida == "Caja" ? "selected" : "")>Caja (cj)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Categoría</label>
                                @Html.DropDownListFor(m => m.CategoriaId, ViewBag.CategoriasCompra as SelectList, "Seleccione una categoría...", new { @class = "form-select" })
                                <small class="text-muted">Clasifique el producto para mejor organización</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio Compra (Q) <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.PrecioCompra, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
                                <small class="text-muted">Precio de compra actual al proveedor</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Actual</label>
                                @Html.TextBoxFor(m => m.StockActual, new { @class = "form-control", type = "number", step = "0.01", @readonly = "readonly", style = "background: #f5f5f5;" })
                                <small class="text-muted">El stock se actualiza automáticamente con las compras y ventas</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Mínimo <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.StockMinimo, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
                                <small class="text-muted">Cuando el stock baje de este nivel, se mostrará una alerta</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Stock Actual:</strong> @Model.StockActual unidades
                                    @if (Model.StockActual <= Model.StockMinimo)
                                    {
                                        <span class="badge bg-danger ms-2">¡Stock Bajo!</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Estado</label>
                                <select name="Activo" class="form-select">
                                    <option value="true" @(Model.Activo ? "selected" : "")>Activo</option>
                                    <option value="false" @(!Model.Activo ? "selected" : "")>Inactivo</option>
                                </select>
                                <small class="text-muted">Los productos inactivos no aparecerán en ventas pero seguirán recibiendo lotes</small>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Nota:</strong> El stock actual no se puede modificar manualmente. Se actualiza automáticamente al:
                            <ul class="mb-0 mt-2">
                                <li>Agregar nuevos lotes (compra)</li>
                                <li>Vender productos (descuento automático por FIFO)</li>
                                <li>Registrar devoluciones</li>
                            </ul>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="@Url.Action("Index", "Producto")" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </a>
                            <a href="@Url.Action("Detalle", new { id = Model.ProductoCompraId })" class="btn btn-info">
                                <i class="fas fa-eye me-1"></i> Ver Detalle
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 1400px;
        margin: auto;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            transition: all 0.3s ease;
            border-radius: 10px;
            padding: 8px 18px;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
                transform: translateY(-2px);
            }

    .card-body-custom {
        background: #fff;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 12px;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #c95a00;
            box-shadow: 0 0 0 3px rgba(201,90,0,0.15);
            outline: none;
        }

    .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201,90,0,0.3);
        }

    .btn-secondary {
        background: #6c757d;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    .btn-info {
        background: #17a2b8;
        border: none;
        color: white;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-info:hover {
            background: #138496;
            transform: translateY(-2px);
            color: white;
        }

    .border-top {
        border-top: 1px solid #e9ecef !important;
    }

    .alert-warning ul {
        padding-left: 20px;
    }

    @@media (max-width: 768px) {
        .card-header-custom {
            padding: 1rem;
        }

            .card-header-custom h2 {
                font-size: 1.3rem;
            }

        .btn-primary, .btn-secondary, .btn-info {
            width: 100%;
            margin-top: 10px;
        }

        .d-flex.justify-content-end {
            flex-direction: column;
        }
    }
</style>
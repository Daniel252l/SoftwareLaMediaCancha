@model LaMediaCancha.Models.ProductoModels.ProductoCompra

@{
    ViewBag.Title = "Crear Materia Prima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card-custom">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-plus-circle me-2"></i> Nueva Materia Prima
                            </h2>
                            <p class="mb-0 text-white-50">Ingrese los datos del nuevo insumo o materia prima</p>
                        </div>
                        <a href="@Url.Action("Index", "Producto")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom p-4">
                    @using (Html.BeginForm("Crear", "Producto", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Código <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", placeholder = "Ej: CAR001, VER001, ABA001", required = "required" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Unidad de Medida <span class="text-danger">*</span></label>
                                <select name="UnidadMedida" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Kilogramo">Kilogramo (kg)</option>
                                    <option value="Gramo">Gramo (g)</option>
                                    <option value="Libra">Libra (lb)</option>
                                    <option value="Litro">Litro (L)</option>
                                    <option value="Mililitro">Mililitro (ml)</option>
                                    <option value="Unidad">Unidad (unid)</option>
                                    <option value="Paquete">Paquete (pq)</option>
                                    <option value="Caja">Caja (cj)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre de la materia prima", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3, placeholder = "Descripción opcional" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Categoría</label>
                                @Html.DropDownListFor(m => m.CategoriaId, ViewBag.CategoriasCompra as SelectList, "Seleccione una categoría...", new { @class = "form-select" })
                                <small class="text-muted">Clasifique el producto para mejor organización</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio Compra (Q) <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.PrecioCompra, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "0.00", required = "required" })
                                <small class="text-muted">Precio de compra al proveedor</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Mínimo</label>
                                @Html.TextBoxFor(m => m.StockMinimo, new { @class = "form-control", type = "number", step = "0.01", min = "0", value = "0" })
                                <small class="text-muted">Cuando el stock baje de este nivel, se mostrará una alerta</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Estado</label>
                                <select name="Activo" class="form-select">
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Información:</strong> Una vez creado el producto, podrá agregar lotes con fechas de fabricación, vencimiento y costos específicos. El sistema manejará el inventario por el método FIFO (primero en vencer, primero en salir).
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="@Url.Action("Index", "Producto")" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Guardar Materia Prima
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 1400px;
        margin: auto;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            transition: all 0.3s ease;
            border-radius: 10px;
            padding: 8px 18px;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
                transform: translateY(-2px);
            }

    .card-body-custom {
        background: #fff;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 12px;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #c95a00;
            box-shadow: 0 0 0 3px rgba(201,90,0,0.15);
            outline: none;
        }

    .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201,90,0,0.3);
        }

    .btn-secondary {
        background: #6c757d;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    .border-top {
        border-top: 1px solid #e9ecef !important;
    }

    .alert-info {
        background-color: #e8f4f8;
        border-color: #b8e0f0;
        color: #0c5460;
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        .card-header-custom {
            padding: 1rem;
        }

            .card-header-custom h2 {
                font-size: 1.3rem;
            }

        .btn-primary, .btn-secondary {
            width: 100%;
        }

        .d-flex.justify-content-end {
            flex-direction: column;
        }
    }
</style>
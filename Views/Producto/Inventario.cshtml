@model IEnumerable<LaMediaCancha.Models.ProductoModels.InventarioCompra>

@{
    ViewBag.Title = "Inventario de Materias Primas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-warehouse me-2"></i> Inventario de Materias Primas
                            </h2>
                            <p class="mb-0 text-white-50">Control de existencias y stock de insumos</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                            <a href="@Url.Action("Index", "Producto")" class="btn btn-light">
                                <i class="fas fa-boxes me-1"></i> Materias Primas
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Unidad</th>
                                    <th>Categoría</th>
                                    <th class="text-end">Precio Compra</th>
                                    <th class="text-center">Stock Actual</th>
                                    <th class="text-center">Stock Mínimo</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string estadoBadge = item.EstadoStock == "Bajo" ? "bg-danger" : (item.EstadoStock == "Alerta" ? "bg-warning" : "bg-success");

                                    <tr>
                                        <td><span class="badge bg-light text-dark">@item.Codigo</span></td>
                                        <td class="fw-bold">@item.Nombre</td>
                                        <td>@item.UnidadMedida</td>
                                        <td>@item.Categoria</td>
                                        <td class="text-end text-success fw-bold">Q @string.Format("{0:N2}", item.PrecioCompra)</td>
                                        <td class="text-center">
                                            <span class="fw-bold @(item.EstadoStock == "Bajo" ? "text-danger" : "")">@item.StockActual</span>
                                        </td>
                                        <td class="text-center">@item.StockMinimo</td>
                                        <td class="text-center">
                                            <span class="badge @estadoBadge px-3 py-2">@item.EstadoStock</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a href="@Url.Action("Detalle", new { id = item.ProductoCompraId })" class="btn btn-info btn-sm text-white">
                                                    <i class="fas fa-eye me-1"></i>Ver
                                                </a>
                                                <a href="@Url.Action("Lotes", new { id = item.ProductoCompraId })" class="btn btn-secondary btn-sm">
                                                    <i class="fas fa-layer-group me-1"></i>Lotes
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 30px !important;
        padding-right: 30px !important;
    }

    .card-custom {
        width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        width: 100% !important;
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
    }

    .card-body-custom {
        padding: 20px;
    }

    .table {
        width: 100%;
        margin-bottom: 0;
    }

        .table th {
            padding: 14px 12px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .table td {
            padding: 14px 12px;
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background: rgba(201,90,0,0.05);
    }

    .btn {
        border-radius: 10px;
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }
</style>
@model IEnumerable<LaMediaCancha.Models.ProductoModels.InventarioProducto>

@{
    ViewBag.Title = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom" style="max-width: 100%;">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-warehouse me-2"></i> Inventario
                            </h2>
                            <p class="mb-0 text-white-50">
                                Control de existencias y stock de productos
                            </p>
                        </div>

                        <div class="mt-2 mt-sm-0">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light me-2">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>

                            <a href="@Url.Action("Index", "Producto")" class="btn btn-light">
                                <i class="fas fa-boxes me-1"></i> Productos
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-3">

                    <!-- Filtros -->
                    <div class="barra-filtros">
                        <div class="filtro-item filtro-busqueda">
                            <i class="fas fa-search icono-busqueda"></i>
                            <input type="text"
                                   id="busquedaGeneral"
                                   class="form-control"
                                   placeholder="Buscar producto o código..." />
                        </div>

                        <div class="filtro-item">
                            <select id="filtroDepartamento" class="form-select">
                                <option value="">Todos los departamentos</option>
                                @foreach (var dep in Model.Select(x => x.Departamento).Distinct().OrderBy(x => x))
                                {
                                    <option value="@dep">@dep</option>
                                }
                            </select>
                        </div>

                        <div class="filtro-item">
                            <select id="filtroEstado" class="form-select">
                                <option value="">Todos los estados</option>
                                <option value="NORMAL">Normal</option>
                                <option value="STOCK BAJO">Stock Bajo</option>
                                <option value="STOCK ALTO">Stock Alto</option>
                                <option value="AGOTADO">Agotado</option>
                            </select>
                        </div>

                        <button type="button" id="btnLimpiarFiltros" class="btn btn-secondary">
                            <i class="fas fa-eraser me-1"></i> Limpiar
                        </button>
                    </div>

                    <!-- Tabla -->
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tblInventario">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th>Departamento</th>
                                    <th class="text-center">Stock Actual</th>
                                    <th class="text-center">Stock Mínimo</th>
                                    <th class="text-center">Stock Máximo</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string estadoTexto = item.ExistenciaActual == 0 ? "AGOTADO"
                                        : item.ExistenciaActual <= item.StockMinimo ? "STOCK BAJO"
                                        : item.ExistenciaActual >= item.StockMaximo ? "STOCK ALTO"
                                        : "NORMAL";

                                    string estadoBadge = item.ExistenciaActual == 0 ? "badge-danger"
                                        : item.ExistenciaActual <= item.StockMinimo ? "badge-warning"
                                        : item.ExistenciaActual >= item.StockMaximo ? "badge-info"
                                        : "badge-success";

                                    <tr data-departamento="@item.Departamento"
                                        data-estado="@estadoTexto">

                                        <td class="fw-bold">@item.Codigo</td>
                                        <td><strong>@item.Nombre</strong></td>
                                        <td>@item.Departamento</td>

                                        <td class="text-center">
                                            <span class="stock-actual @(item.ExistenciaActual <= item.StockMinimo ? "stock-bajo" : "")">
                                                @item.ExistenciaActual
                                            </span>
                                        </td>

                                        <td class="text-center">@item.StockMinimo</td>
                                        <td class="text-center">@item.StockMaximo</td>

                                        <td class="text-center">
                                            <span class="badge @estadoBadge">
                                                @estadoTexto
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex gap-2 justify-content-center">

                                                <button type="button"
                                                        class="btn btn-sm btn-primary btn-ajustar"
                                                        data-id="@item.ProductoId"
                                                        data-nombre="@item.Nombre"
                                                        data-actual="@item.ExistenciaActual"
                                                        data-min="@item.StockMinimo"
                                                        data-max="@item.StockMaximo">
                                                    <i class="fas fa-edit"></i> Ajustar
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-info btn-lotes"
                                                        data-id="@item.ProductoId"
                                                        data-nombre="@item.Nombre">
                                                    <i class="fas fa-layer-group"></i> Lotes
                                                </button>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div id="sinResultados"
                             style="display:none; text-align:center; padding:30px; color:#999;">
                            <i class="fas fa-search"
                               style="font-size:2rem; margin-bottom:10px;"></i>
                            <p>No se encontraron productos con los filtros aplicados</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ajustar Inventario -->
<div class="modal fade" id="modalAjustarInventario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header modal-header-custom">
                <h5 class="modal-title text-white">
                    <i class="fas fa-edit me-2"></i> Ajustar Inventario
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form id="frmAjustarInventario">
                <div class="modal-body">

                    <input type="hidden" id="ajusteProductoId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Producto</label>
                        <input type="text"
                               id="ajusteProductoNombre"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Stock Actual</label>
                        <input type="number"
                               id="ajusteStockActual"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nuevo Stock</label>
                        <input type="number"
                               id="ajusteNuevoStock"
                               class="form-control"
                               min="0"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Stock Mínimo</label>
                        <input type="number"
                               id="ajusteStockMinimo"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Stock Máximo</label>
                        <input type="number"
                               id="ajusteStockMaximo"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo del Ajuste</label>
                        <textarea id="ajusteMotivo"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Ej: Ajuste por inventario físico"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Guardar Ajuste
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts{
    <script>
    $(function () {

        // Inicializar modal correctamente
        const modalEl = document.getElementById('modalAjustarInventario');
        const ajusteModal = bootstrap.Modal.getOrCreateInstance(modalEl);

        // FILTROS
        function filtrarTabla() {
            let busqueda = $('#busquedaGeneral').val().toLowerCase().trim();
            let departamento = $('#filtroDepartamento').val().toLowerCase();
            let estado = $('#filtroEstado').val().toUpperCase();
            let visibles = 0;

            $('#tblInventario tbody tr').each(function () {

                let codigo = $(this).find('td:eq(0)').text().toLowerCase();
                let producto = $(this).find('td:eq(1)').text().toLowerCase();
                let depFila = ($(this).data('departamento') || '').toString().toLowerCase();
                let estFila = ($(this).data('estado') || '').toString().toUpperCase();

                let mostrar =
                    (busqueda === '' || codigo.includes(busqueda) || producto.includes(busqueda)) &&
                    (departamento === '' || depFila === departamento) &&
                    (estado === '' || estFila === estado);

                $(this).toggle(mostrar);

                if (mostrar) visibles++;
            });

            $('#sinResultados').toggle(visibles === 0);
        }

        $('#busquedaGeneral').on('input', filtrarTabla);
        $('#filtroDepartamento').on('change', filtrarTabla);
        $('#filtroEstado').on('change', filtrarTabla);

        $('#btnLimpiarFiltros').on('click', function () {
            $('#busquedaGeneral').val('');
            $('#filtroDepartamento').val('');
            $('#filtroEstado').val('');
            filtrarTabla();
        });

        // Abrir modal
        $(document).on('click', '.btn-ajustar', function () {

            $('#ajusteProductoId').val($(this).data('id'));
            $('#ajusteProductoNombre').val($(this).data('nombre'));
            $('#ajusteStockActual').val($(this).data('actual'));
            $('#ajusteNuevoStock').val($(this).data('actual'));
            $('#ajusteStockMinimo').val($(this).data('min'));
            $('#ajusteStockMaximo').val($(this).data('max'));
            $('#ajusteMotivo').val('');

            ajusteModal.show();
        });

        // Ver lotes
        $(document).on('click', '.btn-lotes', function () {
            let nombre = $(this).data('nombre');

            Swal.fire({
                icon: 'info',
                title: 'Lotes del producto',
                text: 'Ver lotes de: ' + nombre,
                confirmButtonColor: '#c95a00'
            });
        });

        // Guardar ajuste
        $('#frmAjustarInventario').on('submit', function (e) {
            e.preventDefault();

            let nuevoStock = parseInt($('#ajusteNuevoStock').val());
            let stockMinimo = parseInt($('#ajusteStockMinimo').val());
            let stockMaximo = parseInt($('#ajusteStockMaximo').val());

            if (isNaN(nuevoStock) || nuevoStock < 0) {
                Swal.fire('Atención', 'Ingrese un stock válido', 'warning');
                return;
            }

            if (stockMinimo > stockMaximo) {
                Swal.fire('Atención', 'El stock mínimo no puede ser mayor al máximo', 'warning');
                return;
            }

            $.ajax({
                url: '@Url.Action("AjustarInventario", "Producto")',
                type: 'POST',
                data: {
                    productoId: $('#ajusteProductoId').val(),
                    nuevoStock: nuevoStock,
                    stockMinimo: stockMinimo,
                    stockMaximo: stockMaximo,
                    motivo: $('#ajusteMotivo').val()
                },
                success: function (response) {
                    if (response.success) {

                        ajusteModal.hide();

                        Swal.fire({
                            icon: 'success',
                            title: '¡Inventario actualizado!',
                            text: response.message,
                            confirmButtonColor: '#c95a00'
                        }).then(function () {
                            location.reload();
                        });

                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire(
                        'Error',
                        'Error al procesar la solicitud',
                        'error'
                    );
                }
            });
        });

    });
    </script>
}

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        margin-bottom: 20px;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
    }

    .card-body-custom {
        padding: 0;
    }

    .barra-filtros {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f8f9fa;
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .filtro-item {
        position: relative;
    }

    .filtro-busqueda {
        flex: 1;
        min-width: 220px;
    }

    .icono-busqueda {
        position: absolute;
        left: 12px;
        top: 12px;
        color: #999;
        z-index: 2;
    }

    .filtro-busqueda input {
        padding-left: 35px;
    }

    .badge-success {
        background-color: #27AE60;
    }

    .badge-warning {
        background-color: #F39C12;
    }

    .badge-danger {
        background-color: #E74C3C;
    }

    .badge-info {
        background-color: #3498DB;
    }

    .badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: .7rem;
    }

    .stock-actual {
        font-weight: bold;
    }

    .stock-bajo {
        color: #E74C3C;
    }

    .btn-primary {
        background: linear-gradient(135deg,#c95a00,#a04700);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#a04700,#8b3a00);
        }

    .modal-header-custom {
        background: linear-gradient(135deg,#c95a00,#a04700);
    }

    .modal-content {
        border-radius: 15px;
        overflow: hidden;
    }

    @@media (max-width:768px) {
        .barra-filtros {
            flex-direction: column;
            align-items: stretch;
        }

        .filtro-busqueda {
            width: 100%;
        }

        .d-flex.gap-2 {
            flex-direction: column;
        }

        .btn-sm {
            width: 100%;
        }
    }
</style>
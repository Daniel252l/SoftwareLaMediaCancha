@model IEnumerable<LaMediaCancha.Models.ProductoModels.InventarioCompra>

@{
    ViewBag.Title = "Stock Bajo - Materias Primas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom" style="background: linear-gradient(135deg, #dc3545, #c82333);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-exclamation-triangle me-2"></i> Stock Bajo - Materias Primas
                            </h2>
                            <p class="mb-0 text-white-50">Productos que requieren reabastecimiento</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Inventario", "Producto")" class="btn btn-outline-light">
                                <i class="fas fa-warehouse me-1"></i> Ver Inventario
                            </a>
                            <a href="@Url.Action("Index", "Compra")" class="btn btn-outline-light">
                                <i class="fas fa-shopping-cart me-1"></i> Realizar Compra
                            </a>
                            <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                            <h3 class="text-success">¡Todo está bien!</h3>
                            <p class="text-muted">No hay productos con stock bajo en este momento.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Código</th>
                                        <th>Producto</th>
                                        <th>Unidad</th>
                                        <th>Categoría</th>
                                        <th class="text-end">Precio Compra</th>
                                        <th class="text-center">Stock Actual</th>
                                        <th class="text-center">Stock Mínimo</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark">@item.Codigo</span></td>
                                            <td class="fw-bold">
                                                @item.Nombre
                                        </td>
                                        <td>
                                            @item.UnidadMedida
                                    </td>
                                    <td>@item.Categoria
                                </td>
                                <td class="text-end text-success fw-bold">Q @item.PrecioCompra.ToString("N2")
            </td>
            <td class="text-center">
                <span class="text-danger fw-bold">@item.StockActual</span>
            </td>
            <td class="text-center">@item.StockMinimo
        </td>
        <td class="text-center">
            <span class="badge bg-danger px-3 py-2">
                <i class="fas fa-exclamation-triangle me-1"></i> @item.EstadoStock
            </span>
        </td>
        <td class="text-center">
            <div class="d-flex justify-content-center gap-2">
                <a href="@Url.Action("Detalle", new { id = item.ProductoCompraId })" class="btn btn-info btn-sm text-white">
                    <i class="fas fa-eye"></i> Ver
                </a>
                <a href="@Url.Action("CrearLote", new { productoCompraId = item.ProductoCompraId })" class="btn btn-success btn-sm">
                    <i class="fas fa-plus-circle"></i> Agregar Lote
                </a>
            </div>
        </td>
    </tr>
}
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 30px !important;
        padding-right: 30px !important;
    }

    .card-custom {
        width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        width: 100% !important;
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem 2rem;
    }

    .card-body-custom {
        padding: 20px;
    }

    .table th {
        padding: 14px 12px;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .table td {
        padding: 14px 12px;
        vertical-align: middle;
    }

    .btn {
        border-radius: 10px;
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .badge {
        font-size: .75rem;
        font-weight: 600;
    }
</style>
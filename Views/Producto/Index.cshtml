@model IEnumerable<LaMediaCancha.Models.ProductoModels.ProductoCompra>

@{
    ViewBag.Title = "Materias Primas / Insumos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-boxes me-2"></i> Materias Primas / Insumos
                            </h2>
                            <p class="mb-0 text-white-50">Productos que se compran a proveedores</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                            <a href="@Url.Action("Crear")" class="btn btn-light">
                                <i class="fas fa-plus-circle me-1"></i> Nueva Materia Prima
                            </a>
                            <a href="@Url.Action("Inventario")" class="btn btn-outline-light">
                                <i class="fas fa-chart-line me-1"></i> Inventario
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Unidad</th>
                                    <th>Categoría</th>
                                    <th class="text-end">Precio Compra</th>
                                    <th class="text-center">Stock Actual</th>
                                    <th class="text-center">Stock Mínimo</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">@item.Codigo</span></td>
                                        <td class="fw-bold">@item.Nombre</td>
                                        <td>@item.UnidadMedida</td>
                                        <td>@item.Categoria</td>
                                        <td class="text-end text-success fw-bold">Q @string.Format("{0:N2}", item.PrecioCompra)</td>
                                        <td class="text-center">
                                            @if (item.StockActual <= item.StockMinimo)
                                            {
                                                <span class="text-danger fw-bold">@item.StockActual</span>
                                            }
                                            else
                                            {
                                                <span>@item.StockActual</span>
                                            }
                                        </td>
                                        <td class="text-center">@item.StockMinimo</td>
                                        <td class="text-center">
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2">
                                                    <i class="fas fa-check-circle me-1"></i>Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                    <i class="fas fa-ban me-1"></i>Inactivo
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center flex-wrap gap-2">
                                                <a href="@Url.Action("Detalle", new { id = item.ProductoCompraId })" class="btn btn-info btn-sm text-white">
                                                    <i class="fas fa-eye me-1"></i>Ver
                                                </a>
                                                <a href="@Url.Action("Editar", new { id = item.ProductoCompraId })" class="btn btn-warning btn-sm text-white">
                                                    <i class="fas fa-edit me-1"></i>Editar
                                                </a>
                                                <a href="@Url.Action("Lotes", new { id = item.ProductoCompraId })" class="btn btn-secondary btn-sm">
                                                    <i class="fas fa-layer-group me-1"></i>Lotes
                                                </a>
                                                @if (item.Activo)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm" onclick="cambiarEstado(@item.ProductoCompraId, '@item.Nombre.Replace("'", "\\'")', false)">
                                                        <i class="fas fa-toggle-off me-1"></i>Inactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-success btn-sm" onclick="cambiarEstado(@item.ProductoCompraId, '@item.Nombre.Replace("'", "\\'")', true)">
                                                        <i class="fas fa-toggle-on me-1"></i>Activar
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function cambiarEstado(id, nombre, activar) {
            var titulo = activar ? "¿Activar materia prima?" : "¿Inactivar materia prima?";
            var texto = activar ? `¿Desea activar "${nombre}"?` : `¿Desea inactivar "${nombre}"?`;

            Swal.fire({
                title: titulo,
                text: texto,
                icon: activar ? "question" : "warning",
                showCancelButton: true,
                confirmButtonColor: activar ? "#28a745" : "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: activar ? "Sí, activar" : "Sí, inactivar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("CambiarEstado", "Producto")',
                        type: 'POST',
                        data: { id: id, activo: activar },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({ icon: 'success', title: 'Éxito', text: response.message, confirmButtonColor: '#28a745' })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: response.message });
                            }
                        },
                        error: function () {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Error al cambiar el estado' });
                        }
                    });
                }
            });
        }
    </script>
}

<style>
    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 30px !important;
        padding-right: 30px !important;
    }

    .card-custom {
        width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        width: 100% !important;
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
    }

    .card-body-custom {
        padding: 20px;
    }

    .table {
        width: 100%;
        margin-bottom: 0;
    }

        .table th {
            padding: 14px 12px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .table td {
            padding: 14px 12px;
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background: rgba(201,90,0,0.05);
    }

    .btn {
        border-radius: 10px;
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg,#c95a00,#a04700);
        border: none;
    }

    .btn-warning {
        background: #c95a00;
        border-color: #c95a00;
        color: white;
    }

        .btn-warning:hover {
            background: #a04700;
            border-color: #a04700;
            color: white;
        }

    .badge {
        font-size: .75rem;
        font-weight: 600;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }
</style>
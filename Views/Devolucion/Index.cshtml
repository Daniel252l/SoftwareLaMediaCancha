@model IEnumerable<LaMediaCancha.Models.DevolucionModels.EncabezadoDevolucion>

@{
    ViewBag.Title = "Devoluciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-undo-alt me-2"></i> Devoluciones
                            </h2>
                            <p class="mb-0 text-white-50">Historial de devoluciones registradas</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Registrar", "Devolucion")" class="btn btn-light">
                                <i class="fas fa-plus-circle me-1"></i> Nueva Devolución
                            </a>
                            <a href="@Url.Action("Index", "Compra")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID Devolución</th>
                                    <th>Documento Compra</th>
                                    <th>Fecha Devolución</th>
                                    <th>Motivo</th>
                                    <th>Tipo</th>
                                    <th class="text-end">Monto</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.DevolucionId</td>
                                        <td>@item.NumeroDocCompra</td>
                                        <td>@item.FechaDevolucion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@item.Motivo</td>
                                        <td>@item.TipoDevolucion</td>
                                        <td class="text-end text-danger fw-bold">Q @item.MontoTotal.ToString("N2")</td>
                                        <td class="text-center">
                                            <span class="badge bg-success px-3 py-2">@item.Estado</span>
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("Detalle", new { id = item.DevolucionId })" class="btn btn-info btn-sm text-white">
                                                <i class="fas fa-eye me-1"></i> Ver
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 30px !important;
        padding-right: 30px !important;
    }

    .card-custom {
        width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        width: 100% !important;
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
    }

    .card-body-custom {
        padding: 20px;
    }

    .table {
        width: 100%;
        margin-bottom: 0;
    }

        .table th {
            padding: 14px 12px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .table td {
            padding: 14px 12px;
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background: rgba(201,90,0,0.05);
    }

    .btn {
        border-radius: 10px;
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .badge {
        font-size: .75rem;
        font-weight: 600;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }
</style>
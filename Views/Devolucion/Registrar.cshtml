@model LaMediaCancha.Models.ViewModels.RegistrarDevolucionViewModel
@{
    ViewBag.Title = "Registrar Devolución";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card-custom" style="max-width: 100%;">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-undo-alt"></i> Registrar Devolución</h2>
                            <p>Ingrese el número de factura para buscar la compra</p>
                        </div>
                        <a href="@Url.Action("Index", "Compra")" class="btn-custom" style="width: auto; padding: 10px 20px; background: #6c757d;">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom">

                    <div id="mensajeError" class="alert alert-danger" style="display: none;"></div>
                    <div id="mensajeExito" class="alert alert-success" style="display: none;"></div>

                    <div class="buscador-factura">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group-custom">
                                    <label>Número de Factura <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="txtNumeroFactura" class="form-control-custom" placeholder="Ingrese el número de factura" />
                                        <button type="button" id="btnBuscarFactura" class="btn-buscar">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="infoCompra" style="display: none;">
                        <div class="info-compra">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group-custom">
                                        <label>DOCUMENTO COMPRA</label>
                                        <input type="text" id="txtDocumentoCompra" class="form-control-custom" readonly />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-custom">
                                        <label>PROVEEDOR</label>
                                        <input type="text" id="txtProveedor" class="form-control-custom" readonly />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-custom">
                                        <label>PLAZO DEVOLUCIÓN</label>
                                        <div id="plazoInfo"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="divProductos" style="display: none;">
                            <hr />
                            <h4>Productos a devolver</h4>
                            <div class="table-responsive">
                                <table class="table-custom" id="tblProductos">
                                    <thead>
                                        <tr>
                                            <th>Código</th>
                                            <th>Producto</th>
                                            <th>Presentación</th>
                                            <th class="text-center">Comprado</th>
                                            <th class="text-center">Devuelto</th>
                                            <th class="text-center">Disponible</th>
                                            <th class="text-center">A Devolver</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblProductosBody">
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="6" class="text-right">
                                                <strong>Total a Devolver:</strong>
                                            </td>
                                            <td class="text-center">
                                                <strong id="totalDevolver">0</strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group-custom">
                                        <label>Tipo Devolución <span class="text-danger">*</span></label>
                                        <select id="TipoDevolucion" class="form-control-custom">
                                            <option value="">Seleccione...</option>
                                            <option value="ProductoDefectuoso">Producto Defectuoso</option>
                                            <option value="ProductoSobrante">Producto Sobrante</option>
                                            <option value="ErrorFacturacion">Error de Facturación</option>
                                            <option value="Otro">Otro</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group-custom">
                                        <label>Motivo <span class="text-danger">*</span></label>
                                        <textarea id="Motivo" class="form-control-custom" rows="2" placeholder="Describa el motivo de la devolución"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group-custom">
                                <label>Observaciones</label>
                                <textarea id="Observaciones" class="form-control-custom" rows="2" placeholder="Información adicional (opcional)"></textarea>
                            </div>

                            <div class="text-right mt-3">
                                <button type="button" id="btnRegistrarDevolucion" class="btn-custom" style="width: auto; padding: 12px 25px;">
                                    <i class="fas fa-save"></i> Registrar Devolución
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .buscador-factura {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .input-group {
            display: flex;
            gap: 10px;
        }

        .btn-buscar {
            background: linear-gradient(135deg, #8B4513, #D35400);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            white-space: nowrap;
        }

            .btn-buscar:hover {
                transform: translateY(-2px);
            }

        .info-compra {
            background: #e8f4f8;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .badge-info {
            background: #3498DB;
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.7rem;
            display: inline-block;
        }

        .badge-success {
            background: #27AE60;
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.7rem;
            display: inline-block;
        }

        .badge-danger {
            background: #E74C3C;
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.7rem;
            display: inline-block;
        }

        .alert-danger, .alert-success {
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th, .table-custom td {
                padding: 12px;
                border-bottom: 1px solid #eee;
                vertical-align: middle;
            }

            .table-custom th {
                background: #8B4513;
                color: white;
            }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .text-danger {
            color: #E74C3C;
        }

        .form-group-custom {
            margin-bottom: 20px;
        }

        .form-control-custom {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }

            .form-control-custom:focus {
                outline: none;
                border-color: #8B4513;
            }

            .form-control-custom[readonly] {
                background-color: #f8f9fa;
            }

        .cantidad-input {
            width: 80px !important;
            text-align: center;
            padding: 6px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var compraIdActual = 0;

        function mostrarMensaje(mensaje, tipo) {
            if (tipo === 'error') {
                $('#mensajeError').text(mensaje).show();
                setTimeout(function () { $('#mensajeError').fadeOut(); }, 5000);
            } else {
                $('#mensajeExito').text(mensaje).show();
                setTimeout(function () { $('#mensajeExito').fadeOut(); }, 3000);
            }
        }

        function calcularTotal() {
            var total = 0;
            document.querySelectorAll('.cantidad-input').forEach(function (input) {
                var val = parseFloat(input.value) || 0;
                total += val;
            });
            document.getElementById('totalDevolver').textContent = total;
        }

        function cargarProductos(compraId) {
            $.ajax({
                url: '@Url.Action("GetProductosPorCompra", "Devolucion")',
                type: 'GET',
                data: { compraId: compraId },
                dataType: 'json',
                success: function (data) {
                    var tbody = $('#tblProductosBody');
                    tbody.empty();

                    if (data.error) {
                        tbody.append('<tr><td colspan="7" class="text-center">⚠️ ' + data.error + '</td></tr>');
                        $('#divProductos').hide();
                        return;
                    }

                    if (!data || data.length === 0) {
                        tbody.append('<tr><td colspan="7" class="text-center">⚠️ No hay productos disponibles para devolver</td></tr>');
                        $('#divProductos').hide();
                    } else {
                        $('#divProductos').show();

                        for (var i = 0; i < data.length; i++) {
                            var p = data[i];
                            var disponible = p.CantidadComprada - p.CantidadYaDevuelta;
                            var presentacion = (p.Presentacion && p.Presentacion !== '') ? p.Presentacion : 'Unidad';

                            var row = '<tr>' +
                                '<td>' + p.CodigoProducto + '</td>' +
                                '<td>' + p.NombreProducto + '</td>' +
                                '<td>' + presentacion + '</td>' +
                                '<td class="text-center">' + p.CantidadComprada + '</td>' +
                                '<td class="text-center">' + p.CantidadYaDevuelta + '</td>' +
                                '<td class="text-center"><span class="badge-info">' + disponible + '</span></td>' +
                                '<td class="text-center">' +
                                    '<input type="number" class="cantidad-input" ' +
                                    'min="0" max="' + disponible + '" step="1" ' +
                                    'data-id="' + p.ProductoId + '" ' +
                                    'data-precio="' + p.PrecioUnitario + '" ' +
                                    'data-nombre="' + p.NombreProducto.replace(/"/g, '&quot;') + '" />' +
                                '</td>' +
                                '</tr>';
                            tbody.append(row);
                        }

                        // Setear valor 0 usando propiedad DOM directa
                        document.querySelectorAll('.cantidad-input').forEach(function (input) {
                            input.value = 0;
                            input.addEventListener('input', calcularTotal);
                            input.addEventListener('change', calcularTotal);
                        });

                        calcularTotal();
                    }
                },
                error: function () {
                    mostrarMensaje('Error al cargar los productos', 'error');
                }
            });
        }

        $(document).ready(function () {

            $('#btnBuscarFactura').click(function () {
                var numeroFactura = $('#txtNumeroFactura').val().trim();

                if (!numeroFactura) {
                    Swal.fire('Atención', 'Ingrese un número de factura', 'warning');
                    return;
                }

                $('#btnBuscarFactura').html('<i class="fas fa-spinner fa-spin"></i> Buscando...');
                $('#btnBuscarFactura').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("BuscarPorFactura", "Devolucion")',
                    type: 'GET',
                    data: { numeroFactura: numeroFactura },
                    dataType: 'json',
                    cache: false,
                    success: function (response) {
                        if (response.success) {
                            compraIdActual = response.compraId;
                            $('#txtDocumentoCompra').val(response.numeroDocumento);
                            $('#txtProveedor').val(response.proveedorNombre);

                            var plazoHtml = '<input type="text" class="form-control-custom" readonly value="' + response.diasTranscurridos + ' / ' + response.diasMaximos + ' días" />';
                            if (response.dentroDePlazo) {
                                plazoHtml += '<span class="badge-success" style="margin-left: 10px;">Válido</span>';
                            } else {
                                plazoHtml += '<span class="badge-danger" style="margin-left: 10px;">Vencido</span>';
                            }
                            $('#plazoInfo').html(plazoHtml);
                            $('#infoCompra').show();

                            if (response.dentroDePlazo) {
                                cargarProductos(compraIdActual);
                            } else {
                                $('#divProductos').hide();
                                mostrarMensaje(response.mensajePlazo, 'error');
                            }
                        } else {
                            mostrarMensaje(response.message, 'error');
                            $('#infoCompra').hide();
                            $('#divProductos').hide();
                        }
                    },
                    error: function () {
                        mostrarMensaje('Error al buscar la factura', 'error');
                        $('#infoCompra').hide();
                        $('#divProductos').hide();
                    },
                    complete: function () {
                        $('#btnBuscarFactura').html('<i class="fas fa-search"></i> Buscar');
                        $('#btnBuscarFactura').prop('disabled', false);
                    }
                });
            });

            $('#txtNumeroFactura').keypress(function (e) {
                if (e.which === 13) {
                    $('#btnBuscarFactura').click();
                }
            });

            // *** BOTON REGISTRAR DEVOLUCION - CORREGIDO ***
            $(document).on('click', '#btnRegistrarDevolucion', function () {
                var tipoDevolucion = document.getElementById('TipoDevolucion').value;
                var motivo = document.getElementById('Motivo').value.trim();
                var observaciones = document.getElementById('Observaciones').value.trim();

                if (!tipoDevolucion) {
                    Swal.fire('Atención', 'Seleccione un tipo de devolución', 'warning');
                    return;
                }

                if (!motivo) {
                    Swal.fire('Atención', 'Ingrese el motivo de la devolución', 'warning');
                    return;
                }

                var productos = [];

                // *** FIX PRINCIPAL: usar propiedad DOM nativa ***
                document.querySelectorAll('.cantidad-input').forEach(function (input) {
                    var cantidad = parseFloat(input.value) || 0;
                    var productoId = input.getAttribute('data-id');
                    var precioUnitario = input.getAttribute('data-precio');

                    if (cantidad > 0) {
                        productos.push({
                            ProductoId: parseInt(productoId),
                            CantidadADevolver: cantidad,
                            PrecioUnitario: parseFloat(precioUnitario)
                        });
                    }
                });

                console.log("Productos a devolver:", productos);

                if (productos.length === 0) {
                    Swal.fire('Atención', 'Debe ingresar cantidad mayor a 0 en al menos un producto', 'warning');
                    return;
                }

                Swal.fire({
                    title: '¿Registrar devolución?',
                    text: '¿Está seguro de registrar esta devolución?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, registrar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        var btn = document.getElementById('btnRegistrarDevolucion');
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Registrando...';
                        btn.disabled = true;

                        $.ajax({
                            url: '@Url.Action("Registrar", "Devolucion")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                CompraId: compraIdActual,
                                TipoDevolucion: tipoDevolucion,
                                Motivo: motivo,
                                Observaciones: observaciones,
                                Productos: productos
                            }),
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Devolución registrada!',
                                        text: response.message,
                                        confirmButtonText: 'Ver detalle'
                                    }).then(function (res) {
                                        if (res.isConfirmed) {
                                            window.location.href = '@Url.Action("Detalle", "Devolucion")/' + response.devolucionId;
                                        } else {
                                            window.location.href = '@Url.Action("Index", "Devolucion")';
                                        }
                                    });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                    btn.innerHTML = '<i class="fas fa-save"></i> Registrar Devolución';
                                    btn.disabled = false;
                                }
                            },
                            error: function (xhr) {
                                console.error("Error:", xhr.responseText);
                                Swal.fire('Error', 'Error al registrar la devolución', 'error');
                                btn.innerHTML = '<i class="fas fa-save"></i> Registrar Devolución';
                                btn.disabled = false;
                            }
                        });
                    }
                });
            });
        });
    </script>
}
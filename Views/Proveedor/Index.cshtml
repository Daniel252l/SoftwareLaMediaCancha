@model IEnumerable<LaMediaCancha.Models.Proveedor>
@{
    ViewBag.Title = "Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom" style="max-width: 100%;">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-truck"></i> Proveedores</h2>
                            <p>Gestión de proveedores del sistema</p>
                        </div>
                        <a href="@Url.Action("Crear", "Proveedor")" class="btn-custom" style="width: auto;">
                            <i class="fas fa-plus"></i> Nuevo Proveedor
                        </a>
                    </div>
                </div>
                <div class="card-body-custom">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> @TempData["Success"]
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table-custom" id="tblProveedores">
                            <thead>
                                <tr>
                                    <th>NIT</th>
                                    <th>Razón Social</th>
                                    <th>Contacto</th>
                                    <th>Teléfono</th>
                                    <th>Política</th>
                                    <th class="text-center">Días</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @item.Nit
                                    </td>
                                    <td>
                                        @item.RazonSocial
                                </td>
                                <td>
                                    @item.Contacto
                            </td>
                            <td>@item.Telefono
                        </td>
                        <td>
                            @(item.PoliticaNombre ?? "No definida")
                        </td>
                        <td class="text-center">@item.DiasMaximosDevolucion
                    </td>
                    <td>
                        @if (item.Activo)
                        {
                            <span class="badge-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge-danger">Inactivo</span>
                        }
                    </td>
                    <td class="text-center">
                        <a href="@Url.Action("Detalle", new { id = item.ProveedorId })" class="btn-ver" title="Ver detalles">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Editar", new { id = item.ProveedorId })" class="btn-editar" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                        @if (item.Activo)
                        {
                            <button type="button" class="btn-inactivar" data-id="@item.ProveedorId" data-nombre="@item.RazonSocial" title="Inactivar">
                                <i class="fas fa-ban"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer-custom">
                    <a href="@Url.Action("Dashboard", "Home")" class="btn-regresar">
                        <i class="fas fa-arrow-left"></i> Regresar al Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tblProveedores').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json',
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    infoEmpty: "Mostrando 0 registros",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                order: [[1, 'asc']],
                pageLength: 10,
                responsive: true
            });

            $('.btn-inactivar').click(function() {
                var id = $(this).data('id');
                var nombre = $(this).data('nombre');

                Swal.fire({
                    title: '¿Inactivar proveedor?',
                    text: `¿Está seguro de inactivar "${nombre}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, inactivar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Inactivar", "Proveedor")', { id: id }, function(response) {
                            if (response.success) {
                                Swal.fire('Inactivado', response.message, 'success').then(function() {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}

<style>
    .alert-success {
        background: #d4edda;
        color: #155724;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }

    .btn-ver {
        background: #3498DB;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        display: inline-block;
        margin: 0 2px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-ver:hover {
            background: #2980B9;
            color: white;
            transform: scale(1.05);
        }

    .btn-editar {
        background: #F39C12;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        display: inline-block;
        margin: 0 2px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-editar:hover {
            background: #D68910;
            color: white;
            transform: scale(1.05);
        }

    .btn-inactivar {
        background: #E74C3C;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        margin: 0 2px;
        transition: all 0.3s ease;
    }

        .btn-inactivar:hover {
            background: #C0392B;
            transform: scale(1.05);
        }

    .btn-regresar {
        background: #6c757d;
        color: white;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

        .btn-regresar:hover {
            background: #5a6268;
            color: white;
            transform: translateY(-2px);
        }

    .badge-success {
        background: #27AE60;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.7rem;
        display: inline-block;
    }

    .badge-danger {
        background: #E74C3C;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.7rem;
        display: inline-block;
    }

    .card-footer-custom {
        padding: 15px 20px;
        border-top: 1px solid #eee;
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom th, .table-custom td {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

        .table-custom th {
            background: #8B4513;
            color: white;
        }
</style>
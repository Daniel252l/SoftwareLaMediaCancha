@model LaMediaCancha.Models.Proveedor

@{
    ViewBag.Title = "Detalle Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">

                <!-- HEADER -->
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-info-circle"></i> Detalle Proveedor
                            </h2>
                            <p class="mb-0 text-white-50">
                                Información completa del proveedor
                            </p>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Editar", new { id = Model.ProveedorId })"
                               class="btn btn-light">
                                <i class="fas fa-edit"></i> Editar
                            </a>

                            <a href="@Url.Action("Index")"
                               class="btn btn-outline-light">
                                <i class="fas fa-arrow-left"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <!-- BODY -->
                <div class="card-body-custom p-4">

                    <div class="row g-4">

                        <!-- INFORMACIÓN -->
                        <div class="col-lg-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header section-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-building"></i>
                                        Información del Proveedor
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm align-middle mb-0">
                                        <tr>
                                            <th style="width:35%">NIT:</th>
                                            <td><strong>@Model.Nit</strong></td>
                                        </tr>

                                        <tr>
                                            <th>Razón Social:</th>
                                            <td><strong>@Model.RazonSocial</strong></td>
                                        </tr>

                                        <tr>
                                            <th>Contacto:</th>
                                            <td>
                                                @(string.IsNullOrEmpty(Model.Contacto)
                                                    ? "—"
                                                    : Model.Contacto)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Teléfono:</th>
                                            <td>
                                                @(string.IsNullOrEmpty(Model.Telefono)
                                                    ? "—"
                                                    : Model.Telefono)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Correo:</th>
                                            <td>
                                                @(string.IsNullOrEmpty(Model.Correo)
                                                    ? "—"
                                                    : Model.Correo)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Dirección:</th>
                                            <td>
                                                @(string.IsNullOrEmpty(Model.Direccion)
                                                    ? "—"
                                                    : Model.Direccion)
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- POLÍTICAS -->
                        <div class="col-lg-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header section-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-handshake"></i>
                                        Políticas de Devolución
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm align-middle mb-0">

                                        <tr>
                                            <th style="width:35%">Política:</th>
                                            <td>
                                                @(string.IsNullOrEmpty(Model.PoliticaNombre)
                                                    ? "—"
                                                    : Model.PoliticaNombre)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Días Máximos:</th>
                                            <td>
                                                @if (Model.DiasMaximosDevolucion > 0)
                                                {
                                                    <span class="badge-custom">
                                                        @Model.DiasMaximosDevolucion días
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Política Personalizada:</th>
                                            <td>
                                                @if (!string.IsNullOrEmpty(Model.PoliticaDevolucion))
                                                {
                                                    <div class="policy-box">
                                                        @Model.PoliticaDevolucion
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                        </tr>

                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- PERSONA -->
                        <div class="col-lg-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header section-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-user"></i>
                                        Persona de Contacto
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm align-middle mb-0">
                                        <tr>
                                            <th style="width:35%">Nombre:</th>
                                            <td>
                                                <strong>@Model.NombreCompleto</strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- ESTADO -->
                        <div class="col-lg-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header section-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-check-circle"></i>
                                        Estado del Proveedor
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm align-middle mb-0">
                                        <tr>
                                            <th style="width:35%">Estado:</th>
                                            <td>
                                                @if (Model.Activo)
                                                {
                                                    <span class="badge bg-success">
                                                        Activo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Inactivo
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .card-custom {
        width: 100%;
        max-width: 100%;
        border-radius: 20px;
        overflow: hidden;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        width: 100%;
    }

    .card-header-custom {
        padding: 1.8rem 2rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%);
    }

        .card-header-custom h2 {
            font-weight: 700;
        }

    .card-body-custom {
        background: #fff;
    }

    /* HEADERS INTERNOS */
    .section-header {
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
        color: white !important;
        border: none;
    }

        .section-header h5 {
            color: white;
            font-weight: 600;
        }

    /* TABLAS */
    .table th {
        color: #5D2E0C;
        font-weight: 700;
        background: #faf7f2;
    }

    .table td {
        color: #2c3e50;
    }

    /* BADGE DÍAS */
    .badge-custom {
        background: linear-gradient(135deg, #c95a00, #a04700);
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    /* POLICY BOX */
    .policy-box {
        background: #f8f9fa;
        border-left: 4px solid #c95a00;
        padding: 10px 14px;
        border-radius: 8px;
    }

    /* BOTONES */
    .btn-light {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 8px 18px;
        transition: all 0.3s ease;
    }

        .btn-light:hover {
            background: rgba(255,255,255,0.3);
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-light {
        border-radius: 10px;
        padding: 8px 18px;
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            transform: translateY(-2px);
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {

        .card-header-custom {
            padding: 1.2rem;
        }

            .card-header-custom h2 {
                font-size: 1.4rem;
            }

        .table th,
        .table td {
            font-size: 0.85rem;
        }
    }
</style>
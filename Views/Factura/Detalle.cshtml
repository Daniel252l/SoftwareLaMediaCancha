@model LaMediaCancha.Models.ViewModels.FacturaViewModel
@{
    ViewBag.Title = "Detalle de Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom" style="max-width: 100%; width: 100%;">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-file-invoice"></i> Factura @Model.NumeroFactura</h2>
                            <p>Detalle completo de la factura</p>
                        </div>
                        <div>
                            <a href="@Url.Action("Imprimir", new { id = Model.FacturaId })" class="btn-custom" style="background: #27AE60; width: auto; padding: 8px 15px;" target="_blank">
                                <i class="fas fa-print"></i> Imprimir
                            </a>
                            <a href="@Url.Action("Index")" class="btn-custom" style="background: #6c757d; width: auto; padding: 8px 15px;">
                                <i class="fas fa-arrow-left"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body-custom">

                    @if (Model.Estado == "Anulada")
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>FACTURA ANULADA</strong> - Esta factura fue anulada el @Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm")
                            <br />
                            <strong>Anulado por:</strong> @Model.UsuarioAnulacion
                            <br />
                            <strong>Motivo:</strong> @Model.MotivoAnulacion
                            @if (!string.IsNullOrEmpty(Model.NumeroNotaCredito))
                            {
                                <br />
                                <strong>Nota de Crédito:</strong> @Model.NumeroNotaCredito
                            }
                        </div>
                    }

                    <!-- Información de la factura -->
                    <div class="info-factura">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-group">
                                    <label>NÚMERO FACTURA</label>
                                    <p><strong>@Model.NumeroFactura</strong></p>
                                </div>
                                <div class="info-group">
                                    <label>FECHA EMISIÓN</label>
                                    <p>@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                                <div class="info-group">
                                    <label>ESTADO</label>
                                    <p>
                                        @if (Model.Estado == "Vigente")
                                        {
                                            <span class="badge-success">Vigente</span>
                                        }
                                        else
                                        {
                                            <span class="badge-danger">Anulada</span>
                                        }
                                    </p>
                                </div>
                                @if (Model.Estado == "Anulada")
                                {
                                    <div class="info-group">
                                        <label>ANULADO POR</label>
                                        <p><strong>@Model.UsuarioAnulacion</strong></p>
                                    </div>
                                    <div class="info-group">
                                        <label>MOTIVO ANULACIÓN</label>
                                        <p>@Model.MotivoAnulacion</p>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <div class="info-group">
                                    <label>CLIENTE</label>
                                    <p><strong>@Model.ClienteNombre</strong></p>
                                </div>
                                <div class="info-group">
                                    <label>DOCUMENTO</label>
                                    <p>@(Model.ClienteDocumento ?? "—")</p>
                                </div>
                                <div class="info-group">
                                    <label>TELÉFONO</label>
                                    <p>@(Model.ClienteTelefono ?? "—")</p>
                                </div>
                                <div class="info-group">
                                    <label>TIPO PAGO</label>
                                    <p>@Model.TipoPago</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Tabla de productos -->
                    <h4>Productos</h4>
                    <div class="table-responsive">
                        <table class="table-custom" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 10%;">Código</th>
                                    <th style="width: 40%;">Producto</th>
                                    <th style="width: 10%;" class="text-center">Cantidad</th>
                                    <th style="width: 15%;" class="text-right">Precio Unitario</th>
                                    <th style="width: 10%;" class="text-right">Descuento</th>
                                    <th style="width: 15%;" class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Detalles)
                                {
                                    <tr>
                                        <td>@item.ProductoCodigo</td>
                                        <td>@item.ProductoNombre</td>
                                        <td class="text-center">@item.Cantidad</td>
                                        <td class="text-right">@item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-right">@item.Descuento.ToString("N2")</td>
                                        <td class="text-right">@item.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-right"><strong>Subtotal:</strong></td>
                                    <td class="text-right">@Model.Subtotal.ToString("N2")</td>
                                </tr>
                                @if (Model.Descuento > 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-right"><strong>Descuento:</strong></td>
                                        <td class="text-right">@Model.Descuento.ToString("N2")</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="5" class="text-right"><strong>Impuesto (12%):</strong></td>
                                    <td class="text-right">@Model.Impuesto.ToString("N2")</td>
                                </tr>
                                <tr style="background: #f8f9fa; font-weight: bold;">
                                    <td colspan="5" class="text-right"><strong>TOTAL:</strong></td>
                                    <td class="text-right" style="color: #D35400; font-size: 1.2rem;">@Model.Total.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <div class="observaciones">
                            <label>Observaciones</label>
                            <p>@Model.Observaciones</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-factura {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .info-group {
        margin-bottom: 15px;
    }

        .info-group label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #7F8C8D;
            display: block;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        .info-group p {
            margin: 0;
            font-size: 1rem;
        }

    .badge-success {
        background: #27AE60;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-block;
        font-size: 0.75rem;
    }

    .badge-danger {
        background: #E74C3C;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-block;
        font-size: 0.75rem;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom th, .table-custom td {
            padding: 12px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .table-custom th {
            background: #8B4513;
            color: white;
            font-weight: 600;
        }

    .text-right {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    .observaciones {
        margin-top: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
    }

        .observaciones label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #7F8C8D;
            display: block;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        .observaciones p {
            margin: 0;
        }

    hr {
        margin: 20px 0;
        border: none;
        border-top: 1px solid #eee;
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>
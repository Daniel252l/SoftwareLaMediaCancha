@model LaMediaCancha.Models.ViewModels.BuscarFacturaViewModel

@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-file-invoice me-2"></i> Facturas
                            </h2>
                            <p class="mb-0 text-white-50">Búsqueda y gestión de facturas emitidas</p>
                        </div>
                        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom p-3">

                    <!-- TABS -->
                    <div class="tabs-container">
                        <button class="tab-btn active" id="tabVentas" onclick="cambiarTab('ventas')">
                            <i class="fas fa-cash-register"></i> Facturas de Ventas
                        </button>
                        <button class="tab-btn" id="tabCompras" onclick="cambiarTab('compras')">
                            <i class="fas fa-shopping-cart"></i> Facturas de Compras
                        </button>
                    </div>

                    <!-- Filtros de búsqueda -->
                    <div class="filtros-busqueda">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="form-label fw-bold"><i class="fas fa-hashtag"></i> Número Factura</label>
                                    <input type="text" id="txtNumeroFactura" class="form-control" placeholder="Ej: VEN-20260509..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="form-label fw-bold" id="lblDocumento"><i class="fas fa-id-card"></i> Documento</label>
                                    <input type="text" id="txtNumeroDocumento" class="form-control" placeholder="Cédula/NIT" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label fw-bold"><i class="fas fa-calendar-alt"></i> Fecha Inicio</label>
                                    <input type="date" id="txtFechaInicio" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label fw-bold"><i class="fas fa-calendar-alt"></i> Fecha Fin</label>
                                    <input type="date" id="txtFechaFin" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label fw-bold"><i class="fas fa-filter"></i> Estado</label>
                                    <select id="cmbEstado" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="Completada">Completada</option>
                                        <option value="Anulada">Anulada</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12 text-end">
                                <button type="button" id="btnBuscar" class="btn btn-success px-4">
                                    <i class="fas fa-search me-1"></i> Buscar
                                </button>
                                <button type="button" id="btnLimpiar" class="btn btn-secondary px-4 ms-2">
                                    <i class="fas fa-eraser me-1"></i> Limpiar
                                </button>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Indicador de tab activo -->
                    <div id="indicadorTab" class="indicador-tab indicador-ventas">
                        <i class="fas fa-cash-register"></i>
                        <span id="textoIndicador">Mostrando: Facturas de Ventas</span>
                    </div>

                    <!-- Tabla Ventas -->
                    <div id="tablaVentas">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Factura</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th>Documento</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Nota Crédito</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyVentas">
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                            Use los filtros para buscar facturas de ventas
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tabla Compras -->
                    <div id="tablaCompras" style="display: none;">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Factura</th>
                                        <th>Fecha</th>
                                        <th>Proveedor</th>
                                        <th>Documento</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Nota Crédito</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyCompras">
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                            Use los filtros para buscar facturas de compras
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Anular Factura -->
<div id="modalAnularFactura" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 15px; width: 500px; max-width: 90%; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="background: #dc3545; color: white; padding: 20px; text-align: center;">
            <i class="fas fa-exclamation-triangle" style="font-size: 2rem; margin-bottom: 10px;"></i>
            <h3 style="margin: 0;">Anular Factura</h3>
            <p style="margin: 5px 0 0; opacity: 0.9;">Esta acción no se puede deshacer</p>
        </div>
        <div style="padding: 25px;">
            <input type="hidden" id="anularFacturaId" />
            <div style="text-align: center; margin-bottom: 20px;">
                <i class="fas fa-file-invoice" style="font-size: 3rem; color: #dc3545;"></i>
                <p style="font-size: 1rem; margin-top: 10px;">¿Está seguro que desea anular la factura?</p>
                <p><strong id="anularNumeroFactura" style="font-size: 1.1rem; color: #dc3545;"></strong></p>
                <p id="mensajeAnulacion" style="color: #555;">Esta acción generará una <strong>Nota de Crédito</strong> y no se puede deshacer.</p>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Motivo de anulación <span class="text-danger">*</span></label>
                <select id="cmbMotivoAnulacion" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="Error en el monto">Error en el monto</option>
                    <option value="Error en el cliente">Error en el cliente</option>
                    <option value="Producto defectuoso">Producto defectuoso</option>
                    <option value="Devolución de producto">Devolución de producto</option>
                    <option value="Error en la facturación">Error en la facturación</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cancelarAnularBtn" class="btn btn-secondary">Cancelar</button>
            <button type="button" id="btnConfirmarAnular" class="btn btn-danger ms-2">Anular Factura</button>
        </div>
    </div>
</div>

<!-- Modal Nota de Crédito -->
<div id="modalNotaCredito" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 15px; width: 750px; max-width: 95%; max-height: 90%; overflow: auto; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="padding: 25px;" id="notaCreditoBody"></div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cerrarNotaFooterBtn" class="btn btn-secondary">Cerrar</button>
            <button type="button" id="btnImprimirNota" class="btn btn-primary ms-2">Imprimir</button>
        </div>
    </div>
</div>

<!-- Modal Registrar Nota de Crédito del Proveedor -->
<div id="modalNCProveedor" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 15px; width: 600px; max-width: 95%; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #c95a00, #a04700); color: white; padding: 20px; text-align: center;">
            <i class="fas fa-file-invoice" style="font-size: 2rem; margin-bottom: 10px;"></i>
            <h3 style="margin: 0;">Registrar Nota de Crédito del Proveedor</h3>
            <p style="margin: 5px 0 0; opacity: 0.9; font-size: 0.85rem;">El stock será restado automáticamente</p>
        </div>
        <div style="padding: 25px;">
            <input type="hidden" id="ncProveedorCompraId" />
            <div class="alert alert-warning py-2 mb-3">
                <i class="fas fa-info-circle"></i>
                <strong>Factura:</strong> <span id="ncProveedorNumeroFactura"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Número de NC del Proveedor <span class="text-danger">*</span></label>
                <input type="text" id="ncNumeroNC" class="form-control" placeholder="Ej: NC-PROV-001" />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Fecha de Emisión <span class="text-danger">*</span></label>
                    <input type="date" id="ncFechaEmision" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Monto Total <span class="text-danger">*</span></label>
                    <input type="number" id="ncMontoTotal" class="form-control" step="0.01" min="0" placeholder="0.00" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Motivo <span class="text-danger">*</span></label>
                <select id="ncMotivo" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="Producto defectuoso">Producto defectuoso</option>
                    <option value="Devolución por vencimiento">Devolución por vencimiento</option>
                    <option value="Error en facturación">Error en facturación</option>
                    <option value="Descuento posterior">Descuento posterior</option>
                    <option value="Producto no conforme">Producto no conforme</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Documento NC (PDF/imagen) — Opcional</label>
                <input type="file" id="ncArchivo" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                <small class="text-muted">Formatos permitidos: PDF, JPG, PNG (máx 5MB)</small>
            </div>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cancelarNCBtn" class="btn btn-secondary">Cancelar</button>
            <button type="button" id="guardarNCBtn" class="btn btn-primary">Registrar NC</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var tabActivo = 'ventas';

        function cambiarTab(tab) {
            tabActivo = tab;
            $('#tabVentas, #tabCompras').removeClass('active');
            $('#' + tab + 'Tab').addClass('active');
            $('#tablaVentas').toggle(tab === 'ventas');
            $('#tablaCompras').toggle(tab === 'compras');

            if (tab === 'ventas') {
                $('#indicadorTab').removeClass('indicador-compras').addClass('indicador-ventas');
                $('#indicadorTab i').attr('class', 'fas fa-cash-register');
                $('#textoIndicador').text('Mostrando: Facturas de Ventas');
                $('#lblDocumento').html('<i class="fas fa-id-card"></i> Documento Cliente');
                $('#txtNumeroDocumento').attr('placeholder', 'Cédula/NIT');
            } else {
                $('#indicadorTab').removeClass('indicador-ventas').addClass('indicador-compras');
                $('#indicadorTab i').attr('class', 'fas fa-shopping-cart');
                $('#textoIndicador').text('Mostrando: Facturas de Compras');
                $('#lblDocumento').html('<i class="fas fa-id-card"></i> Documento Proveedor');
                $('#txtNumeroDocumento').attr('placeholder', 'NIT Proveedor');
            }
            limpiarFiltros();
        }

        function limpiarFiltros() {
            $('#txtNumeroFactura, #txtNumeroDocumento').val('');
            $('#txtFechaInicio, #txtFechaFin').val('');
            $('#cmbEstado').val('');
        }

        function buscarFacturas() {
            var filtro = {
                NumeroFactura: $('#txtNumeroFactura').val(),
                NumeroDocumento: $('#txtNumeroDocumento').val(),
                FechaInicio: $('#txtFechaInicio').val(),
                FechaFin: $('#txtFechaFin').val(),
                Estado: $('#cmbEstado').val()
            };

            var tbody = tabActivo === 'ventas' ? '#tbodyVentas' : '#tbodyCompras';
            $(tbody).html('<tr><td colspan="8" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i><br><small class="text-muted mt-2 d-block">Cargando...</small></td></tr>');

            var url = tabActivo === 'ventas'
                ? '@Url.Action("BuscarVentas", "Factura")'
                : '@Url.Action("Buscar", "Factura")';

            $.ajax({
                url: url,
                type: 'POST',
                data: filtro,
                success: function (data) {
                    $(tbody).html(data);
                },
                error: function () {
                    $(tbody).html('<tr><td colspan="8" class="text-center text-danger py-4"><i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>Error al cargar las facturas</td></tr>');
                }
            });
        }

        function anularFacturaVenta(facturaId, numeroFactura) {
            $('#anularFacturaId').val(facturaId);
            $('#anularNumeroFactura').text(numeroFactura);
            $('#cmbMotivoAnulacion').val('');
            $('#modalAnularFactura').css('display', 'flex');
        }

        function cerrarModalAnular() { $('#modalAnularFactura').hide(); }
        function cerrarModalNota() { $('#modalNotaCredito').hide(); }
        function cerrarModalNCProveedor() { $('#modalNCProveedor').hide(); }

        function abrirModalNCProveedor(facturaId, numeroFactura) {
            $('#ncProveedorCompraId').val(facturaId);
            $('#ncProveedorNumeroFactura').text(numeroFactura);
            $('#ncNumeroNC').val('');
            $('#ncFechaEmision').val(new Date().toISOString().split('T')[0]);
            $('#ncMontoTotal').val('');
            $('#ncMotivo').val('');
            $('#ncArchivo').val('');
            $('#modalNCProveedor').css('display', 'flex');
        }

        $(document).ready(function () {
            $('#btnBuscar').click(buscarFacturas);
            $('#btnLimpiar').click(function () {
                limpiarFiltros();
                buscarFacturas();
            });

            $('#cancelarAnularBtn, #cancelarNCBtn, #cerrarNotaFooterBtn').click(function () {
                cerrarModalAnular();
                cerrarModalNota();
                cerrarModalNCProveedor();
            });

            $('#modalAnularFactura, #modalNotaCredito, #modalNCProveedor').click(function (e) {
                if (e.target === this) $(this).hide();
            });

            $('#btnConfirmarAnular').click(function () {
                var facturaId = $('#anularFacturaId').val();
                var motivo = $('#cmbMotivoAnulacion').val();

                if (!motivo) {
                    Swal.fire('Atención', 'Seleccione un motivo de anulación', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Procesando...',
                    text: 'Anulando factura',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: '@Url.Action("AnularVenta", "Factura")',
                    type: 'POST',
                    data: { facturaId: facturaId, motivoAnulacion: motivo },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Éxito', response.message, 'success').then(function () {
                                cerrarModalAnular();
                                buscarFacturas();
                            });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Error al anular la factura', 'error');
                    }
                });
            });

            $('#guardarNCBtn').click(function () {
                var facturaId = $('#ncProveedorCompraId').val();
                var numeroNC = $.trim($('#ncNumeroNC').val());
                var fecha = $('#ncFechaEmision').val();
                var monto = $('#ncMontoTotal').val();
                var motivo = $('#ncMotivo').val();

                if (!facturaId) { Swal.fire('Atención', 'Error: FacturaId no encontrado', 'warning'); return; }
                if (!numeroNC) { Swal.fire('Atención', 'Ingrese el número de NC', 'warning'); return; }
                if (!fecha) { Swal.fire('Atención', 'Seleccione la fecha', 'warning'); return; }
                if (!monto || parseFloat(monto) <= 0) { Swal.fire('Atención', 'Ingrese un monto válido', 'warning'); return; }
                if (!motivo) { Swal.fire('Atención', 'Seleccione un motivo', 'warning'); return; }

                $('#modalNCProveedor').hide();

                Swal.fire({
                    title: 'Confirmar registro',
                    html: '<strong>NC:</strong> ' + numeroNC + '<br><strong>Monto:</strong> Q ' + parseFloat(monto).toFixed(2),
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, registrar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (!result.isConfirmed) {
                        $('#modalNCProveedor').css('display', 'flex');
                        return;
                    }

                    Swal.fire({ title: 'Registrando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                    var formData = new FormData();
                    formData.append('CompraId', facturaId);
                    formData.append('NumeroNCProveedor', numeroNC);
                    formData.append('FechaEmision', fecha);
                    formData.append('MontoTotal', monto);
                    formData.append('Motivo', motivo);

                    var archivo = document.getElementById('ncArchivo');
                    if (archivo && archivo.files.length > 0) formData.append('archivo', archivo.files[0]);

                    $.ajax({
                        url: '@Url.Action("RegistrarNCProveedor", "Factura")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Éxito', response.message, 'success').then(function () { buscarFacturas(); });
                            } else {
                                Swal.fire('Error', response.message, 'error').then(function () { $('#modalNCProveedor').css('display', 'flex'); });
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Error al registrar la NC', 'error').then(function () { $('#modalNCProveedor').css('display', 'flex'); });
                        }
                    });
                });
            });

            $('#txtNumeroFactura, #txtNumeroDocumento').keypress(function (e) {
                if (e.which === 13) buscarFacturas();
            });
        });
    </script>
}

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

    .tabs-container {
        display: flex;
        gap: 5px;
        margin-bottom: 20px;
        border-bottom: 2px solid #e9ecef;
    }

    .tab-btn {
        background: #f8f9fa;
        border: none;
        padding: 10px 25px;
        border-radius: 10px 10px 0 0;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
    }

        .tab-btn.active {
            background: white;
            color: #c95a00;
            border-bottom: 2px solid #c95a00;
        }

    .filtros-busqueda {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .indicador-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .indicador-ventas {
        background: #e8f5e9;
        color: #27AE60;
        border: 1px solid #a5d6a7;
    }

    .indicador-compras {
        background: #fff3e0;
        color: #E67E22;
        border: 1px solid #ffcc80;
    }

    /* =========================
       TABLA
    ========================= */

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        table-layout: fixed;
    }

    .table-dark th {
        background-color: #2c3e30;
        color: white;
        font-weight: 600;
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 10px;
        vertical-align: middle;
    }

    .table td {
        vertical-align: middle;
        padding: 12px 10px;
        font-size: 0.82rem;
        word-wrap: break-word;
    }

        /* =========================
       ANCHOS COLUMNAS
    ========================= */

        .table th:nth-child(1),
        .table td:nth-child(1) {
            width: 120px;
        }

        .table th:nth-child(2),
        .table td:nth-child(2) {
            width: 190px;
        }

        .table th:nth-child(3),
        .table td:nth-child(3) {
            width: 230px;
        }

        .table th:nth-child(4),
        .table td:nth-child(4) {
            width: 140px;
        }

        .table th:nth-child(5),
        .table td:nth-child(5) {
            width: 100px;
        }

        .table th:nth-child(6),
        .table td:nth-child(6) {
            width: 120px;
            text-align: center;
        }

        .table th:nth-child(7),
        .table td:nth-child(7) {
            width: 170px;
            text-align: center;
        }

        .table th:nth-child(8),
        .table td:nth-child(8) {
            width: 260px;
            text-align: center;
        }

    /* =========================
       BOTONES ACCIONES
    ========================= */


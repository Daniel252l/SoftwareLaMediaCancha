@model LaMediaCancha.Models.ViewModels.BuscarFacturaViewModel
@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-file-invoice"></i> Facturas</h2>
                            <p>Búsqueda y gestión de facturas emitidas</p>
                        </div>
                        <a href="@Url.Action("Dashboard", "Home")" class="btn-custom" style="width: auto; padding: 10px 20px; background: #6c757d;">
                            <i class="fas fa-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body-custom">

                    <!-- TABS -->
                    <div class="tabs-container">
                        <button class="tab-btn active" id="tabVentas" onclick="cambiarTab('ventas')">
                            <i class="fas fa-cash-register"></i> Facturas de Ventas
                        </button>
                        <button class="tab-btn" id="tabCompras" onclick="cambiarTab('compras')">
                            <i class="fas fa-shopping-cart"></i> Facturas de Compras
                        </button>
                    </div>

                    <!-- Filtros de búsqueda -->
                    <div class="filtros-busqueda">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label><i class="fas fa-hashtag"></i> Número Factura</label>
                                    <input type="text" id="txtNumeroFactura" class="form-control" placeholder="Ej: FAC-001" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label id="lblDocumento"><i class="fas fa-id-card"></i> Documento</label>
                                    <input type="text" id="txtNumeroDocumento" class="form-control" placeholder="Cédula/NIT" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label><i class="fas fa-calendar-alt"></i> Fecha Inicio</label>
                                    <input type="date" id="txtFechaInicio" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label><i class="fas fa-calendar-alt"></i> Fecha Fin</label>
                                    <input type="date" id="txtFechaFin" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label><i class="fas fa-filter"></i> Estado</label>
                                    <select id="cmbEstado" class="form-control">
                                        <option value="">Todos</option>
                                        <option value="Vigente">Vigente</option>
                                        <option value="Anulada">Anulada</option>
                                        <option value="Completada">Completada</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 text-right">
                                <button type="button" id="btnBuscar" class="btn-buscar">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button type="button" id="btnLimpiar" class="btn-limpiar">
                                    <i class="fas fa-eraser"></i> Limpiar
                                </button>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Indicador de tab activo -->
                    <div id="indicadorTab" class="indicador-tab indicador-ventas">
                        <i class="fas fa-cash-register"></i>
                        <span id="textoIndicador">Mostrando: Facturas de Ventas</span>
                    </div>

                    <!-- Tabla Ventas -->
                    <div id="tablaVentas">
                        <div class="table-responsive">
                            <table class="table-custom">
                                <thead>
                                    <tr>
                                        <th>Factura</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th>Documento</th>
                                        <th class="text-right">Total</th>
                                        <th>Estado</th>
                                        <th class="text-center">Nota Crédito</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyVentas">
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <i class="fas fa-info-circle"></i> Use los filtros para buscar facturas de ventas
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tabla Compras -->
                    <div id="tablaCompras" style="display:none;">
                        <div class="table-responsive">
                            <table class="table-custom">
                                <thead>
                                    <tr>
                                        <th>Factura</th>
                                        <th>Fecha</th>
                                        <th>Proveedor</th>
                                        <th>Documento</th>
                                        <th class="text-right">Total</th>
                                        <th>Estado</th>
                                        <th class="text-center">Nota Crédito</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyCompras">
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <i class="fas fa-info-circle"></i> Use los filtros para buscar facturas de compras
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Anular Factura (Ventas y Compras) -->
<div id="modalAnularFactura" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 15px; width: 500px; max-width: 90%; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="background: #E74C3C; color: white; padding: 20px; text-align: center;">
            <i class="fas fa-exclamation-triangle" style="font-size: 2rem; margin-bottom: 10px;"></i>
            <h3 style="margin: 0;">Anular Factura</h3>
            <p style="margin: 5px 0 0; opacity: 0.9;">Esta acción no se puede deshacer</p>
        </div>
        <div style="padding: 25px;">
            <input type="hidden" id="anularFacturaId" />
            <input type="hidden" id="anularTipoFactura" />
            <div style="text-align: center; margin-bottom: 20px;">
                <i class="fas fa-file-invoice" style="font-size: 3rem; color: #E74C3C;"></i>
                <p style="font-size: 1.1rem; margin-top: 10px;">¿Está seguro que desea anular la factura?</p>
                <p><strong id="anularNumeroFactura" style="font-size: 1.2rem; color: #E74C3C;"></strong></p>
                <p id="mensajeAnulacion" style="color: #555;">Esta acción generará una <strong>Nota de Crédito</strong> y no se puede deshacer.</p>
            </div>
            <div class="form-group">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Motivo de anulación <span style="color: red;">*</span></label>
                <select id="cmbMotivoAnulacion" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                    <option value="">Seleccione...</option>
                    <option value="Error en el monto">Error en el monto</option>
                    <option value="Error en el cliente">Error en el cliente</option>
                    <option value="Producto defectuoso">Producto defectuoso</option>
                    <option value="Devolución de producto">Devolución de producto</option>
                    <option value="Error en la facturación">Error en la facturación</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cancelarAnularBtn" style="background: #6c757d; color: white; border: none; padding: 10px 25px; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                <i class="fas fa-times"></i> Cancelar
            </button>
            <button type="button" id="btnConfirmarAnular" style="background: #E74C3C; color: white; border: none; padding: 10px 25px; border-radius: 5px; cursor: pointer;">
                <i class="fas fa-ban"></i> Anular Factura
            </button>
        </div>
    </div>
</div>

<!-- Modal Nota de Crédito (Ventas) -->
<div id="modalNotaCredito" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 5px; width: 750px; max-width: 95%; overflow: auto; max-height: 90%; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="padding: 25px;" id="notaCreditoBody"></div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cerrarNotaFooterBtn" style="background: #6c757d; color: white; border: none; padding: 10px 25px; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                <i class="fas fa-times"></i> Cerrar
            </button>
            <button type="button" id="btnImprimirNota" style="background: #27AE60; color: white; border: none; padding: 10px 25px; border-radius: 5px; cursor: pointer;">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
    </div>
</div>

<!-- Modal Registrar Nota de Crédito del Proveedor (Compras) -->
<div id="modalNCProveedor" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 15px; width: 600px; max-width: 95%; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #8B4513, #D35400); color: white; padding: 20px; text-align: center;">
            <i class="fas fa-file-invoice" style="font-size: 2rem; margin-bottom: 10px;"></i>
            <h3 style="margin: 0;">Registrar Nota de Crédito del Proveedor</h3>
            <p style="margin: 5px 0 0; opacity: 0.9; font-size: 0.85rem;">El stock será restado automáticamente</p>
        </div>
        <div style="padding: 25px;">
            <input type="hidden" id="ncProveedorCompraId" />
            <div style="background: #fff3e0; border: 1px solid #ffcc80; border-radius: 8px; padding: 12px; margin-bottom: 20px; font-size: 0.85rem; color: #E67E22;">
                <i class="fas fa-info-circle"></i>
                <strong>Compra:</strong> <span id="ncProveedorNumeroFactura"></span>
            </div>

            <div class="form-group">
                <label>Número de NC del Proveedor <span style="color: red;">*</span></label>
                <input type="text" id="ncNumeroNC" class="form-control" placeholder="Ej: NC-PROV-001" />
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Fecha de Emisión <span style="color: red;">*</span></label>
                        <input type="date" id="ncFechaEmision" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Monto Total <span style="color: red;">*</span></label>
                        <input type="number" id="ncMontoTotal" class="form-control" step="0.01" min="0" placeholder="0.00" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Motivo <span style="color: red;">*</span></label>
                <select id="ncMotivo" class="form-control">
                    <option value="">Seleccione...</option>
                    <option value="Producto defectuoso">Producto defectuoso</option>
                    <option value="Devolución por vencimiento">Devolución por vencimiento</option>
                    <option value="Error en facturación">Error en facturación</option>
                    <option value="Descuento posterior">Descuento posterior</option>
                    <option value="Producto no conforme">Producto no conforme</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>

            <div class="form-group">
                <label>Documento NC (PDF/imagen) — Opcional</label>
                <input type="file" id="ncArchivo" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                <small class="text-muted">Formatos permitidos: PDF, JPG, PNG (máx 5MB)</small>
            </div>
        </div>
        <div style="padding: 15px 20px; border-top: 1px solid #eee; text-align: right; background: #f8f9fa;">
            <button type="button" id="cancelarNCBtn" class="btn-cancelar">Cancelar</button>
            <button type="button" id="guardarNCBtn" class="btn-guardar-nc">Registrar NC</button>
        </div>
    </div>
</div>

<style>

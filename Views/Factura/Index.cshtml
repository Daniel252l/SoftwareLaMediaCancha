@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var tabActivo = 'ventas';

        function cambiarTab(tab) {
            tabActivo = tab;
            $('#tabVentas, #tabCompras').removeClass('active');
            $('#tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).addClass('active');
            $('#tablaVentas').toggle(tab === 'ventas');
            $('#tablaCompras').toggle(tab === 'compras');

            if (tab === 'ventas') {
                $('#indicadorTab').removeClass('indicador-compras').addClass('indicador-ventas');
                $('#indicadorTab i').attr('class', 'fas fa-cash-register');
                $('#textoIndicador').text('Mostrando: Facturas de Ventas');
                $('#lblDocumento').html('<i class="fas fa-id-card"></i> Documento Cliente');
                $('#txtNumeroDocumento').attr('placeholder', 'Cédula/NIT');
            } else {
                $('#indicadorTab').removeClass('indicador-ventas').addClass('indicador-compras');
                $('#indicadorTab i').attr('class', 'fas fa-shopping-cart');
                $('#textoIndicador').text('Mostrando: Facturas de Compras');
                $('#lblDocumento').html('<i class="fas fa-id-card"></i> Documento Proveedor');
                $('#txtNumeroDocumento').attr('placeholder', 'NIT Proveedor');
            }
            limpiarFiltros();
        }

        function limpiarFiltros() {
            $('#txtNumeroFactura, #txtNumeroDocumento').val('');
            $('#txtFechaInicio, #txtFechaFin').val('');
            $('#cmbEstado').val('');
        }

        function buscarFacturas() {
            var filtro = {
                NumeroFactura: $('#txtNumeroFactura').val(),
                NumeroDocumento: $('#txtNumeroDocumento').val(),
                FechaInicio: $('#txtFechaInicio').val(),
                FechaFin: $('#txtFechaFin').val(),
                Estado: $('#cmbEstado').val()
            };

            var tbody = tabActivo === 'ventas' ? '#tbodyVentas' : '#tbodyCompras';
            $(tbody).html('<tr><td colspan="8" class="text-center"><i class="fas fa-spinner fa-spin"></i> Cargando...<\/td><\/tr>');

            var url = tabActivo === 'ventas'
                ? '@Url.Action("BuscarVentas", "Factura")'
                : '@Url.Action("Buscar", "Factura")';

            $.ajax({
                url: url,
                type: 'POST',
                data: filtro,
                success: function(data) {
                    $(tbody).html(data);
                },
                error: function() {
                    $(tbody).html('<tr><td colspan="8" class="text-center text-danger">Error al cargar las facturas<\/td><\/tr>');
                }
            });
        }

        function anularFactura(facturaId, numeroFactura, tipo) {
            $('#anularFacturaId').val(facturaId);
            $('#anularNumeroFactura').text(numeroFactura);
            $('#anularTipoFactura').val(tipo);
            $('#cmbMotivoAnulacion').val('');

            if (tipo === 'venta') {
                $('#mensajeAnulacion').html('Esta acción generará una <strong>Nota de Crédito</strong> y devolverá el stock al inventario.');
            } else {
                $('#mensajeAnulacion').html('Esta acción anulará la compra y restará el stock del inventario.');
            }

            $('#modalAnularFactura').css('display', 'flex');
        }

        function cerrarModalAnular() { $('#modalAnularFactura').hide(); }

        function abrirModalNCProveedor(compraId, numeroFactura) {
            $('#ncProveedorCompraId').val(compraId);
            $('#ncProveedorNumeroFactura').text(numeroFactura);
            $('#ncNumeroNC').val('');
            $('#ncFechaEmision').val(new Date().toISOString().split('T')[0]);
            $('#ncMontoTotal').val('');
            $('#ncMotivo').val('');
            $('#ncArchivo').val('');
            $('#modalNCProveedor').css('display', 'flex');
        }

        function cerrarModalNCProveedor() { $('#modalNCProveedor').hide(); }

        function verNotaCredito(notaCreditoId) {
            $.ajax({
                url: '@Url.Action("ObtenerNotaCredito", "Factura")',
                type: 'GET',
                data: { id: notaCreditoId },
                success: function(data) {
                    if (data.success) {
                        var html = `
                            <div style="font-family: 'Times New Roman', Arial, serif;">
                                <div style="text-align:center; border-bottom:2px solid #000; padding-bottom:15px; margin-bottom:20px;">
                                    <div style="font-size:22px; font-weight:bold; letter-spacing:2px;">LA MEDIA CANCHA ASADERA</div>
                                    <div style="font-size:11px; color:#555;">Av. Principal #123, Ciudad - Tel: (555) 123-4567</div>
                                    <div style="font-size:11px; color:#555;">NIT: 123456789-0 - Régimen Común</div>
                                    <div style="font-size:11px; color:#555;">www.lamediacancha.com</div>
                                </div>
                                <div style="text-align:center; margin-bottom:25px;">
                                    <div style="font-size:18px; font-weight:bold; text-transform:uppercase; letter-spacing:3px;">Nota de Crédito</div>
                                    <div style="font-size:11px; color:#555;">Documento equivalente a factura - Anulación</div>
                                </div>
                                <div style="border:1px solid #000; padding:12px; margin-bottom:20px;">
                                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                        <tr>
                                            <td style="width:20%; padding:5px;"><strong>NÚMERO:</strong><table>
                                            <td style="width:30%; padding:5px;">${data.NumeroNotaCredito}</td>
                                            <td style="width:20%; padding:5px;"><strong>FECHA EMISIÓN:</strong></td>
                                            <td style="width:30%; padding:5px;">${data.FechaEmision}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:5px;"><strong>FACTURA ORIGINAL:</strong></td>
                                            <td style="padding:5px;">${data.FacturaOriginalNumero}</td>
                                            <td style="padding:5px;"><strong>AUTORIZACIÓN:</strong></td>
                                            <td style="padding:5px;">ANUL-${data.NumeroNotaCredito.substring(0,15)}</td
                                        </tr
                                    </table
                                </div>
                                <div style="border:1px solid #000; padding:12px; margin-bottom:20px;">
                                    <div style="font-weight:bold; font-size:12px; margin-bottom:10px; border-bottom:1px solid #000; padding-bottom:5px;">DATOS DEL CLIENTE</div>
                                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                        <tr>
                                            <td style="width:20%; padding:5px;"><strong>Cliente:</strong></td
                                            <td style="width:30%; padding:5px;">${data.ClienteNombre}</td
                                            <td style="width:20%; padding:5px;"><strong>Documento:</strong></td
                                            <td style="width:30%; padding:5px;">${data.ClienteDocumento || '—'}</td
                                        </tr
                                    </table
                                </div>
                                <div style="border:1px solid #000; padding:12px; margin-bottom:20px;">
                                    <div style="font-weight:bold; font-size:12px; margin-bottom:10px; border-bottom:1px solid #000; padding-bottom:5px;">DETALLE DE LA ANULACIÓN</div>
                                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                        <tr>
                                            <td style="width:20%; padding:5px;"><strong>Concepto:</strong></td
                                            <td style="padding:5px;">Anulación de factura por ${data.Motivo.toLowerCase()}</td
                                        </tr
                                        <tr>
                                            <td style="padding:5px;"><strong>Motivo:</strong></td
                                            <td style="padding:5px;">${data.Motivo}</td
                                        </tr
                                        <tr>
                                            <td style="padding:5px;"><strong>Anulado por:</strong></td
                                            <td style="padding:5px;">${data.UsuarioNombre}</td
                                        </tr
                                    </table
                                </div>
                                <div style="border:1px solid #000; padding:12px; margin-bottom:20px; background:#f9f9f9;">
                                    <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                        <tr>
                                            <td style="width:70%; text-align:right; padding:5px;"><strong>MONTO ACREDITABLE:</strong></td
                                            <td style="width:30%; text-align:right; padding:5px; font-weight:bold; font-size:14px;">Q ${parseFloat(data.MontoTotal).toFixed(2)}</td
                                        </tr
                                    </table
                                </div>
                                <div style="margin-top:20px; padding-top:10px; border-top:1px solid #ccc; font-size:9px; color:#555; text-align:center;">
                                    <div>Este documento es una Nota de Crédito válida para efectos fiscales según la legislación vigente.</div>
                                    <div>Documento generado electrónicamente por La Media Cancha Asadera.</div>
                                    <div style="margin-top:15px;">_________________________</div>
                                    <div>Firma y sello de la empresa</div>
                                </div>
                                <div style="margin-top:15px; font-size:8px; color:#999; text-align:center;">
                                    Estado: <span style="color:#27AE60;">${data.Estado}</span>
                                </div>
                            </div>
                        `;
                        $('#notaCreditoBody').html(html);
                        $('#modalNotaCredito').css('display', 'flex');
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Error al cargar la Nota de Crédito', 'error');
                }
            });
        }

        function cerrarModalNota() { $('#modalNotaCredito').hide(); }

        function imprimirNotaCredito() {
            var content = $('#notaCreditoBody').html();
            var w = window.open('', '_blank');
            w.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Nota de Crédito</title>
                    <meta charset="utf-8" />
                    <style>
                        * { margin: 0; padding: 0; box-sizing: border-box; }
                        body { font-family: 'Times New Roman', Arial, serif; padding: 40px; background: white; }
                        @@media print { body { padding: 20px; } }
                        .nota-container { max-width: 750px; margin: 0 auto; }
                        table { width: 100%; border-collapse: collapse; }
                        td { padding: 5px; }
                    </style>
                </head>
                <body>
                    <div class="nota-container">${content}</div>
                    <script>
                        window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 1000); }
                    <\/script>
                </body>
                </html>
            `);
            w.document.close();
        }

        $(document).ready(function() {
            $('#btnBuscar').click(buscarFacturas);

            $('#btnLimpiar').click(function() {
                limpiarFiltros();
                var tbody = tabActivo === 'ventas' ? '#tbodyVentas' : '#tbodyCompras';
                var msg = tabActivo === 'ventas'
                    ? 'Use los filtros para buscar facturas de ventas'
                    : 'Use los filtros para buscar facturas de compras';
                $(tbody).html('<tr><td colspan="8" class="text-center"><i class="fas fa-info-circle"></i> ' + msg + '</td</tr');
            });

            $('#cancelarAnularBtn').click(cerrarModalAnular);
            $('#cerrarNotaFooterBtn').click(cerrarModalNota);
            $('#cancelarNCBtn').click(cerrarModalNCProveedor);

            $('#modalAnularFactura').click(function(e) { if (e.target === this) cerrarModalAnular(); });
            $('#modalNotaCredito').click(function(e) { if (e.target === this) cerrarModalNota(); });
            $('#modalNCProveedor').click(function(e) { if (e.target === this) cerrarModalNCProveedor(); });

            $('#btnConfirmarAnular').click(function() {
                var facturaId = $('#anularFacturaId').val();
                var motivo = $('#cmbMotivoAnulacion').val();
                var tipo = $('#anularTipoFactura').val();

                if (!motivo) {
                    Swal.fire('Atención', 'Seleccione un motivo de anulación', 'warning');
                    return;
                }

                var url = tipo === 'venta'
                    ? '@Url.Action("AnularVenta", "Factura")'
                    : '@Url.Action("Anular", "Factura")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { FacturaId: facturaId, MotivoAnulacion: motivo },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Éxito', response.message, 'success').then(function() {
                                cerrarModalAnular();
                                buscarFacturas();
                            });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Error al anular la factura', 'error');
                    }
                });
            });

            $('#btnImprimirNota').click(imprimirNotaCredito);

            $('#txtNumeroFactura, #txtNumeroDocumento').keypress(function(e) {
                if (e.which === 13) buscarFacturas();
            });

            // Guardar NC del Proveedor
            $('#guardarNCBtn').click(function() {
                var compraId = $('#ncProveedorCompraId').val();
                var numeroNC = $('#ncNumeroNC').val().trim();
                var fecha = $('#ncFechaEmision').val();
                var monto = $('#ncMontoTotal').val();
                var motivo = $('#ncMotivo').val();

                if (!numeroNC || !fecha || !monto || !motivo) {
                    Swal.fire('Atención', 'Complete todos los campos obligatorios', 'warning');
                    return;
                }

                if (parseFloat(monto) <= 0) {
                    Swal.fire('Atención', 'El monto debe ser mayor a 0', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Confirmar registro',
                    html: `<strong>NC:</strong> ${numeroNC}<br><strong>Monto:</strong> Q ${parseFloat(monto).toFixed(2)}<br><br>
                           <span style="color:#E74C3C;"><i class="fas fa-exclamation-triangle"></i> El stock será restado automáticamente</span>`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, registrar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#guardarNCBtn').html('<i class="fas fa-spinner fa-spin"></i> Registrando...');
                        $('#guardarNCBtn').prop('disabled', true);

                        var formData = new FormData();
                        formData.append('CompraId', compraId);
                        formData.append('NumeroNCProveedor', numeroNC);
                        formData.append('FechaEmision', fecha);
                        formData.append('MontoTotal', monto);
                        formData.append('Motivo', motivo);

                        var archivo = document.getElementById('ncArchivo');
                        if (archivo.files.length > 0) {
                            formData.append('archivo', archivo.files[0]);
                        }

                        $.ajax({
                            url: '@Url.Action("RegistrarNCProveedor", "Factura")',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Éxito', response.message, 'success').then(function() {
                                        cerrarModalNCProveedor();
                                        buscarFacturas();
                                    });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                    $('#guardarNCBtn').html('Registrar NC');
                                    $('#guardarNCBtn').prop('disabled', false);
                                }
                            },
                            error: function() {
                                Swal.fire('Error', 'Error al registrar la NC', 'error');
                                $('#guardarNCBtn').html('Registrar NC');
                                $('#guardarNCBtn').prop('disabled', false);
                            }
                        });
                    }
                });
            });
        });
    </script>
}
@model IEnumerable<LaMediaCancha.Models.VentaModels.HistorialVenta>

@{
    ViewBag.Title = "Historial de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-history me-2"></i> Historial de Ventas
                            </h2>
                            <p class="mb-0 text-white-50">Órdenes de mesas y mostrador</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    <!-- Filtros -->
                    <div class="filtros-container">
                        <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Fecha Inicio</label>
                                <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Fecha Fin</label>
                                <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Tipo Venta</label>
                                <select name="tipoVenta" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="Mesa" @(ViewBag.TipoVentaSeleccionado == "Mesa" ? "selected" : "")>Mesa</option>
                                    <option value="Mostrador" @(ViewBag.TipoVentaSeleccionado == "Mostrador" ? "selected" : "")>Mostrador</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Estado</label>
                                <select name="estado" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="Abierta" @(ViewBag.EstadoSeleccionado == "Abierta" ? "selected" : "")>Abierta</option>
                                    <option value="Cerrada" @(ViewBag.EstadoSeleccionado == "Cerrada" ? "selected" : "")>Cerrada</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search me-1"></i> Filtrar
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive mt-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th># Orden</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Mesa</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">@item.NumeroOrden</span></td>
                                        <td>
                                            @item.ClienteNombre
                                    </td>
                                    <td>
                                        @item.FechaApertura.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @item.TipoVenta
                            </td>
                            <td>@(item.NumeroMesa.HasValue ? $"Mesa {item.NumeroMesa}" : "-")
                            </td>
                            <td class="text-end text-success fw-bold">Q @item.Total.ToString("N2")
            </td>
            <td class="text-center">
                @if (item.Estado == "Cerrada")
                {
                    <span class="badge bg-success px-3 py-2">Cerrada</span>
                }
                else
                {
                    <span class="badge bg-warning px-3 py-2">Abierta</span>
                }
            </td>
            <td class="text-center">
                <a href="@Url.Action("Detalle", new { id = item.OrdenId })" class="btn btn-info btn-sm text-white">
                    <i class="fas fa-eye me-1"></i> Ver
                </a>
            </td>
        </tr>
    }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .filtros-container {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: 30px !important;
            padding-right: 30px !important;
        }

        .card-custom {
            width: 100%;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .card-custom-full {
            width: 100% !important;
            max-width: 100% !important;
        }

        .card-header-custom {
            padding: 1.5rem 2rem;
            background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
        }

        .card-body-custom {
            padding: 20px;
        }

        .table {
            width: 100%;
            margin-bottom: 0;
        }

            .table th {
                padding: 14px 12px;
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: .5px;
                white-space: nowrap;
            }

            .table td {
                padding: 14px 12px;
                vertical-align: middle;
            }

        .btn {
            border-radius: 10px;
            transition: all .2s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .badge {
            font-size: .75rem;
            font-weight: 600;
        }
    </style>
}
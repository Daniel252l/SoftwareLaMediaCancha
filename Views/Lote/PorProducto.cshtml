@model IEnumerable<LaMediaCancha.Models.LoteViewModel>

@{
    ViewBag.Title = "Lotes del Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="lotes-wrapper">

    <div class="container-fluid lotes-container">

        <div class="row">
            <div class="col-12">

                <div class="card-custom lotes-card">

                    <!-- HEADER -->
                    <div class="card-header-custom">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                            <div>
                                <h2 class="text-white mb-1">
                                    <i class="fas fa-layer-group me-2"></i>
                                    Lotes del Producto
                                </h2>

                                <p class="mb-0 text-white-50">
                                    Orden FIFO (Primero en entrar, primero en salir)
                                </p>
                            </div>

                            <div>
                                <a href="@Url.Action("Inventario", "Producto")"
                                   class="btn btn-light">

                                    <i class="fas fa-arrow-left me-1"></i>
                                    Regresar
                                </a>
                            </div>

                        </div>

                    </div>

                    <!-- BODY -->
                    <div class="card-body-custom">

                        <!-- ALERTA -->
                        <div class="alert alert-info custom-alert">

                            <i class="fas fa-info-circle me-2"></i>

                            <strong>Orden FIFO:</strong>

                            Los lotes se venden en el orden de ingreso
                            (el más antiguo primero).

                            Actualmente hay
                            <strong>@Model.Count()</strong>
                            lotes activos.

                        </div>

                        <!-- TABLA -->
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-dark">

                                    <tr>
                                        <th class="text-center">Orden</th>
                                        <th>Lote</th>
                                        <th>Lote Proveedor</th>
                                        <th class="text-center">F. Ingreso</th>
                                        <th class="text-center">F. Vencimiento</th>
                                        <th class="text-end">Precio</th>
                                        <th class="text-center">Cantidad Inicial</th>
                                        <th class="text-center">Stock Actual</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @{ int orden = 1; }

                                    @foreach (var lote in Model.OrderBy(x => x.FechaIngreso))
                                    {
                                        string filaClase = orden == 1 ? "fila-fifo" : "";

                                        <tr class="@filaClase">

                                            <!-- ORDEN -->
                                            <td class="text-center">

                                                @if (orden == 1)
                                                {
                                                    <span class="badge badge-fifo">
                                                        #@orden
                                                    </span>

                                                    <div class="small text-muted mt-1">
                                                        Próximo a vender
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-normal">
                                                        #@orden
                                                    </span>
                                                }

                                            </td>

                                            <!-- LOTE -->
                                            <td>
                                                <span class="fw-bold">
                                                    @lote.NumeroLoteInterno
                                                </span>
                                            </td>

                                            <!-- LOTE PROVEEDOR -->
                                            <td>
                                                @(string.IsNullOrEmpty(lote.NumeroLoteProveedor)
                                                    ? "—"
                                                    : lote.NumeroLoteProveedor)
                                            </td>

                                            <!-- FECHA INGRESO -->
                                            <td class="text-center">
                                                @lote.FechaIngreso.ToString("dd/MM/yyyy")
                                            </td>

                                            <!-- FECHA VENCIMIENTO -->
                                            <td class="text-center">

                                                @if (lote.FechaVencimiento.HasValue)
                                                {
                                                    <span>
                                                        @lote.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }

                                            </td>

                                            <!-- PRECIO -->
                                            <td class="text-end text-info fw-bold">
                                                @lote.PrecioUnitario.ToString("C")
                                            </td>

                                            <!-- CANTIDAD -->
                                            <td class="text-center">
                                                @lote.CantidadInicial
                                            </td>

                                            <!-- STOCK -->
                                            <td class="text-center">
                                                <span class="stock-actual">
                                                    @lote.CantidadActual
                                                </span>
                                            </td>

                                            <!-- ESTADO -->
                                            <td class="text-center">

                                                @if (lote.Estado == "Activo")
                                                {
                                                    if (orden == 1)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            En uso (FIFO)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            Disponible
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @lote.Estado
                                                    </span>
                                                }

                                            </td>

                                            <!-- ACCIONES -->
                                            <td class="text-center">

                                                @if (lote.Estado == "Activo")
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary"
                                                            onclick="editarLote(
                                                                @lote.LoteId,
                                                                '@lote.NumeroLoteInterno',
                                                                '@(lote.NumeroLoteProveedor ?? "")',
                                                                '@(lote.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "")'
                                                            )">

                                                        <i class="fas fa-edit me-1"></i>
                                                        Editar
                                                    </button>
                                                }

                                            </td>

                                        </tr>

                                        orden++;
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>

</div>

<!-- MODAL -->
<div class="modal fade"
     id="modalEditarLote"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header modal-header-custom">

                <h5 class="modal-title text-white">
                    <i class="fas fa-edit me-2"></i>
                    Editar Lote
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="editLoteId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Número de Lote
                    </label>

                    <input type="text"
                           id="editNumeroLote"
                           class="form-control"
                           readonly
                           style="background:#f5f5f5;" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Número de Lote del Proveedor
                    </label>

                    <input type="text"
                           id="editNumeroLoteProveedor"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Fecha de Vencimiento
                    </label>

                    <input type="date"
                           id="editFechaVencimiento"
                           class="form-control" />
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar
                </button>

                <button type="button"
                        onclick="guardarLote()"
                        class="btn btn-primary">

                    Guardar
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        const modalEditarLote = new bootstrap.Modal(
            document.getElementById('modalEditarLote')
        );

        function editarLote(id, numeroLote, proveedorLote, fechaVencimiento) {

            $('#editLoteId').val(id);
            $('#editNumeroLote').val(numeroLote);
            $('#editNumeroLoteProveedor').val(proveedorLote);
            $('#editFechaVencimiento').val(fechaVencimiento);

            modalEditarLote.show();
        }

        function guardarLote() {

            var loteId = $('#editLoteId').val();

            var fechaVencimiento =
                $('#editFechaVencimiento').val();

            var numeroLoteProveedor =
                $('#editNumeroLoteProveedor').val();

            if (!fechaVencimiento) {

                Swal.fire(
                    'Atención',
                    'Ingrese la fecha de vencimiento',
                    'warning'
                );

                return;
            }

            $.ajax({

                url: '@Url.Action("ActualizarVencimiento", "Lote")',

                type: 'POST',

                data: {
                    loteId: loteId,
                    fechaVencimiento: fechaVencimiento,
                    numeroLoteProveedor: numeroLoteProveedor
                },

                success: function (response) {

                    if (response.success) {

                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: 'Lote actualizado correctamente',
                            confirmButtonColor: '#28a745'
                        }).then(() => {

                            location.reload();
                        });

                    } else {

                        Swal.fire(
                            'Error',
                            response.message,
                            'error'
                        );
                    }
                },

                error: function () {

                    Swal.fire(
                        'Error',
                        'Error al guardar',
                        'error'
                    );
                }
            });
        }

    </script>

}

<style>

    html,
    body {
        width: 100%;
        overflow-x: hidden;
    }

    .lotes-wrapper {
        width: 100%;
        padding: 24px;
    }

    .lotes-container {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

        .lotes-container .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .lotes-container .col-12 {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

    .lotes-card {
        width: 100%;
        max-width: 100%;
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .card-header-custom {
        padding: 1.7rem 2rem;
        background: linear-gradient(135deg,#c95a00 0%,#a04700 100%);
    }

    .card-body-custom {
        padding: 25px;
        width: 100%;
    }

    .custom-alert {
        border: none;
        border-radius: 14px;
        background: #d1ecf1;
        color: #0c5460;
        padding: 15px 18px;
        margin-bottom: 20px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        border-radius: 18px;
    }

    .table {
        width: 100%;
        min-width: 1300px;
        margin-bottom: 0;
    }

    .table-dark th {
        background: #253238 !important;
        color: #fff;
        border: none;
        padding: 15px 12px;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .table td {
        padding: 15px 12px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .table-hover tbody tr:hover {
        background: rgba(201,90,0,.04);
    }

    .fila-fifo {
        background: #fff8e6 !important;
    }

    .badge-fifo {
        background: #ffc107;
        color: #000;
        font-size: .85rem;
        padding: 8px 14px;
        border-radius: 30px;
        font-weight: 700;
    }

    .badge-normal {
        background: #6c757d;
        color: #fff;
        font-size: .85rem;
        padding: 8px 14px;
        border-radius: 30px;
        font-weight: 700;
    }

    .stock-actual {
        font-weight: 700;
        font-size: 1rem;
    }

    .btn {
        border-radius: 10px;
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg,#c95a00,#a04700);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#a04700,#8b3a00);
        }

    .btn-light {
        border-radius: 10px;
    }

    .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 10px 14px;
    }

        .form-control:focus {
            border-color: #c95a00;
            box-shadow: 0 0 0 3px rgba(201,90,0,.12);
        }

    .form-label {
        font-size: .85rem;
        margin-bottom: 6px;
    }

    .table-responsive::-webkit-scrollbar {
        height: 10px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c95a00;
        border-radius: 10px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a04700;
        }

    @@media (max-width:768px) {

        .lotes-wrapper {
            padding: 12px;
        }

        .card-header-custom {
            padding: 1.2rem;
        }

            .card-header-custom h2 {
                font-size: 1.3rem;
            }

        .card-body-custom {
            padding: 15px;
        }

        .table {
            min-width: 1200px;
        }

        .btn-sm {
            width: 100%;
        }
    }
</style>
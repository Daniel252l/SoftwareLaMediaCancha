@model LaMediaCancha.Models.VentaModels.Venta

@{
    ViewBag.Title = "Detalle de Venta - " + Model.NumeroFactura;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">

                <!-- HEADER -->
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-file-invoice"></i> Detalle de Venta
                            </h2>
                            <p class="mb-0 text-white-50">
                                Factura #@Model.NumeroFactura
                            </p>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button"
                                    class="btn btn-light"
                                    onclick="window.open('@Url.Action("ImprimirFactura", "Venta", new { id = Model.VentaId })', '_blank')">
                                <i class="fas fa-print"></i> Imprimir
                            </button>

                            <a href="@Url.Action("Index", "Factura")"
                               class="btn btn-outline-light">
                                <i class="fas fa-arrow-left"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <!-- BODY -->
                <div class="card-body-custom p-4">

                    <!-- FACTURA ANULADA -->
                    @if (Model.Estado == "Anulada")
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>FACTURA ANULADA</strong>

                            @if (!string.IsNullOrEmpty(Model.NumeroNotaCredito))
                            {
                                <span> - Nota de Crédito: @Model.NumeroNotaCredito</span>
                            }

                            @if (!string.IsNullOrEmpty(Model.MotivoAnulacion))
                            {
                                <div class="mt-2 small">
                                    <strong>Motivo:</strong> @Model.MotivoAnulacion
                                </div>
                            }
                        </div>
                    }

                    <div class="row">

                        <!-- INFORMACION FACTURA -->
                        <div class="col-md-6">
                            <div class="card shadow-sm mb-3">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-info-circle"></i>
                                        Información de la Factura
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <th style="width: 40%;">Número Factura:</th>
                                            <td>
                                                <strong>@Model.NumeroFactura</strong>
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Fecha Emisión:</th>
                                            <td>@Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>

                                        <tr>
                                            <th>Tipo Pago:</th>
                                            <td>@Model.TipoPago</td>
                                        </tr>

                                        <tr>
                                            <th>Estado:</th>
                                            <td>
                                                @if (Model.Estado == "Anulada")
                                                {
                                                    <span class="badge bg-danger">
                                                        Anulada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        Completada
                                                    </span>
                                                }
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Atendido por:</th>
                                            <td>@Model.UsuarioNombre</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACION CLIENTE -->
                        <div class="col-md-6">
                            <div class="card shadow-sm mb-3">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-user"></i>
                                        Información del Cliente
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <th style="width: 40%;">Cliente:</th>
                                            <td>
                                                <strong>@Model.ClienteNombre</strong>
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>Documento:</th>
                                            <td>@(Model.ClienteDocumento ?? "—")</td>
                                        </tr>

                                        <tr>
                                            <th>Teléfono:</th>
                                            <td>@(Model.ClienteTelefono ?? "—")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PRODUCTOS -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-list"></i>
                                Productos
                            </h5>
                        </div>

                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Código</th>
                                            <th>Producto</th>
                                            <th class="text-center">Cantidad</th>
                                            <th class="text-end">Precio</th>
                                            <th class="text-end">Descuento</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (Model.Detalles != null && Model.Detalles.Any())
                                        {
                                            foreach (var item in Model.Detalles)
                                            {
                                                <tr>
                                                    <td>@item.ProductoCodigo</td>

                                                    <td>
                                                        <strong>@item.ProductoNombre</strong>

                                                        @if (item.LotesUtilizados != null && item.LotesUtilizados.Any())
                                                        {
                                                            <br />

                                                            <small class="text-muted">
                                                                @foreach (var lote in item.LotesUtilizados)
                                                                {
                                                                    <span class="d-block">
                                                                        Lote: @lote.NumeroLote
                                                                    </span>
                                                                }
                                                            </small>
                                                        }
                                                    </td>

                                                    <td class="text-center">
                                                        @item.Cantidad
                                                    </td>

                                                    <td class="text-end">
                                                        Q @item.PrecioUnitario.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        Q @item.Descuento.ToString("N2")
                                                    </td>

                                                    <td class="text-end fw-bold">
                                                        Q @item.Subtotal.ToString("N2")
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6"
                                                    class="text-center text-muted py-4">
                                                    No hay productos registrados
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- TOTALES -->
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <table class="table table-sm table-borderless mb-0">

                                        <tr>
                                            <th style="width: 60%;">Subtotal:</th>
                                            <td class="text-end">
                                                Q @Model.Subtotal.ToString("N2")
                                            </td>
                                        </tr>

                                        @if (Model.Descuento > 0)
                                        {
                                            <tr>
                                                <th>Descuento:</th>
                                                <td class="text-end text-danger">
                                                    - Q @Model.Descuento.ToString("N2")
                                                </td>
                                            </tr>
                                        }

                                        <tr>
                                            <th>IVA (12%):</th>
                                            <td class="text-end">
                                                Q @Model.Impuesto.ToString("N2")
                                            </td>
                                        </tr>

                                        <tr class="border-top">
                                            <th class="h5">TOTAL:</th>
                                            <td class="text-end h5 text-success fw-bold">
                                                Q @Model.Total.ToString("N2")
                                            </td>
                                        </tr>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- OBSERVACIONES -->
                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <div class="card shadow-sm mt-3">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0">
                                    <i class="fas fa-comment"></i>
                                    Observaciones
                                </h5>
                            </div>

                            <div class="card-body">
                                <p class="mb-0">
                                    @Model.Observaciones
                                </p>
                            </div>
                        </div>
                    }

                    <!-- BOTONES -->
                    <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">

                        <a href="@Url.Action("Index", "Factura")"
                           class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i>
                            Regresar
                        </a>

                        <button type="button"
                                class="btn btn-primary"
                                onclick="window.open('@Url.Action("ImprimirFactura", "Venta", new { id = Model.VentaId })', '_blank')">

                            <i class="fas fa-print"></i>
                            Imprimir
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%);
    }

        .card-header-custom h2 {
            margin-bottom: 5px;
            font-weight: 600;
        }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            transition: all 0.3s ease;
            border-radius: 10px;
            padding: 8px 18px;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
                transform: translateY(-2px);
            }

        .card-header-custom .btn-outline-light {
            border: 1px solid rgba(255,255,255,0.5);
            color: white;
            border-radius: 10px;
            padding: 8px 18px;
        }

            .card-header-custom .btn-outline-light:hover {
                background: rgba(255,255,255,0.2);
                transform: translateY(-2px);
            }

    .table th {
        font-size: 0.8rem;
        font-weight: 600;
        color: #495057;
    }

    .table td {
        vertical-align: middle;
        padding: 10px;
    }

    .badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .bg-success {
        background-color: #27AE60 !important;
    }

    .bg-danger {
        background-color: #dc3545 !important;
    }

    .btn-primary {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201, 90, 0, 0.3);
        }

    .btn-secondary {
        background: #6c757d;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    .alert {
        border-radius: 10px;
        padding: 15px;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(201, 90, 0, 0.05);
    }

    @@media (max-width: 768px) {

        .card-header-custom {
            padding: 1rem;
        }

            .card-header-custom h2 {
                font-size: 1.3rem;
            }

        .btn-primary,
        .btn-secondary,
        .btn-light,
        .btn-outline-light {
            width: 100%;
        }
    }
</style>
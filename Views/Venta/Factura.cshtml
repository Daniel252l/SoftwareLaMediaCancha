@model LaMediaCancha.Models.ViewModels.VentaViewModel

@{
    ViewBag.Title = "Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .factura-container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .factura-header {
        background: linear-gradient(135deg, #8B4513, #D35400);
        padding: 25px;
        color: white;
        text-align: center;
    }

        .factura-header h1 {
            margin: 0;
            font-size: 28px;
        }

        .factura-header p {
            margin: 5px 0 0;
            opacity: 0.9;
        }

    .factura-body {
        padding: 30px;
    }

    .info-cliente {
        background: #F8F9FA;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

        .info-cliente h4 {
            margin: 0 0 10px 0;
            color: #8B4513;
        }

        .info-cliente p {
            margin: 5px 0;
            font-size: 14px;
        }

    .factura-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

        .factura-table th {
            background: #F8F9FA;
            padding: 12px;
            text-align: left;
            border-bottom: 2px solid #ddd;
        }

        .factura-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #eee;
        }

            .factura-table td:last-child,
            .factura-table th:last-child {
                text-align: right;
            }

    .totales {
        text-align: right;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 2px solid #ddd;
    }

        .totales div {
            margin: 5px 0;
        }

    .total-final {
        font-size: 20px;
        font-weight: 800;
        color: #D35400;
    }

    .btn-imprimir {
        background: #3498DB;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        margin-right: 10px;
        transition: all 0.3s ease;
    }

        .btn-imprimir:hover {
            background: #2980B9;
            transform: translateY(-2px);
        }

    .btn-volver {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .btn-volver:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    @@media print {
        .no-print {
            display: none;
        }

        .factura-container {
            box-shadow: none;
        }

        .btn-imprimir, .btn-volver {
            display: none;
        }
    }
</style>

<div class="factura-container">
    <div class="factura-header">
        <h1>La Media Cancha</h1>
        <p>Restaurante - Cancha Deportiva</p>
        <p>NIT: 123456-7</p>
    </div>

    <div class="factura-body">
        <div class="info-cliente">
            <h4>Datos de la Venta</h4>
            <p><strong>Factura N°:</strong> @Model.NumeroFactura</p>
            <p><strong>Fecha:</strong> @Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
            @if (!string.IsNullOrEmpty(Model.ClienteDocumento))
            {
                <p><strong>NIT/Documento:</strong> @Model.ClienteDocumento</p>
            }
            <p><strong>Tipo de Pago:</strong> @Model.TipoPago</p>
        </div>

        <table class="factura-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Carrito != null && Model.Carrito.Any())
                {
                    foreach (var item in Model.Carrito)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Cantidad</td>
                            <td>Q @item.PrecioUnitario.ToString("N2")</td>
                            <td>Q @item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="totales">
            <div><strong>Subtotal:</strong> Q @Model.Subtotal.ToString("N2")</div>
            <div><strong>IVA (12%):</strong> Q @Model.Impuesto.ToString("N2")</div>
            <div class="total-final"><strong>TOTAL:</strong> Q @Model.Total.ToString("N2")</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Observaciones))
        {
            <div style="margin-top: 20px; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                <strong>Observaciones:</strong> @Model.Observaciones
            </div>
        }

        <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px dashed #ddd;">
            <p>¡Gracias por su compra!</p>
            <p style="font-size: 12px;">Este documento es una factura de venta</p>
        </div>

        <div class="no-print" style="text-align: center; margin-top: 30px;">
            <button class="btn-imprimir" onclick="window.print()">
                <i class="fas fa-print"></i> Imprimir Factura
            </button>
            <a href="@Url.Action("Index", "Venta")" class="btn-volver">
                <i class="fas fa-arrow-left"></i> Nueva Venta
            </a>
        </div>
    </div>
</div>
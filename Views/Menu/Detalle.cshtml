@model LaMediaCancha.Models.MenuModels.ProductoMenu

@{
    ViewBag.Title = Model.TipoItem == "Combo" ? "Detalle de Combo" : "Detalle de Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="detalle-wrapper">
    <div class="detalle-container">

        <div class="card-custom detalle-card">

            <!-- HEADER -->
            <div class="card-header-custom">
                <div class="header-flex">
                    <div>
                        <h2>
                            <i class="fas fa-info-circle me-2"></i>
                            @(Model.TipoItem == "Combo" ? "Detalle de Combo" : "Detalle de Producto")
                        </h2>

                        <p>
                            @(Model.TipoItem == "Combo" ? "Información completa del combo especial" : "Información completa del producto del menú")
                        </p>
                    </div>

                    <a href="@Url.Action("Index")" class="btn-regresar">
                        <i class="fas fa-arrow-left"></i>
                        Regresar
                    </a>
                </div>
            </div>

            <!-- BODY -->
            <div class="card-body-custom">

                <div class="detalle-grid">

                    <!-- LADO IZQUIERDO -->
                    <div>

                        <div class="producto-header">

                            <div class="producto-icono @(Model.TipoItem == "Combo" ? "combo-icono" : "")">
                                @if (Model.TipoItem == "Combo")
                                {
                                    <i class="fas fa-gift"></i>
                                }
                                else
                                {
                                    <i class="fas fa-hamburger"></i>
                                }
                            </div>

                            <div>
                                <h1 class="producto-titulo">
                                    @Model.Nombre
                                </h1>

                                <div class="producto-codigo">
                                    @(Model.TipoItem == "Combo" ? "Combo Especial" : $"Código: {Model.Codigo}")
                                </div>

                                @if (Model.TipoItem == "Combo")
                                {
                                    <div class="combo-badge mt-2">
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-layer-group"></i> COMBO
                                        </span>
                                    </div>
                                }
                            </div>

                        </div>

                        <!-- INFO -->
                        <div class="info-grid">

                            <div class="info-box">
                                <label>CATEGORÍA</label>
                                <p>@Model.Departamento</p>
                            </div>

                            <div class="info-box">
                                <label>SUBCATEGORÍA</label>
                                <p>@Model.SubDepartamento</p>
                            </div>

                            <div class="info-box">
                                <label>PRESENTACIÓN</label>
                                <p>@Model.Presentacion</p>
                            </div>

                            <div class="info-box">
                                <label>ESTADO</label>

                                @if (Model.Activo)
                                {
                                    <span class="estado disponible">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="estado nodisponible">
                                        No disponible
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- PRODUCTOS DEL COMBO (si es combo) -->
                        @if (Model.TipoItem == "Combo" && Model.ProductosCombo != null && Model.ProductosCombo.Any())
                        {
                            <div class="productos-combo-box">
                                <label>
                                    <i class="fas fa-list-ul me-2"></i>
                                    PRODUCTOS INCLUIDOS
                                </label>

                                <div class="tabla-productos-combo">
                                    <table class="table-combo">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th class="text-center">Cantidad</th>
                                                <th class="text-end">Precio Unitario</th>
                                                <th class="text-end">Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                decimal subtotalCombo = 0;
                                            }
                                            @foreach (var item in Model.ProductosCombo)
                                            {
                                                subtotalCombo += item.CantidadIncluida * item.PrecioIndividual;
                                                <tr>
                                                    <td>
                                                        @item.ProductoNombre
                                                </td>
                                                <td class="text-center">
                                                    @item.CantidadIncluida
                                            </td>
                                            <td class="text-end">Q @item.PrecioIndividual.ToString("N2")
                        </td>
                        <td class="text-end">Q @(item.CantidadIncluida * item.PrecioIndividual).ToString("N2")
    </td>
</tr>
                        }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="3" class="text-end fw-bold">
                                                    Valor regular:
                                                </td>
                                                <td class="text-end text-muted">
                                                    Q @subtotalCombo.ToString("N2")
                                                </td>
                                            </tr>
                                            <tr class="ahorro-row">
                                                <td colspan="3" class="text-end fw-bold text-success">
                                                    Ahorro:
                                                </td>
                                                <td class="text-end text-success fw-bold">
                                                    Q @(subtotalCombo - Model.PrecioVenta).ToString("N2")
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- DESCRIPCIÓN -->
                        <div class="descripcion-box">

                            <label>DESCRIPCIÓN</label>

                            <p>
                                @(string.IsNullOrWhiteSpace(Model.Descripcion)
                                    ? (Model.TipoItem == "Combo" ? "Combo especial con productos seleccionados" : "Sin descripción")
                                    : Model.Descripcion)
                            </p>

                        </div>

                    </div>

                    <!-- PRECIO -->
                    <div>

                        @if (Model.EnOferta && Model.PrecioOferta.HasValue)
                        {
                            <div class="precio-card oferta">

                                <div class="badge-oferta">
                                    @(Model.DescuentoPorcentaje ?? 0)% OFF
                                </div>

                                <div class="precio-anterior">
                                    Q @Model.PrecioVenta.ToString("N2")
                                </div>

                                <div class="precio-oferta">
                                    Q @Model.PrecioOferta.Value.ToString("N2")
                                </div>

                                @if (Model.FechaFinOferta.HasValue)
                                {
                                    <div class="fecha-oferta">
                                        Oferta válida hasta:
                                        <strong>
                                            @Model.FechaFinOferta.Value.ToString("dd/MM/yyyy")
                                        </strong>
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="precio-card normal">

                                <div class="precio-normal">
                                    Q @Model.PrecioVenta.ToString("N2")
                                </div>

                                @if (Model.TipoItem == "Combo" && Model.ProductosCombo != null && Model.ProductosCombo.Any())
                                {
                                    decimal subtotal = Model.ProductosCombo.Sum(p => p.CantidadIncluida * p.PrecioIndividual);
                                    <div class="ahorro-combo">
                                        <i class="fas fa-tag"></i>
                                        Ahorras Q @(subtotal - Model.PrecioVenta).ToString("N2")
                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

<style>

    /* ROMPE EL FLEX GLOBAL */
    .main-content {
        display: block !important;
        padding: 0 !important;
    }

    .detalle-wrapper {
        width: 100%;
        padding: 40px;
    }

    .detalle-container {
        width: 100%;
        max-width: 1400px;
        margin: auto;
    }

    .detalle-card {
        width: 100%;
        max-width: 100% !important;
    }

    .header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .card-header-custom h2 {
        color: white;
        margin: 0;
    }

    .card-header-custom p {
        color: rgba(255,255,255,.8);
        margin-top: 5px;
    }

    .btn-regresar {
        border: 1px solid white;
        color: white;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        transition: .3s;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,.15);
            color: white;
        }

    .card-body-custom {
        padding: 40px;
    }

    .detalle-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 40px;
        align-items: start;
    }

    .producto-header {
        display: flex;
        gap: 25px;
        align-items: center;
        margin-bottom: 35px;
    }

    .producto-icono {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: #FDF1E5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .producto-icono.combo-icono {
            background: #FFF8E7;
        }

        .producto-icono i {
            font-size: 70px;
            color: #D35400;
        }

        .producto-icono.combo-icono i {
            color: #F39C12;
        }

    .producto-titulo {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
        color: #1F2937;
    }

    .producto-codigo {
        margin-top: 10px;
        color: #6B7280;
        font-size: 1.1rem;
    }

    .combo-badge {
        margin-top: 10px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-box {
        background: #F9FAFB;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 22px;
    }

        .info-box label {
            font-size: .8rem;
            color: #6B7280;
            font-weight: 700;
            display: block;
            margin-bottom: 10px;
        }

        .info-box p {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 700;
            color: #111827;
        }

    .estado {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 30px;
        font-weight: 700;
        color: white;
    }

    .disponible {
        background: #22C55E;
    }

    .nodisponible {
        background: #EF4444;
    }

    .descripcion-box {
        background: #F9FAFB;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid #E5E7EB;
        margin-top: 20px;
    }

        .descripcion-box label {
            display: block;
            margin-bottom: 15px;
            font-weight: 700;
            color: #6B7280;
        }

        .descripcion-box p {
            margin: 0;
            font-size: 1.05rem;
        }

    .productos-combo-box {
        background: #F9FAFB;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid #E5E7EB;
        margin-top: 20px;
    }

        .productos-combo-box label {
            display: block;
            margin-bottom: 15px;
            font-weight: 700;
            color: #6B7280;
            font-size: 0.9rem;
        }

    .table-combo {
        width: 100%;
        border-collapse: collapse;
    }

        .table-combo th,
        .table-combo td {
            padding: 12px 8px;
            border-bottom: 1px solid #E5E7EB;
        }

        .table-combo th {
            text-align: left;
            font-weight: 600;
            color: #6B7280;
            font-size: 0.8rem;
        }

        .table-combo tfoot td {
            border-bottom: none;
            padding-top: 15px;
        }

    .ahorro-row td {
        border-top: 2px solid #E5E7EB;
        padding-top: 15px;
    }

    .precio-card {
        border-radius: 24px;
        padding: 40px 30px;
        position: relative;
        text-align: center;
        overflow: hidden;
        position: sticky;
        top: 20px;
    }

        .precio-card.oferta {
            background: #FFF1F2;
        }

        .precio-card.normal {
            background: #ECFDF5;
        }

    .badge-oferta {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #E11D48;
        color: white;
        padding: 10px 18px;
        border-radius: 30px;
        font-weight: 700;
    }

    .precio-anterior {
        text-decoration: line-through;
        color: #9CA3AF;
        font-size: 2rem;
        margin-bottom: 20px;
    }

    .precio-oferta {
        font-size: 4.5rem;
        font-weight: 900;
        color: #E11D48;
        line-height: 1;
    }

    .precio-normal {
        font-size: 4.5rem;
        font-weight: 900;
        color: #16A34A;
    }

    .fecha-oferta {
        margin-top: 25px;
        color: #6B7280;
        font-size: 1rem;
    }

    .ahorro-combo {
        margin-top: 20px;
        padding: 12px;
        background: #DCFCE7;
        border-radius: 12px;
        color: #16A34A;
        font-weight: 600;
        font-size: 1rem;
    }

    @@media (max-width: 992px) {

        .detalle-grid {
            grid-template-columns: 1fr;
        }

        .producto-header {
            flex-direction: column;
            text-align: center;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .producto-titulo {
            font-size: 2.2rem;
        }

        .precio-oferta,
        .precio-normal {
            font-size: 3.5rem;
        }

        .precio-card {
            position: static;
            margin-top: 20px;
        }
    }
</style>
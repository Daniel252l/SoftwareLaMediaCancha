@model IEnumerable<LaMediaCancha.Models.MenuModels.ProductoMenu>

@{
    ViewBag.Title = "Menú";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-utensils me-2"></i> Menú
                            </h2>
                            <p class="mb-0 text-white-50">Productos disponibles para la venta</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-4">
                    <!-- Filtro por categoría -->
                    <div class="filtros-container">
                        <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Categoría</label>
                                <select name="categoria" class="form-select" onchange="this.form.submit()">
                                    @if (ViewBag.Categorias != null)
                                    {
                                        foreach (var item in ViewBag.Categorias as List<SelectListItem>)
                                        {
                                            <option value="@item.Value" @(ViewBag.CategoriaSeleccionada == item.Value ? "selected" : "")>@item.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="">Todas las categorías</option>
                                    }
                                </select>
                            </div>
                        </form>
                    </div>

                    <!-- Productos agrupados por categoría -->
                    @if (Model != null && Model.Any())
                    {
                        var grupos = Model.GroupBy(p => p.Departamento).OrderBy(g => g.Key);

                        foreach (var grupo in grupos)
                        {
                            <div class="categoria-section mb-5">
                                <h3 class="categoria-titulo">
                                    <i class="fas fa-tag me-2"></i> @grupo.Key
                                </h3>
                                <div class="row g-4">
                                    @foreach (var item in grupo)
                                    {
                                        <div class="col-md-6 col-lg-4 col-xl-3">
                                            <div class="producto-card @(item.EnOferta ? "oferta" : "") @(item.TipoItem == "Combo" ? "combo-card" : "")">
                                                <div class="card h-100">
                                                    @if (item.EnOferta && item.DescuentoPorcentaje.HasValue)
                                                    {
                                                        <div class="oferta-badge">
                                                            <span class="badge bg-danger">
                                                                @item.DescuentoPorcentaje.Value.ToString("0")% OFF
                                                            </span>
                                                        </div>
                                                    }
                                                    @if (item.TipoItem == "Combo")
                                                    {
                                                        <div class="combo-badge">
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="fas fa-layer-group"></i> COMBO
                                                            </span>
                                                        </div>
                                                    }
                                                    <div class="card-body text-center">
                                                        <div class="producto-icono">
                                                            @if (item.TipoItem == "Combo")
                                                            {
                                                                <i class="fas fa-gift fa-3x text-warning"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-hamburger fa-3x text-primary"></i>
                                                            }
                                                        </div>
                                                        <h5 class="card-title mt-2">@item.Nombre</h5>
                                                        <p class="card-text text-muted small">
                                                            @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" :
                                                              (item.Descripcion.Length > 80 ? item.Descripcion.Substring(0, 80) + "..." : item.Descripcion))
                                                        </p>
                                                        <div class="producto-info">
                                                            <span class="badge bg-secondary">@item.Presentacion</span>
                                                            <span class="badge bg-info">@item.SubDepartamento</span>
                                                        </div>
                                                        <div class="precio mt-3">
                                                            @if (item.EnOferta && item.PrecioOferta.HasValue)
                                                            {
                                                                <span class="precio-antiguo text-muted text-decoration-line-through">Q @item.PrecioVenta.ToString("N2")</span>
                                                                <span class="precio-oferta text-danger fw-bold fs-4 ms-2">Q @(item.PrecioOferta.Value.ToString("N2"))</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="precio-normal text-success fw-bold fs-3">Q @item.PrecioVenta.ToString("N2")</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 pb-3">
                                                        <button type="button" class="btn btn-primary w-100" onclick="verDetalle(@item.ProductoId, '@item.TipoItem')">
                                                            <i class="fas fa-info-circle me-1"></i> Ver Detalle
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                            <p class="text-muted">No hay productos disponibles</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .filtros-container {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .categoria-titulo {
            color: #8B4513;
            border-left: 4px solid #D35400;
            padding-left: 15px;
            margin-bottom: 20px;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .producto-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .producto-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }

            .producto-card.oferta {
                border-left: 4px solid #dc3545;
            }

            .producto-card.combo-card {
                border-left: 4px solid #f39c12;
            }

        .producto-icono {
            text-align: center;
            margin-bottom: 10px;
        }

        .producto-info {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 10px;
        }

        .oferta-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 1;
        }

        .combo-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 1;
        }

        .precio-antiguo {
            font-size: 0.85rem;
        }

        .precio-oferta, .precio-normal {
            font-weight: bold;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
            border: 1px solid #e0e0e0;
        }

            .card:hover {
                border-color: #D35400;
            }

        .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: 30px !important;
            padding-right: 30px !important;
        }

        .card-custom {
            width: 100%;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .card-header-custom {
            padding: 1.5rem 2rem;
            background: linear-gradient(135deg, #c95a00 0%, #a04700 100%);
        }

        .card-body-custom {
            padding: 20px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #c95a00, #a04700);
            border: none;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #a04700, #8b3a00);
                transform: translateY(-2px);
            }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #ddd;
            padding: 10px 12px;
        }

            .form-control:focus, .form-select:focus {
                border-color: #c95a00;
                box-shadow: 0 0 0 3px rgba(201,90,0,0.1);
                outline: none;
            }

        @@media (max-width: 768px) {
            .categoria-titulo {
                font-size: 1.2rem;
            }

            .producto-card .card-title {
                font-size: 1rem;
            }

            .precio-normal, .precio-oferta {
                font-size: 1.2rem;
            }
        }
    </style>

    <script>
        function verDetalle(id, tipo) {
            window.location.href = '@Url.Action("Detalle", "Menu")/' + id + '?tipo=' + tipo;
        }
    </script>
}
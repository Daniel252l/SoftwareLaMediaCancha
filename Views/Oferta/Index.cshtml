@model IEnumerable<LaMediaCancha.Models.ViewModels.OfertaViewModel>

@{
    ViewBag.Title = "Ofertas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-percent me-2"></i> Ofertas
                            </h2>
                            <p class="mb-0 text-white-50">Gestión de promociones y descuentos</p>
                        </div>
                        <div class="mt-2 mt-sm-0">
                            <a href="@Url.Action("Crear")" class="btn btn-light me-2">
                                <i class="fas fa-plus-circle me-1"></i> Nueva Oferta
                            </a>
                            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom p-3">

                    @if (TempData["SuccessOferta"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert"
                             style="border-radius: 10px; border-left: 4px solid #28a745;">
                            <i class="fas fa-check-circle text-success" style="font-size: 1.3rem;"></i>
                            <span class="fw-semibold">@TempData["SuccessOferta"]</span>
                        </div>
                    }
                    @if (TempData["ErrorOferta"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert"
                             style="border-radius: 10px; border-left: 4px solid #dc3545;">
                            <i class="fas fa-times-circle text-danger" style="font-size: 1.3rem;"></i>
                            <span class="fw-semibold">@TempData["ErrorOferta"]</span>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Producto</th>
                                    <th>Descripción</th>
                                    <th class="text-center">% Descuento</th>
                                    <th class="text-end">Precio Original</th>
                                    <th class="text-end">Precio Oferta</th>
                                    <th>Vigencia</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong>@item.Nombre</strong></td>
                                            <td>@item.ProductoNombre</td>
                                            <td>@(item.Descripcion ?? "-")</td>
                                            <td class="text-center">
                                                <span class="badge bg-danger">@item.DescuentoPorcentaje%</span>
                                            </td>
                                            <td class="text-end text-muted">
                                                <span class="text-decoration-line-through">@item.PrecioOriginal.ToString("C")</span>
                                            </td>
                                            <td class="text-end text-success fw-bold">@item.PrecioOferta.ToString("C")</td>
                                            <td>
                                                @if (item.FechaFin < DateTime.Now)
                                                {
                                                    <span class="badge bg-secondary">Vencida</span>
                                                }
                                                else
                                                {
                                                    <span>@item.FechaInicio.ToString("dd/MM/yy") - @item.FechaFin.ToString("dd/MM/yy")</span>
                                                    <br /><small class="text-muted">@item.DiasRestantes días restantes</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.EsVigente)
                                                {
                                                    <span class="badge bg-success">Activa</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactiva</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-2">
                                                    <a href="@Url.Action("Editar", new { id = item.OfertaId })"
                                                       class="btn btn-sm btn-warning text-white" title="Editar">
                                                        <i class="fas fa-edit me-1"></i> Editar
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" title="Eliminar"
                                                            onclick="eliminarOferta(@item.OfertaId, '@item.Nombre.Replace("'", "\\'")')">
                                                        <i class="fas fa-trash me-1"></i> Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5">
                                            <i class="fas fa-percent fa-3x text-muted mb-3 d-block"></i>
                                            <p class="text-muted mb-0">No hay ofertas registradas</p>
                                            <a href="@Url.Action("Crear")" class="btn btn-primary mt-3">Crear primera oferta</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function eliminarOferta(id, nombre) {
            Swal.fire({
                title: '¿Eliminar oferta?',
                html: '¿Está seguro de eliminar la oferta <strong>' + nombre + '</strong>?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Por favor espere',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });
                    $.ajax({
                        url: '@Url.Action("Eliminar", "Oferta")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Eliminada!',
                                    text: response.message,
                                    confirmButtonColor: '#c95a00'
                                }).then(() => { location.reload(); });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Error al eliminar la oferta', 'error');
                        }
                    });
                }
            });
        }
    </script>
}

<style>
    .card-custom {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-custom-full {
        max-width: 100% !important;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
    }

        .card-header-custom .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            border-radius: 10px;
            padding: 8px 18px;
            transition: all 0.3s ease;
        }

            .card-header-custom .btn-light:hover {
                background: rgba(255,255,255,0.3);
                transform: translateY(-2px);
            }

        .card-header-custom .btn-outline-light {
            border: 1px solid rgba(255,255,255,0.5);
            color: white;
            border-radius: 10px;
            padding: 8px 18px;
            transition: all 0.3s ease;
        }

            .card-header-custom .btn-outline-light:hover {
                background: rgba(255,255,255,0.2);
                transform: translateY(-2px);
            }

    .table th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 8px;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.9rem;
        padding: 12px 8px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(201, 90, 0, 0.05);
    }

    .btn-warning {
        background: linear-gradient(135deg, #c95a00, #a04700);
        border: none;
        transition: all 0.2s ease;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #a04700, #8b3a00);
            transform: translateY(-2px);
        }

    .btn-danger {
        background: linear-gradient(135deg, #E74C3C, #c0392b);
        border: none;
        transition: all 0.2s ease;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
        }

    .badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .card-header-custom {
            padding: 1rem;
        }

        .d-flex.gap-2 {
            flex-wrap: wrap;
            gap: 5px !important;
        }
    }
</style>
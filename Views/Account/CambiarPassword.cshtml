@model LaMediaCancha.Models.ViewModels.CambiarPasswordViewModel
@{
    ViewBag.Title = "Cambiar Contraseña";
}

<div class="card-custom">
    <div class="card-header-custom">
        <h2>Cambiar Contraseña</h2>
        <p>Actualiza tu contraseña antes de continuar</p>
    </div>

    <div class="card-body-custom">

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert-custom alert-info-custom">@ViewBag.Mensaje</div>
        }

        @if (TempData["Exito"] != null)
        {
            <div class="alert-custom alert-success-custom">@TempData["Exito"]</div>
        }

        @Html.ValidationSummary(true, "", new { @class = "alert-custom alert-danger-custom" })

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group-custom">
                <label for="PasswordActual">Contraseña Actual</label>
                @Html.PasswordFor(m => m.PasswordActual, new
                {
                    @class = "form-control-custom",
                    placeholder = "Ingresa tu contraseña actual",
                    id = "PasswordActual"
                })
                @Html.ValidationMessageFor(m => m.PasswordActual, "", new { @class = "text-danger-custom" })
            </div>

            <div class="form-group-custom">
                <label for="NuevaPassword">Nueva Contraseña</label>
                @Html.PasswordFor(m => m.NuevaPassword, new
                {
                    @class = "form-control-custom",
                    placeholder = "Mínimo 8 caracteres",
                    id = "NuevaPassword"
                })
                <small style="color: var(--text-light); font-size: 0.8rem; margin-top: 5px; display: block;">
                    Mínimo 8 caracteres, sin espacios, mayúscula, minúscula, número y símbolo
                </small>
                @Html.ValidationMessageFor(m => m.NuevaPassword, "", new { @class = "text-danger-custom" })
            </div>

            <div class="form-group-custom">
                <label for="ConfirmarPassword">Confirmar Contraseña</label>
                @Html.PasswordFor(m => m.ConfirmarPassword, new
                {
                    @class = "form-control-custom",
                    placeholder = "Repite la nueva contraseña",
                    id = "ConfirmarPassword"
                })
                @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger-custom" })
            </div>

            <button type="submit" class="btn-custom">
                <i class="fas fa-save"></i> CAMBIAR CONTRASEÑA
            </button>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
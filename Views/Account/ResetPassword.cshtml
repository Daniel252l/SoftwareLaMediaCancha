@model LaMediaCancha.Models.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-custom">
    <div class="card-header-custom">
        <h2>Restablecer Contraseña</h2>
        <p>Ingresa tu nueva contraseña</p>
    </div>

    <div class="card-body-custom">

        @if (TempData["Error"] != null)
        {
            <div class="toast-notification toast-error" style="margin-bottom: 20px;">
                <div class="toast-icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <div class="toast-content">
                    <div class="toast-title">¡Error!</div>
                    <div class="toast-message">@TempData["Error"]</div>
                </div>
            </div>
        }

        @if (TempData["Exito"] != null)
        {
            <div class="toast-notification toast-success" style="margin-bottom: 20px;">
                <div class="toast-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="toast-content">
                    <div class="toast-title">¡Éxito!</div>
                    <div class="toast-message">@TempData["Exito"]</div>
                </div>
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "toast-notification toast-error", style = "margin-bottom: 20px; list-style: none; padding: 12px 20px;" })

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)
            @Html.HiddenFor(m => m.Email)

            <div class="form-group-custom">
                <label for="NuevaPassword">Nueva Contraseña</label>
                @Html.PasswordFor(m => m.NuevaPassword, new
                {
                    @class = "form-control-custom",
                    placeholder = "Mínimo 8 caracteres",
                    id = "NuevaPassword",
                    required = "required"
                })
                <small style="color: var(--text-light); font-size: 0.8rem; margin-top: 5px; display: block;">
                    Mínimo 8 caracteres, sin espacios, mayúscula, minúscula, número y símbolo
                </small>
                @Html.ValidationMessageFor(m => m.NuevaPassword, "", new { @class = "text-danger-custom" })
            </div>

            <div class="form-group-custom">
                <label for="ConfirmarPassword">Confirmar Contraseña</label>
                @Html.PasswordFor(m => m.ConfirmarPassword, new
                {
                    @class = "form-control-custom",
                    placeholder = "Repite la nueva contraseña",
                    id = "ConfirmarPassword",
                    required = "required"
                })
                @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger-custom" })
            </div>

            <button type="submit" class="btn-custom" id="btnReset">
                <i class="fas fa-key"></i> RESTABLECER CONTRASEÑA
            </button>

            <div class="text-center mt-3">
                @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", null, new { @class = "link-custom" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('resetForm');
            var btn = document.getElementById('btnReset');

            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> PROCESANDO...';
                    btn.disabled = true;
                });
            }

            // Validar que las contraseñas coincidan antes de enviar
            form.addEventListener('submit', function (e) {
                var password = document.getElementById('NuevaPassword').value;
                var confirm = document.getElementById('ConfirmarPassword').value;

                if (password !== confirm) {
                    e.preventDefault();
                    alert('Las contraseñas no coinciden');
                    btn.innerHTML = '<i class="fas fa-key"></i> RESTABLECER CONTRASEÑA';
                    btn.disabled = false;
                }
            });
        });
    </script>
}
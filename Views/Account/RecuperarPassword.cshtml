@model LaMediaCancha.Models.ViewModels.RecuperarPasswordViewModel
@{
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="card-custom">
    <div class="card-header-custom">
        <h2>Recuperar Contraseña</h2>
        <p>Te enviaremos instrucciones a tu correo</p>
    </div>

    <div class="card-body-custom">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert-custom alert-info-custom">@TempData["Mensaje"]</div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group-custom">
                <label for="Email">Correo Electrónico</label>
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control-custom",
                    placeholder = "tucorreo@ejemplo.com",
                    type = "email",
                    id = "Email"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger-custom" })
            </div>

            <button type="submit" class="btn-custom">
                <i class="fas fa-paper-plane"></i>
                Enviar Instrucciones
            </button>

            <div class="text-center mt-3">
                @Html.ActionLink("Volver al inicio", "Login", null, new { @class = "link-custom" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
@model LaMediaCancha.Models.ViewModels.OrdenViewModel
@{
    ViewBag.Title = "Tomar Pedido - Mesa " + Model.NumeroMesa;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-clipboard-list"></i> Tomar Pedido</h2>
                            <p>Mesa @Model.NumeroMesa - @Model.Ubicacion</p>
                        </div>
                        <div>
                            <a href="@Url.Action("Index")" class="btn-custom" style="background: #6c757d; width: auto; padding: 8px 15px;">
                                <i class="fas fa-arrow-left"></i> Regresar
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body-custom">

                    <form id="frmOrden" method="post">
                        <input type="hidden" id="MesaId" name="MesaId" value="@Model.MesaId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Cliente (Opcional)</label>
                                    <input type="text" id="ClienteNombre" name="ClienteNombre" class="form-control" placeholder="Nombre del cliente" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Teléfono (Opcional)</label>
                                    <input type="text" id="ClienteTelefono" name="ClienteTelefono" class="form-control" placeholder="Teléfono" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Observaciones</label>
                            <textarea id="Observaciones" name="Observaciones" class="form-control" rows="2" placeholder="Notas adicionales para la cocina"></textarea>
                        </div>

                        <hr />

                        <!-- Productos -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4><i class="fas fa-boxes"></i> Productos</h4>
                            <button type="button" class="btn-agregar" id="btnAgregarProducto" style="background: #27AE60; color: white; border: none; padding: 8px 20px; border-radius: 5px;">
                                <i class="fas fa-plus"></i> Agregar Producto
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table-custom" id="tblProductos">
                                <thead>
                                    <tr>
                                        <th style="width: 35%;">Producto</th>
                                        <th style="width: 15%;">Cantidad</th>
                                        <th style="width: 20%;">Precio Unitario (Q)</th>
                                        <th style="width: 15%;">Nota</th>
                                        <th style="width: 15%;">Subtotal (Q)</th>
                                        <th style="width: 5%;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tblProductosBody"></tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-right"><strong>Total:</strong></td>
                                        <td colspan="2"><strong id="totalGeneral">Q 0.00</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="text-right mt-3">
                            <button type="submit" id="btnGuardar" class="btn-custom" style="background: #D35400; padding: 10px 30px;">
                                <i class="fas fa-save"></i> Guardar Pedido
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para seleccionar producto -->
<div id="modalProducto" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 10px; width: 600px; max-width: 90%; overflow: hidden;">
        <div style="background: linear-gradient(135deg, #8B4513, #D35400); color: white; padding: 15px 20px;">
            <h5 style="margin: 0;">Seleccionar Producto</h5>
        </div>
        <div style="padding: 20px;">
            <input type="text" id="buscarProducto" class="form-control" placeholder="Buscar producto..." style="margin-bottom: 15px;" />
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table-custom" id="tblProductosDisponibles">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th class="text-right">Precio (Q)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <div style="padding: 15px; border-top: 1px solid #eee; text-align: right;">
            <button type="button" class="btn-cancelar" onclick="cerrarModalProducto()">Cancelar</button>
        </div>
    </div>
</div>

<style>
    .btn-agregar:hover {
        background: #1E8449 !important;
    }

    .btn-cancelar {
        background: #6c757d;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-eliminar-producto {
        background: #E74C3C;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom th, .table-custom td {
            padding: 12px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .table-custom th {
            background: #8B4513;
            color: white;
        }

        .table-custom input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            text-align: center;
        }

    .text-right {
        text-align: right;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }
</style>

@section Scripts {
    <link href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var contadorProductos = 0;
        var productosDisponibles = [];

        function formatearMoneda(valor) {
            return 'Q ' + valor.toFixed(2);
        }

        function calcularTotal() {
            let total = 0;
            $('#tblProductos tbody tr').each(function() {
                let subtotal = parseFloat($(this).find('.subtotal').data('val')) || 0;
                total += subtotal;
            });
            $('#totalGeneral').text(formatearMoneda(total));
        }

        function calcularSubtotal(fila) {
            let cantidad = parseFloat(fila.find('.cantidad').val()) || 0;
            let precio = parseFloat(fila.find('.precio').val()) || 0;
            let subtotal = cantidad * precio;
            fila.find('.subtotal').text(formatearMoneda(subtotal)).data('val', subtotal);
            calcularTotal();
        }

        function agregarProducto(producto) {
            if ($('#tblProductos tbody tr[data-id="' + producto.ProductoId + '"]').length > 0) {
                Swal.fire('Atención', 'El producto ya está en la lista', 'warning');
                return;
            }

            var nuevaFila = `
                <tr data-id="${producto.ProductoId}">
                    <td><strong>${producto.NombreProducto}</strong>
                        <input type="hidden" name="Productos[${contadorProductos}].ProductoId" value="${producto.ProductoId}" />
                    </td>
                    <td><input type="number" name="Productos[${contadorProductos}].Cantidad" class="cantidad" min="0.01" step="0.01" value="1" required /></td>
                    <td><input type="number" name="Productos[${contadorProductos}].PrecioUnitario" class="precio" value="${producto.PrecioUnitario}" readonly style="background:#f5f5f5;" /></td>
                    <td><input type="text" name="Productos[${contadorProductos}].Nota" class="nota" placeholder="Ej: Sin sal" /></td>
                    <td class="subtotal" data-val="0">Q 0.00</td
                    <td><button type="button" class="btn-eliminar-producto"><i class="fas fa-trash"></i></button></td>
                </tr>
            `;
            $('#tblProductos tbody').append(nuevaFila);
            contadorProductos++;
            let fila = $('#tblProductos tbody tr:last');
            fila.find('.cantidad').on('change keyup', function() { calcularSubtotal(fila); });
            fila.find('.btn-eliminar-producto').click(function() { fila.remove(); calcularTotal(); reindexar(); });
            calcularSubtotal(fila);
        }

        function reindexar() {
            $('#tblProductos tbody tr').each(function(index) {
                $(this).find('input').each(function() {
                    var name = $(this).attr('name');
                    if (name) name = name.replace(/Productos\[\d+\]/, 'Productos[' + index + ']');
                    $(this).attr('name', name);
                });
            });
            contadorProductos = $('#tblProductos tbody tr').length;
        }

        function cargarProductosDisponibles() {
            $.get('@Url.Action("GetProductos", "Orden")', function(data) {
                productosDisponibles = data;
                var tbody = $('#tblProductosDisponibles tbody');
                tbody.empty();
                $.each(data, function(i, p) {
                    tbody.append(`
                        <tr>
                            <td>${p.Codigo}</td>
                            <td>${p.NombreProducto}</td>
                            <td class="text-right">${formatearMoneda(p.PrecioUnitario)}</td
                            <td><button type="button" class="btn-seleccionar" data-id="${p.ProductoId}" data-nombre="${p.NombreProducto}" data-precio="${p.PrecioUnitario}">Seleccionar</button><td>
                        </tr>
                    `);
                });
            });
        }

        function abrirModalProducto() {
            $('#modalProducto').css('display', 'flex');
            cargarProductosDisponibles();
        }

        function cerrarModalProducto() {
            $('#modalProducto').hide();
            $('#buscarProducto').val('');
        }

        $(document).ready(function() {
            $('#btnAgregarProducto').click(abrirModalProducto);

            $(document).on('click', '.btn-seleccionar', function() {
                agregarProducto({
                    ProductoId: $(this).data('id'),
                    NombreProducto: $(this).data('nombre'),
                    PrecioUnitario: $(this).data('precio')
                });
                cerrarModalProducto();
            });

            $('#buscarProducto').on('keyup', function() {
                var filtro = $(this).val().toLowerCase();
                var tbody = $('#tblProductosDisponibles tbody');
                tbody.empty();
                $.each(productosDisponibles, function(i, p) {
                    if (p.NombreProducto.toLowerCase().includes(filtro) || p.Codigo.toLowerCase().includes(filtro)) {
                        tbody.append(`
                            <tr>
                                <td>${p.Codigo}</td>
                                <td>${p.NombreProducto}</td>
                                <td class="text-right">${formatearMoneda(p.PrecioUnitario)}</td
                                <td><button type="button" class="btn-seleccionar" data-id="${p.ProductoId}" data-nombre="${p.NombreProducto}" data-precio="${p.PrecioUnitario}">Seleccionar</button></td>
                            </tr>
                        `);
                    }
                });
            });

            $('#frmOrden').submit(function(e) {
                e.preventDefault();
                if ($('#tblProductos tbody tr').length === 0) {
                    Swal.fire('Atención', 'Debe agregar al menos un producto', 'warning');
                    return;
                }
                reindexar();

                var datos = {
                    MesaId: $('#MesaId').val(),
                    ClienteNombre: $('#ClienteNombre').val(),
                    ClienteTelefono: $('#ClienteTelefono').val(),
                    Observaciones: $('#Observaciones').val(),
                    Productos: []
                };

                $('#tblProductos tbody tr').each(function() {
                    var producto = {
                        ProductoId: $(this).find('input[name$=".ProductoId"]').val(),
                        Cantidad: $(this).find('.cantidad').val(),
                        PrecioUnitario: $(this).find('.precio').val(),
                        Nota: $(this).find('.nota').val()
                    };
                    datos.Productos.push(producto);
                });

                $.ajax({
                    url: '@Url.Action("GuardarOrden", "Orden")',
                    type: 'POST',
                    data: JSON.stringify(datos),
                    contentType: 'application/json',
                    success: function(r) {
                        if (r.success) {
                            Swal.fire('Éxito', r.message, 'success').then(() => {
                                window.location.href = '@Url.Action("Index")';
                            });
                        } else {
                            Swal.fire('Error', r.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Error al guardar el pedido', 'error');
                    }
                });
            });
        });
    </script>
}
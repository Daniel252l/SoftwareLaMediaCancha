@model LaMediaCancha.Models.ViewModels.TicketViewModel

@{
    ViewBag.Title = "Ticket de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ticket-page">

    <div class="ticket-card">

        <div class="ticket-card-header">

            <h3>
                <i class="fas fa-receipt me-2"></i>
                Ticket de Venta
            </h3>

        </div>

        <div class="ticket-card-body">

            @Html.Partial("_TicketPartial", Model)

        </div>

        <div class="ticket-card-footer">

            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">

                <i class="fas fa-print me-1"></i>
                Imprimir
            </button>

            <a href="@Url.Action("Index")"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Regresar
            </a>

        </div>

    </div>

</div>

<style>

    .ticket-page {
        min-height: 100vh;
        padding: 40px 20px;
        background: #f4f6f9;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .ticket-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .ticket-card-header {
        background: linear-gradient(135deg,#198754,#146c43);
        color: white;
        padding: 18px;
        text-align: center;
    }

        .ticket-card-header h3 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
        }

    .ticket-card-body {
        padding: 25px;
    }

    .ticket-card-footer {
        padding: 20px;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    @@media print {

        body * {
            visibility: hidden;
        }

        .ticket-card-body,
        .ticket-card-body * {
            visibility: visible;
        }

        .ticket-card-body {
            position: absolute;
            left: 0;
            top: 0;
            width: 80mm;
            padding: 0;
        }

        .ticket-card-header,
        .ticket-card-footer {
            display: none;
        }

        .ticket-page {
            padding: 0;
            background: #fff;
        }

        .ticket-card {
            box-shadow: none;
            border-radius: 0;
        }
    }
</style>
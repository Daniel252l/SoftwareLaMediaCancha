@model LaMediaCancha.Models.ViewModels.OrdenCuentaViewModel

@{
    ViewBag.Title = "Cuenta - Orden " + Model.NumeroOrden;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cuenta-container {
        padding: 30px;
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .cuenta-card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .cuenta-header {
        background: linear-gradient(135deg, #8B4513, #D35400);
        color: white;
        padding: 25px 30px;
    }

        .cuenta-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
        }

        .cuenta-header p {
            margin: 5px 0 0;
            opacity: 0.9;
        }

    .btn-regresar {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        padding: 8px 20px;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,0.3);
            transform: translateY(-2px);
            color: white;
        }

    .cuenta-body {
        padding: 30px;
    }

    .cuenta-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
    }

    .productos-section {
        background: #f8f9fa;
        border-radius: 20px;
        padding: 20px;
    }

    .productos-titulo {
        font-size: 18px;
        font-weight: 800;
        color: #8B4513;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #D35400;
    }

    .cuenta-persona-card {
        background: white;
        border-radius: 16px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .cuenta-persona-header {
        background: #2C3E50;
        color: white;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cuenta-persona-titulo {
        font-size: 16px;
        font-weight: 700;
    }

    .cuenta-persona-total {
        font-size: 16px;
        font-weight: 800;
        color: #F39C12;
    }

    .cuenta-persona-body {
        padding: 15px;
    }

    .producto-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px dashed #e0e0e0;
    }

        .producto-item:last-child {
            border-bottom: none;
        }

    .producto-info {
        flex: 1;
    }

    .producto-nombre {
        font-weight: 600;
        color: #2C3E50;
    }

    .producto-nota {
        font-size: 11px;
        color: #7F8C8D;
        margin-top: 2px;
    }

    .producto-detalle {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .producto-cantidad {
        color: #7F8C8D;
        font-size: 13px;
    }

    .producto-precio {
        font-weight: 600;
        color: #D35400;
    }

    .tabla-productos {
        width: 100%;
        border-collapse: collapse;
    }

        .tabla-productos th,
        .tabla-productos td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        .tabla-productos th {
            background: #f0f0f0;
            font-weight: 700;
        }

    .text-end {
        text-align: right;
    }

    .resumen-section {
        position: sticky;
        top: 20px;
    }

    .resumen-card {
        background: #f8f9fa;
        border-radius: 20px;
        padding: 20px;
        border: 1px solid #e0e0e0;
    }

    .resumen-titulo {
        font-size: 18px;
        font-weight: 800;
        color: #8B4513;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #D35400;
    }

    .total-line {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .total-grande {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        margin-top: 10px;
        border-top: 2px solid #D35400;
        font-size: 20px;
        font-weight: 800;
    }

        .total-grande span:last-child {
            color: #D35400;
        }

    .modo-pago {
        background: white;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .modo-pago-titulo {
        font-weight: 700;
        margin-bottom: 10px;
        color: #2C3E50;
    }

    .form-select, .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 14px;
    }

    .btn-pagar {
        background: linear-gradient(135deg, #27AE60, #1e8449);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 15px;
        font-weight: 800;
        font-size: 16px;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

        .btn-pagar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(39,174,96,0.3);
        }

    .badge-combo {
        background: #F39C12;
        font-size: 9px;
        padding: 2px 6px;
        border-radius: 10px;
        margin-left: 5px;
    }

    .cambio-info {
        font-size: 14px;
        font-weight: 600;
        margin-top: 10px;
        padding: 8px;
        border-radius: 10px;
        text-align: center;
    }

        .cambio-info.verde {
            background: #d4edda;
            color: #155724;
        }

        .cambio-info.rojo {
            background: #f8d7da;
            color: #721c24;
        }

    @@media (max-width: 992px) {
        .cuenta-layout {
            grid-template-columns: 1fr;
        }

        .resumen-section {
            position: static;
        }
    }
</style>

<div class="cuenta-container">
    <div class="cuenta-card">
        <div class="cuenta-header">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h2><i class="fas fa-receipt"></i> Cuenta</h2>
                    <p><i class="fas fa-hashtag"></i> Orden #@Model.NumeroOrden | Mesa @Model.MesaId</p>
                    <p><i class="fas fa-user"></i> Cliente: @Model.ClienteNombre</p>
                    <p><i class="fas fa-calendar"></i> Fecha: @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <a href="@Url.Action("Index", "Orden")" class="btn-regresar">
                    <i class="fas fa-arrow-left"></i> Regresar a Mesas
                </a>
            </div>
        </div>

        <div class="cuenta-body">
            <div class="cuenta-layout">
                <!-- Columna Izquierda: Productos -->
                <div class="productos-section">
                    <div class="productos-titulo">
                        <i class="fas fa-clipboard-list"></i> Detalle del Pedido
                    </div>

                    @if (Model.CuentasSeparadas != null && Model.CuentasSeparadas.Any())
                    {
                        foreach (var persona in Model.CuentasSeparadas)
                        {
                            <div class="cuenta-persona-card">
                                <div class="cuenta-persona-header">
                                    <span class="cuenta-persona-titulo">
                                        <i class="fas fa-user"></i> @persona.NombreCliente
                                    </span>
                                    <span class="cuenta-persona-total">
                                        Q @persona.Total.ToString("N2")
                                    </span>
                                </div>
                                <div class="cuenta-persona-body">
                                    @if (persona.Detalles != null && persona.Detalles.Any())
                                    {
                                        foreach (var item in persona.Detalles)
                                        {
                                            <div class="producto-item">
                                                <div class="producto-info">
                                                    <span class="producto-nombre">
                                                        @item.ProductoNombre
                                                        @if (item.EsDeCombo)
                                                        {
                                                            <span class="badge-combo">COMBO</span>
                                                        }
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(item.Nota))
                                                    {
                                                        <div class="producto-nota">📝 @item.Nota</div>
                                                    }
                                                </div>
                                                <div class="producto-detalle">
                                                    <span class="producto-cantidad">x@item.Cantidad</span>
                                                    <span class="producto-precio">Q @item.Subtotal.ToString("N2")</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (Model.Detalles != null && Model.Detalles.Any())
                    {
                        <table class="tabla-productos">
                            <thead>
                                <tr>
                                    <th>Cant</th>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Detalles)
                                {
                                    <tr>
                                        <td>@item.Cantidad</td>
                                        <td>
                                            @item.ProductoNombre
                                            @if (!string.IsNullOrEmpty(item.Nota))
                                            {
                                                <div class="producto-nota">📝 @item.Nota</div>
                                            }
                                        </td>
                                        <td class="text-end">Q @item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">Q @item.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-info-circle"></i> No hay productos en esta orden
                        </div>
                    }
                </div>

                <!-- Columna Derecha: Resumen y Pago -->
                <div class="resumen-section">
                    <div class="resumen-card">
                        <div class="resumen-titulo">
                            <i class="fas fa-calculator"></i> Resumen de Cuenta
                        </div>

                        @if (Model.CuentasSeparadas != null && Model.CuentasSeparadas.Any())
                        {
                            foreach (var persona in Model.CuentasSeparadas)
                            {
                                <div class="total-line">
                                    <span>@persona.NombreCliente:</span>
                                    <span>Q @persona.Total.ToString("N2")</span>
                                </div>
                            }
                            <hr />
                        }

                        <div class="total-line">
                            <span>Subtotal:</span>
                            <span>Q @Model.Subtotal.ToString("N2")</span>
                        </div>
                        <div class="total-line">
                            <span>IVA (12%):</span>
                            <span>Q @Model.Impuesto.ToString("N2")</span>
                        </div>

                        <div class="total-grande">
                            <span>TOTAL A PAGAR:</span>
                            <span id="totalMostrar">Q @Model.Total.ToString("N2")</span>
                        </div>

                        <!-- Forma de Pago -->
                        <div class="modo-pago" style="margin-top: 20px;">
                            <div class="modo-pago-titulo">
                                <i class="fas fa-money-bill-wave"></i> Forma de Pago
                            </div>
                            <select id="formaPago" class="form-select">
                                <option value="Efectivo">💵 Efectivo</option>
                                <option value="Tarjeta">💳 Tarjeta de Crédito/Débito</option>
                                <option value="QR">📱 Código QR</option>
                            </select>
                        </div>

                        <!-- Input para monto recibido (solo para efectivo) -->
                        <div id="montoEfectivoContainer" style="display: none;">
                            <div class="modo-pago">
                                <div class="modo-pago-titulo">
                                    <i class="fas fa-dollar-sign"></i> Monto Recibido
                                </div>
                                <input type="number" id="montoRecibido" class="form-control"
                                       placeholder="Ingrese el monto entregado por el cliente" step="0.01" min="0">
                                <div id="cambioInfo" class="cambio-info" style="display: none;"></div>
                            </div>
                        </div>

                        <!-- Botón de pago -->
                        <button id="btnPagar" class="btn-pagar">
                            <i class="fas fa-check-circle"></i> PAGAR CUENTA
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let ordenId = @Model.OrdenId;
        let total = @Model.Total.ToString().Replace(",", ".");

        $(document).ready(function() {
            // Mostrar/ocultar campo de monto según forma de pago
            $('#formaPago').on('change', function() {
                let esEfectivo = $(this).val() === 'Efectivo';
                $('#montoEfectivoContainer').toggle(esEfectivo);
                if (!esEfectivo) {
                    $('#montoRecibido').val('');
                    $('#cambioInfo').hide();
                }
            });

            // Calcular cambio en tiempo real
            $('#montoRecibido').on('keyup', function() {
                let recibido = parseFloat($(this).val()) || 0;
                let cambio = recibido - total;

                if (recibido > 0) {
                    if (cambio >= 0) {
                        $('#cambioInfo').html(`💰 Cambio: Q ${cambio.toFixed(2)}`).removeClass('rojo').addClass('verde').show();
                    } else {
                        $('#cambioInfo').html(`⚠️ Faltan: Q ${Math.abs(cambio).toFixed(2)}`).removeClass('verde').addClass('rojo').show();
                    }
                } else {
                    $('#cambioInfo').hide();
                }
            });

            // Procesar pago
            $('#btnPagar').on('click', function() {
                let formaPago = $('#formaPago').val();
                let montoRecibido = parseFloat($('#montoRecibido').val()) || 0;
                let cambio = montoRecibido - total;

                // Validar para efectivo
                if (formaPago === 'Efectivo') {
                    if (montoRecibido === 0) {
                        Swal.fire('Error', 'Ingrese el monto recibido del cliente', 'error');
                        return;
                    }
                    if (montoRecibido < total) {
                        Swal.fire('Error', `El monto recibido (Q ${montoRecibido.toFixed(2)}) es insuficiente. Total: Q ${total.toFixed(2)}`, 'error');
                        return;
                    }
                }

                // Confirmar pago
                let mensaje = `<strong>Total:</strong> Q ${total.toFixed(2)}<br>
                               <strong>Forma de pago:</strong> ${formaPago}<br>`;

                if (formaPago === 'Efectivo') {
                    mensaje += `<strong>Recibido:</strong> Q ${montoRecibido.toFixed(2)}<br>
                                <strong>Cambio:</strong> Q ${cambio.toFixed(2)}`;
                }

                Swal.fire({
                    title: '¿Confirmar pago?',
                    html: mensaje,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-check"></i> Sí, pagar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        procesarPago();
                    }
                });
            });
        });

        function procesarPago() {
            Swal.fire({
                title: 'Procesando pago...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '@Url.Action("CerrarOrden", "Orden")',
                type: 'POST',
                data: { ordenId: ordenId },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Pago realizado!',
                            text: response.message,
                            confirmButtonColor: '#28a745',
                            confirmButtonText: '<i class="fas fa-print"></i> OK'
                        }).then(() => {
                            window.location.href = '@Url.Action("Index", "Orden")';
                        });
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Error al procesar el pago', 'error');
                }
            });
        }
    </script>
}
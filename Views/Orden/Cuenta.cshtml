@model LaMediaCancha.Models.ViewModels.OrdenCuentaViewModel

@{
    ViewBag.Title = "Cuenta - Orden " + Model.NumeroOrden;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid cuenta-container">
    <div class="row">
        <div class="col-12">
            <div class="card-custom card-custom-full">
                <div class="card-header-custom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h2 class="text-white mb-1">
                                <i class="fas fa-receipt"></i> Cuenta
                            </h2>
                            <p class="mb-0 text-white-50">Orden #@Model.NumeroOrden | Mesa @Model.MesaId</p>
                            <p class="mb-0 text-white-50 small">Cliente: @Model.ClienteNombre</p>
                            <p class="mb-0 text-white-50 small">Fecha: @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <a href="@Url.Action("Index")" class="btn btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Regresar
                        </a>
                    </div>
                </div>

                <div class="card-body-custom p-3">
                    <div class="row">
                        <!-- Columna izquierda: Detalles de la orden -->
                        <div class="col-lg-7">
                            @if (Model.CuentasSeparadas != null && Model.CuentasSeparadas.Any())
                            {
                                foreach (var persona in Model.CuentasSeparadas)
                                {
                                    <div class="card shadow-sm mb-3">
                                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="fas fa-user"></i> <strong>@persona.NombreCliente</strong>
                                                <span class="badge bg-light text-dark ms-2">@(persona.Detalles?.Sum(d => d.Cantidad) ?? 0) items</span>
                                            </div>
                                            <span class="fw-bold">Total: @persona.Total.ToString("C")</span>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Cant</th>
                                                        <th>Producto</th>
                                                        <th class="text-end">Precio</th>
                                                        <th class="text-end">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (persona.Detalles != null && persona.Detalles.Any())
                                                    {
                                                        foreach (var item in persona.Detalles)
                                                        {
                                                            <tr>
                                                                <td>@item.Cantidad</td>
                                                                <td>@item.ProductoNombre</td>
                                                                <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                                                                <td class="text-end">@item.Subtotal.ToString("C")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="4" class="text-center text-muted">Sin productos</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="card shadow-sm mb-3">
                                    <div class="card-header bg-white">
                                        <h5 class="mb-0"><i class="fas fa-clipboard-list text-primary"></i> Detalles del Pedido</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Cant</th>
                                                    <th>Producto</th>
                                                    <th class="text-end">Precio</th>
                                                    <th class="text-end">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Detalles != null && Model.Detalles.Any())
                                                {
                                                    foreach (var item in Model.Detalles)
                                                    {
                                                        <tr>
                                                            <td>@item.Cantidad</td>
                                                            <td>@item.ProductoNombre</td>
                                                            <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                                                            <td class="text-end">@item.Subtotal.ToString("C")</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center text-muted">No hay productos</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Columna derecha: Resumen y pago -->
                        <div class="col-lg-5">
                            <div class="cart-section shadow-lg">
                                <h5 class="section-title border-bottom pb-2">
                                    <i class="fas fa-calculator"></i> Resumen de Cuenta
                                </h5>

                                <div class="cart-totals bg-light p-3 rounded mb-3">
                                    @if (Model.CuentasSeparadas != null && Model.CuentasSeparadas.Any())
                                    {
                                        foreach (var persona in Model.CuentasSeparadas)
                                        {
                                            <div class="d-flex justify-content-between mb-2">
                                                <span>@persona.NombreCliente:</span>
                                                <span class="fw-bold">@persona.Total.ToString("C")</span>
                                            </div>
                                        }
                                        <hr />
                                    }
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal:</span>
                                        <span class="fw-bold">@Model.Subtotal.ToString("C")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>IVA (12%):</span>
                                        <span class="fw-bold">@Model.Impuesto.ToString("C")</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                        <span class="h5 mb-0">Total a Pagar:</span>
                                        <span id="totalSpan" class="h5 mb-0 text-success fw-bold">@Model.Total.ToString("C")</span>
                                    </div>
                                </div>

                                <!-- Forma de Pago -->
                                <div class="mt-3">
                                    <label class="form-label fw-bold">Forma de Pago</label>
                                    <select id="formaPago" class="form-select">
                                        <option value="Efectivo">💵 Efectivo</option>
                                        <option value="Tarjeta">💳 Tarjeta</option>
                                        <option value="Transferencia">🏦 Transferencia</option>
                                        <option value="QR">📱 QR</option>
                                    </select>
                                </div>

                                <!-- Monto Recibido (siempre visible, pero solo requerido para efectivo) -->
                                <div class="mt-3">
                                    <label class="form-label fw-bold">Monto Recibido</label>
                                    <input type="number" id="montoRecibido" class="form-control" placeholder="Ingrese el monto recibido" step="0.01" value="0">
                                    <div id="cambioInfo" class="mt-2 fw-bold"></div>
                                </div>

                                <div class="mt-3">
                                    <label class="form-label fw-bold">Observaciones</label>
                                    <textarea id="observacionesPago" class="form-control" rows="2" placeholder="Notas sobre el pago..."></textarea>
                                </div>

                                <div class="d-grid gap-2 mt-4">
                                    <button type="button" id="btnPagar" class="btn btn-success btn-lg py-3 fw-bold">
                                        <i class="fas fa-money-bill-wave"></i> PAGAR CUENTA
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let ordenId = @Model.OrdenId;
        let total = @Model.Total.ToString().Replace(",", ".");

        $(document).ready(function() {
            // Calcular cambio cuando se ingresa el monto
            $('#montoRecibido').on('keyup', calcularCambio);
            $('#btnPagar').on('click', pagarCuenta);

            // Trigger inicial para mostrar cambio
            calcularCambio();
        });

        function formatoQ(valor) {
            return 'Q ' + parseFloat(valor).toFixed(2);
        }

        function calcularCambio() {
            let totalValor = parseFloat(total);
            let recibido = parseFloat($('#montoRecibido').val()) || 0;
            let cambio = recibido - totalValor;

            if (recibido === 0) {
                $('#cambioInfo').html(`💰 Ingrese el monto recibido`).css('color', '#6c757d');
            } else if (cambio >= 0) {
                $('#cambioInfo').html(`💰 Cambio: ${formatoQ(cambio)}`).css('color', 'green');
            } else {
                $('#cambioInfo').html(`⚠️ Faltan: ${formatoQ(Math.abs(cambio))}`).css('color', 'red');
            }
        }

        function pagarCuenta() {
            let formaPago = $('#formaPago').val();
            let montoRecibido = parseFloat($('#montoRecibido').val()) || 0;
            let totalValor = parseFloat(total);
            let observaciones = $('#observacionesPago').val();

            // Validar que se haya ingresado un monto
            if (montoRecibido === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Monto requerido',
                    text: 'Por favor ingrese el monto recibido del cliente',
                    confirmButtonColor: '#c95a00'
                });
                return;
            }

            // Validar que el monto sea suficiente
            if (montoRecibido < totalValor) {
                Swal.fire({
                    icon: 'error',
                    title: 'Monto insuficiente',
                    text: `El monto recibido (${formatoQ(montoRecibido)}) es menor al total a pagar (${formatoQ(totalValor)})`,
                    confirmButtonColor: '#d33'
                });
                return;
            }

            let cambio = montoRecibido - totalValor;
            let mensajeCambio = cambio > 0 ? `\nCambio: ${formatoQ(cambio)}` : '';

            // Confirmar pago
            Swal.fire({
                title: '¿Confirmar pago?',
                html: `<strong>Total a pagar:</strong> ${formatoQ(totalValor)}<br>
                       <strong>Forma de pago:</strong> ${formaPago}<br>
                       <strong>Monto recibido:</strong> ${formatoQ(montoRecibido)}${mensajeCambio}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, pagar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Mostrar loading
                    Swal.fire({
                        title: 'Procesando pago...',
                        text: 'Por favor espere',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '@Url.Action("CerrarOrden", "Orden")',
                        type: 'POST',
                        data: { ordenId: ordenId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Pago realizado!',
                                    html: `Total pagado: ${formatoQ(totalValor)}<br>${mensajeCambio}`,
                                    confirmButtonColor: '#28a745'
                                }).then(() => {
                                    window.location.href = '@Url.Action("Index")';
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.message,
                                    confirmButtonColor: '#d33'
                                });
                            }
                        },
                        error: function (xhr) {
                            console.error(xhr.responseText);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Error al procesar el pago',
                                confirmButtonColor: '#d33'
                            });
                        }
                    });
                }
            });
        }
    </script>
}

<style>
    .cuenta-container {
        padding: 15px;
        max-width: 100% !important;
        background-color: #f4f7f6;
        min-height: 100vh;
    }

    .card-header-custom {
        padding: 1.5rem;
        background: linear-gradient(135deg, #c95a00 0%, #a04700 100%) !important;
        border-radius: 15px 15px 0 0;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #8B4513;
        margin-bottom: 15px;
    }

    .cart-section {
        background: white;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #e9ecef;
        position: sticky;
        top: 20px;
    }

    .table th, .table td {
        vertical-align: middle;
        padding: 10px;
    }

    .btn-success {
        background: linear-gradient(135deg, #27AE60, #1e8449);
        border: none;
        transition: all 0.2s ease;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
    }

    @@media (max-width: 991px) {
        .cart-section {
            position: static;
            margin-top: 20px;
        }
    }
</style>
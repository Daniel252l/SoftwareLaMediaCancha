@{
    ViewBag.Title = "Bienvenido";
}

<div class="welcome-page">
    <div class="logo-container">
        <img src="~/Content/images/logo2.png" alt="Churrascos La Media Cancha" class="logo-img" />
    </div>

    <h2 class="welcome-subtitle">CHURRASCOS</h2>
    <h1 class="welcome-title">LA MEDIA CANCHA</h1>

    <p class="welcome-description">
        Satisfaciendo tu paladar desde 1991.
    </p>

    <a href="@Url.Action("Login", "Account")" class="access-btn">
        <i class="fas fa-fire"></i>
        ACCEDER AL SISTEMA
    </a>

    <div class="features-container">
        <div class="feature-item">
            <i class="fas fa-utensils"></i>
            <p>Comida Tradicional</p>
        </div>
        <div class="feature-item">
            <i class="fas fa-fire"></i>
            <p>Parrilla Premium</p>
        </div>
        <div class="feature-item">
            <i class="fas fa-glass-cheers"></i>
            <p>Eventos Especiales</p>
        </div>
    </div>
</div>